        rm -f "$tmp_layout_file"
        log_debug "SAVE: refusing to replace $layout_file with 0 captured windows"
        echo "Refusing to save 0 windows. Existing layout was left unchanged."
        return 1
    fi

    # Keep one backup of the previous good save, then atomically replace it.
    if [[ -e "$layout_file" || -L "$layout_file" ]] &&
        ! layout_file_is_regular "$layout_file"; then
        rm -f "$tmp_layout_file"
        echo "Refusing to replace a non-regular layout file: $layout_file" >&2
        return 1
    fi
    if [[ -L "${layout_file}.bak" ]]; then
        rm -f "$tmp_layout_file"
        echo "Refusing to replace a symlinked layout backup: ${layout_file}.bak" >&2
        return 1
    fi
    if [[ -e "${layout_file}.bak" && ! -f "${layout_file}.bak" ]]; then
        rm -f "$tmp_layout_file"
        echo "Refusing to replace a non-regular layout backup: ${layout_file}.bak" >&2
        return 1
    fi
    if [[ -f "$layout_file" ]]; then
        local tmp_layout_backup=""
        if ! tmp_layout_backup=$(mktemp "$LAYOUT_DIR/.${config_id}.bak.XXXXXX") ||
            ! cp "$layout_file" "$tmp_layout_backup" ||
            ! chmod 600 "$tmp_layout_backup" ||
            ! mv -f "$tmp_layout_backup" "${layout_file}.bak"; then
            if [[ -n "$tmp_layout_backup" ]]; then
                rm -f "$tmp_layout_backup"
            fi
            rm -f "$tmp_layout_file"
            echo "Unable to preserve the previous layout; existing layout was left unchanged." >&2
            return 1
        fi
    fi
    if ! mv -f "$tmp_layout_file" "$layout_file"; then
        rm -f "$tmp_layout_file"
        echo "Unable to install the new layout; existing layout was left unchanged." >&2
        return 1
    fi

    log_debug "SAVE: $window_count window(s) for config $config_id"
    echo "Saved $window_count window(s) for display config $config_id"

    cleanup_stale
}

wait_for_yabai() {
    local retries=10
    for i in $(seq 1 $retries); do
        if yabai_query_json displays &>/dev/null; then
            return 0
        fi
        log_debug "YABAI: not ready, retry $i/$retries"
        sleep 3
    done
    log_debug "YABAI: gave up after $retries retries"
    return 1
}

restore_layout() {
    log_debug "RESTORE: triggered"

    if ! wait_for_yabai; then
        log_debug "RESTORE: yabai not ready, aborting"
        echo "yabai not ready. Aborting restore."
        return 1
    fi

    local config_id
    if [[ -n "${1:-}" ]]; then
        if config_id=$(resolve_layout_id "$1"); then
            :
        elif [[ "$?" -eq 2 ]]; then
            return 1
        else
            echo "No layout found matching '$1'"
            echo "Available configs:"
            list_layouts
            return 1
        fi
    else
        config_id=$(get_config_id)
        local legacy_config_id="MD5 (stdin) = $config_id"
        if ! layout_file_is_regular "$LAYOUT_DIR/$config_id"; then
            if layout_file_is_regular "$LAYOUT_DIR/$legacy_config_id"; then
                config_id="$legacy_config_id"
                log_debug "RESTORE: using legacy config filename $config_id"
            else
                log_debug "RESTORE: exact config $config_id not found, searching for best match"
                config_id=$(find_best_config)
            fi
        fi
    fi
    log_debug "RESTORE: config_id=$config_id"
    local layout_file="$LAYOUT_DIR/$config_id"

    if [[ -z "$config_id" ]] || ! layout_file_is_regular "$layout_file"; then
        log_debug "RESTORE: no layout file found at $layout_file"
        echo "No saved layout for current display config ($config_id)"
        echo "Run 'window-layout save' first."
        return 1
    fi

    local display_map
    if ! display_map=$(get_display_map_json); then
        echo "Unable to resolve the current display map; restore aborted." >&2
        return 1
    fi
    local display_count
    if ! display_count=$(printf '%s' "$display_map" | python3 -c '
import json
import sys

data = json.load(sys.stdin)
if not isinstance(data, list) or not data:
    raise SystemExit("display map is empty")
print(len(data))
'); then
        log_debug "RESTORE: display map was empty or invalid"
        echo "Unable to resolve the current display map; restore aborted." >&2
        return 1
    fi
    log_debug "RESTORE: resolved $display_count display(s)"

    local uuid_compatibility
    if ! uuid_compatibility=$(layout_uuid_compatibility "$display_map" "$layout_file"); then
        echo "Unable to validate display identities in saved layout $config_id." >&2
        return 1
    fi
    case "$uuid_compatibility" in
        unavailable)
            log_debug "RESTORE: saved layout $config_id requires unavailable display UUIDs"
            echo "Saved layout $config_id requires display UUIDs, but current display UUIDs are unavailable." >&2
            return 1
            ;;
        conflict)
            log_debug "RESTORE: saved layout $config_id conflicts with current display UUIDs"
            echo "Saved layout $config_id does not match the current display UUIDs." >&2
            return 1
            ;;
        compatible)
            ;;
        *)
            echo "Unable to validate display identities in saved layout $config_id." >&2
            return 1
            ;;
    esac

    # Compute moves in Python, output as JSON array with source/target display metadata.
    local moves
    local moves_file
    if ! moves_file=$(mktemp "$LAYOUT_DIR/.moves.XXXXXX"); then
        echo "Unable to create a temporary restore plan." >&2
        return 1
    fi
    local windows_json
    if ! windows_json=$(query_windows_nonempty "RESTORE"); then
        rm -f "$moves_file"
        echo "Unable to query current windows; restore aborted without changing the layout file." >&2
        return 1
    fi
    if ! DISPLAY_MAP="$display_map" WINDOWS_JSON="$windows_json" LAYOUT_FILE="$layout_file" LOG_FILE="$LOG_FILE" CHROME_TITLE_SUFFIXES="$CHROME_TITLE_SUFFIXES" COMMAND_TIMEOUT="$COMMAND_TIMEOUT" python3 <<'PY' > "$moves_file"; then
import json
import math
import os
import signal
import subprocess
import sys
import time
from collections import Counter
from datetime import datetime

command_timeout = float(os.environ['COMMAND_TIMEOUT'])
if not math.isfinite(command_timeout) or command_timeout <= 0:
    raise ValueError('COMMAND_TIMEOUT must be a finite positive number')

def run_timed(args, timeout, input_text=None):
    process = subprocess.Popen(
        args,
        stdin=subprocess.PIPE if input_text is not None else None,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    try:
        stdout, stderr = process.communicate(input=input_text, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        stdout, stderr = process.communicate()
        return subprocess.CompletedProcess(
            args,
            124,
            stdout=stdout or '',
            stderr=stderr or 'timed out',
        )
    return subprocess.CompletedProcess(
        args,
        process.returncode,
        stdout=stdout or '',
        stderr=stderr or '',
    )

def yabai_query(domain, retries=10):
    last_error = ''
    retryable_markers = (
        'not running',
        'connection',
        'could not connect',
        'temporarily',
        'timed out',
        'timeout',
        'not ready',
    )
    for attempt in range(1, retries + 1):
        try:
            result = subprocess.run(
                ['yabai', '-m', 'query', '--' + domain],
                capture_output=True,
                text=True,
                timeout=10,
            )
        except subprocess.TimeoutExpired:
            last_error = 'timeout'
            if attempt < retries:
                time.sleep(2)
                continue
            break
        stderr = (result.stderr or '').strip()
        if result.returncode != 0:
            detail = stderr or 'no stderr'
            last_error = f'rc={result.returncode}: {detail}'
            if not any(marker in detail.lower() for marker in retryable_markers):
                raise RuntimeError(f'yabai query --{domain} failed: {last_error}')
            if attempt < retries:
                time.sleep(2)
                continue
            break
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError as exc:
            last_error = f'invalid JSON: {exc}'
            if attempt < retries:
                time.sleep(2)
                continue
            break
    raise RuntimeError(f'yabai query --{domain} failed after {retries} retries: {last_error}')

log_file = os.environ['LOG_FILE']
log_max_bytes = 1024 * 1024
log_backup_file = log_file + '.1'

def log(message):
    if os.path.lexists(log_file) and os.path.islink(log_file):
        raise RuntimeError('window-layout log is a symlink')
    try:
        if os.path.exists(log_file) and os.path.getsize(log_file) >= log_max_bytes:
            os.replace(log_file, log_backup_file)
    except OSError:
        pass
    with open(log_file, 'a') as f:
        f.write(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {message}\n")

display_map = json.loads(os.environ['DISPLAY_MAP'])

displays = yabai_query('displays')
log(f"RESTORE: yabai_display_count={len(displays)}")

def frame_value(frame, key):
    return int(round(float(frame.get(key, 0))))

def display_key(d):
    uuid = (d.get('uuid') or '').strip().lower()
    if uuid:
        return f"uuid:{uuid}"
    if d.get('slot') is not None:
        return f"slot:{d['slot']}"
    return f"name:{d.get('name', 'unknown')}"

def display_keys(d):
    keys = []
    if not d:
        return keys
    uuid = (d.get('uuid') or '').strip().lower()
    if uuid:
        keys.append(f"uuid:{uuid}")
    if d.get('display_key'):
        keys.append(d['display_key'])
    if d.get('slot') is not None:
        keys.append(f"slot:{d['slot']}")
    if d.get('name'):
        keys.append(f"name:{d['name']}")
    return list(dict.fromkeys(keys))

def saved_display_keys(entry):
    saved_uuid = (entry.get('display_uuid') or '').strip().lower()
    if saved_uuid:
        return [f"uuid:{saved_uuid}"]
    display_key = str(entry.get('display_key', ''))
    if display_key.startswith('uuid:'):
        return [f"uuid:{display_key[5:].strip().lower()}"]
    keys = []
    if entry.get('display_key'):
        keys.append(entry['display_key'])
    if entry.get('display_slot') is not None:
        keys.append(f"slot:{entry['display_slot']}")
    if entry.get('display'):
        keys.append(f"name:{entry['display']}")
    return list(dict.fromkeys(keys))

def titles_match(left, right):
    if not left or not right:
        return False
    left_norm = normalize_title(left)
    right_norm = normalize_title(right)
    if not left_norm or not right_norm:
        return False
    if left_norm == right_norm or left_norm.startswith(right_norm) or right_norm.startswith(left_norm):
        return True
    left_tokens = set(left_norm.split())
    right_tokens = set(right_norm.split())
    if not left_tokens or not right_tokens:
        return False
    overlap = len(left_tokens & right_tokens) / max(len(left_tokens), len(right_tokens))
    return overlap >= 0.45

def normalize_title(title):
    value = (title or '').lower().replace('…', ' ')
    suffixes = [
        suffix.strip().lower()
        for suffix in os.environ.get('CHROME_TITLE_SUFFIXES', ' - google chrome').split('|')
        if suffix.strip()
    ]
    for suffix in suffixes:
        if value.endswith(suffix):
            value = value[:-len(suffix)]
    return ' '.join(value.replace('|', ' ').replace('·', ' ').replace('—', ' ').split())

def is_unstable_title(app, title):
    value = (title or '').strip()
    if app == 'Google Chrome':
        return value in ('', '(untitled)', 'New Tab', 'New Tab - Google Chrome')
    return value == ''

def frame_from_bounds(bounds):
    try:
        left, top, right, bottom = [int(float(part)) for part in bounds.split(',')]
    except Exception:
        return {}
    return {'x': left, 'y': top, 'w': right - left, 'h': bottom - top}

def frames_match(left, right):
    if not left or not right:
        return False
    return all(abs(frame_value(left, key) - frame_value(right, key)) <= 3 for key in ('x', 'y', 'w', 'h'))

