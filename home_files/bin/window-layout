def same_frame(screen, frame):
    return (
        int(screen.get('x', 0)) == frame_value(frame, 'x')
        and int(screen.get('y', 0)) == frame_value(frame, 'y')
        and int(screen.get('w', 0)) == frame_value(frame, 'w')
        and int(screen.get('h', 0)) == frame_value(frame, 'h')
    )

def match_display(yabai_display):
    if not yabai_display:
        return None
    yabai_uuid = (yabai_display.get('uuid') or '').strip().lower()
    if yabai_uuid:
        uuid_matches = [
            d for d in display_map
            if (d.get('uuid') or '').strip().lower() == yabai_uuid
        ]
        if len(uuid_matches) == 1:
            return uuid_matches[0]

    frame = yabai_display.get('frame', {})
    exact = [d for d in display_map if same_frame(d, frame)]
    if len(exact) == 1:
        return exact[0]

    sorted_yabai = sorted(
        displays,
        key=lambda yd: (
            frame_value(yd.get('frame', {}), 'x'),
            frame_value(yd.get('frame', {}), 'y'),
            frame_value(yd.get('frame', {}), 'w'),
            frame_value(yd.get('frame', {}), 'h'),
        ),
    )
    for slot, yd in enumerate(sorted_yabai):
        if yd.get('index') == yabai_display.get('index') and slot < len(display_map):
            return display_map[slot]
    return None

display_by_key = {}
display_by_yabai_index = {}
for yabai_display in displays:
    matched = match_display(yabai_display)
    if not matched:
        continue
    enriched = dict(matched)
    enriched['display_key'] = display_key(enriched)
    enriched['yabai_index'] = yabai_display.get('index')
    enriched['yabai_frame'] = yabai_display.get('frame', {})
    display_by_yabai_index[yabai_display.get('index')] = enriched
    for key in display_keys(enriched):
        display_by_key.setdefault(key, enriched)

# Current windows
current = []
for w in json.loads(os.environ['WINDOWS_JSON']):
    app = w.get('app', '')
    if not app:
        continue
    display = display_by_yabai_index.get(w.get('display'))
    current.append({
        'app': app,
        'title': w.get('title', ''),
        'yabai_window_id': w.get('id'),
        'window_frame': w.get('frame', {}),
        'display': display.get('name', 'unknown') if display else 'unknown',
        'display_key': display_key(display) if display else 'unknown',
        'display_keys': display_keys(display),
        'display_frame': display.get('yabai_frame', {}) if display else {},
        'yabai_display': display.get('yabai_index') if display else None,
        'fullscreen': w.get('is-native-fullscreen', False),
    })
attach_chrome_urls(current)

# Saved layout
with open(os.environ['LAYOUT_FILE']) as layout_stream:
    saved = json.load(layout_stream)
if not isinstance(saved, list) or not saved:
    raise RuntimeError('saved layout is empty or not a JSON array')

def resolve_target(saved_entry):
    for key in saved_display_keys(saved_entry):
        if key in display_by_key:
            return display_by_key[key], key
    return None, ''

unresolved_saved = [
    (index, entry.get('app', ''), entry.get('display', 'unknown'))
    for index, entry in enumerate(saved)
    if resolve_target(entry)[0] is None
]
for index, app, display in unresolved_saved:
    log(
        'RESTORE: unresolved_saved_display '
        f'index={index} app={app or "unknown"} display={display or "unknown"}'
    )

def target_matches_current(target_key, current_entry):
    return target_key in current_entry.get('display_keys', [])

def move_record(phase, saved_entry, current_entry, target_display, target_key, matched_by):
    return {
        'phase': phase,
        'matched_by': matched_by,
        'app': current_entry['app'],
        'title': current_entry['title'],
        'source_display': current_entry['display'],
        'source_display_key': current_entry['display_key'],
        'source_yabai_display': current_entry.get('yabai_display'),
        'yabai_window_id': current_entry.get('yabai_window_id'),
        'chrome_window_id': current_entry.get('chrome_window_id', ''),
        'chrome_process_identity': current_entry.get('chrome_process_identity', ''),
        'saved_chrome_process_identity': saved_entry.get('chrome_process_identity', ''),
        'chrome_url': current_entry.get('chrome_url', ''),
        'target_display': target_display.get('name', saved_entry.get('display', 'unknown')),
        'target_display_key': target_key,
        'target_yabai_display': target_display.get('yabai_index'),
        'target_frame': target_display.get('yabai_frame') or {
            'x': target_display.get('x', 0),
            'y': target_display.get('y', 0),
            'w': target_display.get('w', 2560),
            'h': target_display.get('h', 1440),
        },
        'fullscreen': saved_entry.get('fullscreen', current_entry.get('fullscreen', False)),
        'source_fullscreen': current_entry.get('fullscreen', False),
    }

log(f"RESTORE: current_window_count={len(current)} saved_window_count={len(saved)}")

# Phase 1: Match by exact app + title
used_saved = set()
used_current = set()
moves = []

# Phase 0: Match Chrome by same-session AppleScript window id when available.
# This is stable while the Chrome process keeps the same window objects, even if
# the active tab changes.
for si, s in enumerate(saved):
    if s.get('app') != 'Google Chrome' or not s.get('chrome_window_id'):
        continue
    target_display, target_key = resolve_target(s)
    if not target_display:
        log(f"RESTORE: phase0_id_unresolved_target saved_index={si} app={s.get('app')} display={s.get('display')}")
        continue
    candidates = [
        (ci, c) for ci, c in enumerate(current)
        if ci not in used_current
        and c.get('app') == 'Google Chrome'
        and c.get('chrome_window_id')
        and c.get('chrome_window_id') == s.get('chrome_window_id')
        and c.get('chrome_process_identity')
        and c.get('chrome_process_identity') == s.get('chrome_process_identity')
    ]
    if not candidates:
        log(f"RESTORE: phase0_id_no_match saved_index={si} chrome_window_id={s.get('chrome_window_id')} process_identity_match=False")
        continue
    preferred = [item for item in candidates if target_matches_current(target_key, item[1])]
    if len(preferred) == 1:
        ci, c = preferred[0]
    elif len(candidates) == 1:
        ci, c = candidates[0]
    else:
        log(f"RESTORE: phase0_id_ambiguous saved_index={si} chrome_window_id={s.get('chrome_window_id')}")
        continue
    if not target_matches_current(target_key, c):
        moves.append(move_record('phase0_id', s, c, target_display, target_key, 'chrome_window_id'))
        log(f"RESTORE: move phase0_id app={c['app']} title={c['title']} chrome_window_id={c.get('chrome_window_id')} from={c['display']} to={target_display.get('name')} key={target_key}")
    else:
        log(f"RESTORE: keep phase0_id app={c['app']} title={c['title']} chrome_window_id={c.get('chrome_window_id')} display={c['display']} key={target_key}")
    used_saved.add(si)
    used_current.add(ci)

# Phase 0b: Match Chrome by active-tab URL when the layout has it. Chrome titles
# are often blank, truncated, or tab-dependent; URL is a cross-session fallback.
for si, s in enumerate(saved):
    if si in used_saved:
        continue
    if s.get('app') != 'Google Chrome' or not s.get('chrome_url'):
        continue
    target_display, target_key = resolve_target(s)
    if not target_display:
        log(f"RESTORE: phase0_url_unresolved_target saved_index={si} app={s.get('app')} display={s.get('display')}")
        continue
    candidates = [
        (ci, c) for ci, c in enumerate(current)
        if ci not in used_current
        and c.get('app') == 'Google Chrome'
        and c.get('chrome_url')
        and c.get('chrome_url') == s.get('chrome_url')
    ]
    if not candidates:
        continue
    preferred = [item for item in candidates if target_matches_current(target_key, item[1])]
    if len(preferred) == 1:
        ci, c = preferred[0]
    elif len(candidates) == 1:
        ci, c = candidates[0]
    else:
        log(f"RESTORE: phase0_url_ambiguous saved_index={si} chrome_url={s.get('chrome_url')}")
        continue
    if not target_matches_current(target_key, c):
        moves.append(move_record('phase0_url', s, c, target_display, target_key, 'chrome_active_tab_url'))
        log(f"RESTORE: move phase0_url app={c['app']} title={c['title']} from={c['display']} to={target_display.get('name')} key={target_key}")
    else:
        log(f"RESTORE: keep phase0_url app={c['app']} title={c['title']} display={c['display']} key={target_key}")
    used_saved.add(si)
    used_current.add(ci)

for si, s in enumerate(saved):
    if si in used_saved:
        continue
    if is_unstable_title(s.get('app'), s.get('title')):
        log(f"RESTORE: skip phase1 unstable_title saved_index={si} app={s.get('app')} title={s.get('title')}")
        continue
    target_display, target_key = resolve_target(s)
    if not target_display:
        log(f"RESTORE: phase1_unresolved_target saved_index={si} app={s.get('app')} display={s.get('display')}")
        continue
    candidates = [
        (ci, c) for ci, c in enumerate(current)
        if ci not in used_current and c['app'] == s.get('app') and c['title'] == s.get('title')
    ]
    if not candidates:
        continue
    preferred = [item for item in candidates if target_matches_current(target_key, item[1])]
    if len(preferred) == 1:
        ci, c = preferred[0]
    elif len(candidates) == 1:
        ci, c = candidates[0]
    else:
        log(f"RESTORE: phase1_ambiguous saved_index={si} app={s.get('app')} title={s.get('title')}")
        continue
    if not target_matches_current(target_key, c):
        moves.append(move_record('phase1', s, c, target_display, target_key, 'exact_app_title'))
        log(f"RESTORE: move phase1 app={c['app']} title={c['title']} from={c['display']} to={target_display.get('name')} key={target_key}")
    else:
        log(f"RESTORE: keep phase1 app={c['app']} title={c['title']} display={c['display']} key={target_key}")
    used_saved.add(si)
    used_current.add(ci)

# Phase 2: For unmatched saved entries, compute how many windows per
# (app, fullscreen, display) we expect, then move unmatched current
# windows to fill the gaps.
# Count how many windows of each (app, fs) should be on each display
target_counts = Counter()
target_displays = {}
target_saved_entries = {}
for si, s in enumerate(saved):
    if si in used_saved:
        continue
    if s.get('app') == 'Google Chrome' and is_unstable_title(s.get('app'), s.get('title')) and not s.get('chrome_url'):
        log(f"RESTORE: skip phase2 ambiguous_chrome_saved saved_index={si} title={s.get('title')}")
        continue
    target_display, target_key = resolve_target(s)
    if not target_display:
        log(f"RESTORE: phase2_unresolved_target saved_index={si} app={s.get('app')} display={s.get('display')}")
        continue
    key = (s['app'], s['fullscreen'])
    target_counts[(key, target_key)] += 1
    target_displays[target_key] = target_display
    target_saved_entries.setdefault((key, target_key), s)

# Count how many unmatched current windows of each (app, fs) are on each display
unmatched_current = []
for ci, c in enumerate(current):
    if ci in used_current:
        continue
    key = (c['app'], c['fullscreen'])
    unmatched_current.append((ci, c, key))

# First let already-correct unmatched windows claim needed slots. Without this,
# title-changed Chrome windows that are already on the right display can leave a
# false deficit that causes another Chrome window to be moved there.
claimed_current = set()
for ci, c, key in unmatched_current:
    for target_key in c.get('display_keys', []):
        count_key = (key, target_key)
        if target_counts.get(count_key, 0) > 0:
            target_counts[count_key] -= 1
            claimed_current.add(ci)
            log(f"RESTORE: keep phase2 app={c['app']} title={c['title']} display={c['display']} key={target_key}")
            break

# Move only the still-unclaimed unmatched current windows to remaining deficits.
for (ci, c, key) in unmatched_current:
    if ci in claimed_current:
        continue
    if c.get('app') == 'Google Chrome' and is_unstable_title(c.get('app'), c.get('title')) and not c.get('chrome_url'):
        log(f"RESTORE: skip phase2 ambiguous_chrome_current app={c['app']} title={c['title']} display={c['display']}")
        continue
    for (tkey, target_key), needed in list(target_counts.items()):
        if tkey != key or needed <= 0:
            continue
        if target_key in c.get('display_keys', []):
            target_counts[(tkey, target_key)] -= 1
            claimed_current.add(ci)
            log(f"RESTORE: keep phase2_late app={c['app']} title={c['title']} display={c['display']} key={target_key}")
            break
        target_display = target_displays[target_key]
        saved_entry = target_saved_entries[(tkey, target_key)]
        moves.append(move_record('phase2', saved_entry, c, target_display, target_key, 'app_fullscreen_count'))
        log(f"RESTORE: move phase2 app={c['app']} title={c['title']} from={c['display']} to={target_display.get('name')} key={target_key}")
        target_counts[(tkey, target_key)] -= 1
        claimed_current.add(ci)
        break

json.dump(moves, sys.stdout, ensure_ascii=False, indent=2)
PY
        rm -f "$moves_file"
        return 1
    fi
    if ! moves=$(cat "$moves_file"); then
        rm -f "$moves_file"
        echo "Unable to read the temporary restore plan." >&2
        return 1
    fi
    rm -f "$moves_file"

    local move_count
    move_count=$(printf '%s' "$moves" | python3 -c "import json,sys; print(len(json.load(sys.stdin)))")

    if [[ "$move_count" -eq 0 ]]; then
        echo "All windows are already on the correct displays."
        return 0
    fi

    echo "Moving $move_count window(s)..."

    # Execute moves one by one
    local executor_output
    if ! executor_output=$(mktemp "$LAYOUT_DIR/.executor-output.XXXXXX"); then
        echo "Unable to create a temporary restore output file." >&2
        return 1
    fi
    if ! MOVES_JSON="$moves" LOG_FILE="$LOG_FILE" COMMAND_TIMEOUT="$COMMAND_TIMEOUT" python3 <<'PY' > "$executor_output" 2>&1
import json
import math
import os
import signal
import subprocess
import time
from datetime import datetime

moves = json.loads(os.environ['MOVES_JSON'])
log_file = os.environ['LOG_FILE']
log_max_bytes = 1024 * 1024
log_backup_file = log_file + '.1'
command_timeout = float(os.environ['COMMAND_TIMEOUT'])
if not math.isfinite(command_timeout) or command_timeout <= 0:
    raise ValueError('COMMAND_TIMEOUT must be a finite positive number')
delay_scale = float(os.environ.get('WINDOW_LAYOUT_DELAY_SCALE', '1'))
if not math.isfinite(delay_scale) or delay_scale < 0:
    raise ValueError('WINDOW_LAYOUT_DELAY_SCALE must be a finite non-negative number')

def delay(seconds):
    if delay_scale:
        time.sleep(seconds * delay_scale)

def log(message):
    try:
        if os.path.exists(log_file) and os.path.getsize(log_file) >= log_max_bytes:
            os.replace(log_file, log_backup_file)
    except OSError:
        pass
    with open(log_file, 'a') as f:
        f.write(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {message}\n")

def run_timed(args, timeout):
    process = subprocess.Popen(
        args,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        stdout, stderr = process.communicate()
        return subprocess.CompletedProcess(
            args,
            124,
            stdout=stdout or '',
            stderr=stderr or 'timed out',
        )
    return subprocess.CompletedProcess(
        args,
        process.returncode,
        stdout=stdout or '',
        stderr=stderr or '',
    )

def osa(script):
    result = run_timed(['osascript', '-e', script], command_timeout)
    if result.returncode == 124:
        log(f"RESTORE: osascript_timeout seconds={command_timeout:g}")
        result.stderr = f'timed out after {command_timeout:g} seconds'
    if result.returncode != 0:
        log(f"RESTORE: osascript_error rc={result.returncode} stderr={result.stderr.strip()}")
    return result

# yabai has been observed to hang indefinitely on some commands (e.g. moving a
# window onto a space that is itself in native fullscreen). Every yabai call
# below is timeout-bounded so a stuck yabai process can never hang the whole
# restore; a timeout is logged and treated as failure rather than retried.
def yabai_cmd(args, timeout=None):
    if timeout is None:
        timeout = command_timeout
    result = run_timed(['yabai', '-m'] + args, timeout)
    if result.returncode == 124:
        return -1, '', 'timeout'
    return result.returncode, (result.stdout or '').strip(), (result.stderr or '').strip()

def yabai_window_state(win_id, timeout=None):
    rc, out, _ = yabai_cmd(['query', '--windows', '--window', str(win_id)], timeout=timeout)
    if rc != 0 or not out:
        return None
    try:
        return json.loads(out)
    except Exception:
        return None

def restore_fullscreen_state(win_id, desired):
    if win_id is None:
        log(f"RESTORE: fullscreen_restore_unavailable desired={desired} reason=missing_yabai_window_id")
        return False
    state = yabai_window_state(win_id)
    if not isinstance(state, dict) or 'is-native-fullscreen' not in state:
        log(f"RESTORE: fullscreen_restore_unavailable window_id={win_id} desired={desired}")
        return False
    if bool(state['is-native-fullscreen']) == bool(desired):
        return True
    rc, out, err = yabai_cmd(['window', str(win_id), '--toggle', 'native-fullscreen'])
    log(f"RESTORE: fullscreen_restore_cmd window_id={win_id} desired={desired} rc={rc} stdout={out} stderr={err}")
    def state_matches():
        state = yabai_window_state(win_id)
        return isinstance(state, dict) and bool(state.get('is-native-fullscreen')) == bool(desired)
    return poll_until(state_matches)

def yabai_spaces(timeout=None):
    rc, out, _ = yabai_cmd(['query', '--spaces'], timeout=timeout)
    if rc != 0 or not out:
        return None
    try:
        return json.loads(out)
    except Exception:
        return None

def poll_until(check_fn, tries=6, interval=1.0):
    for _ in range(tries):
        delay(interval)
        try:
            if check_fn():
                return True
        except Exception:
            pass
    return False

def escape_as(s):
    return (
        str(s)
        .replace('\\', '\\\\')
        .replace('"', '\\"')
        .replace('\r', '\\r')
        .replace('\n', '\\n')
    )

def raise_chrome_window(as_app, chrome_id):
    result = osa(f'''
tell application "{as_app}"
    activate
    try
        set targetWindow to (first window whose id is {chrome_id})
        set index of targetWindow to 1
        return "ok"
    on error errMsg
        return "fail:" & errMsg
    end try
end tell
''')
    ok = result.returncode == 0 and (result.stdout or '').strip() == 'ok'
    log(f"RESTORE: raise_by_id_result chrome_window_id={chrome_id} ok={ok} stdout={(result.stdout or '').strip()}")
    if ok:
        delay(0.5)
    return ok

def refresh_window_ref(as_app, chrome_id, current_ref):
    if not chrome_id:
        return current_ref
    return 'window 1' if raise_chrome_window(as_app, chrome_id) else None

def int_frame(frame, key, default=0):
    try:
        return int(round(float(frame.get(key, default))))
    except Exception:
        return default

def target_bounds(move):
    frame = move.get('target_frame') or {}
    x = int_frame(frame, 'x')
    y = int_frame(frame, 'y')
    w = max(800, int_frame(frame, 'w', 2560))
    h = max(600, int_frame(frame, 'h', 1440))
    width = min(1400, max(700, w - 120))
    height = min(900, max(500, h - 160))
    left = x + max(40, (w - width) // 2)
    top = y + max(60, min(120, (h - height) // 2))
    return left, top, left + width, top + height

def verify_move(move):
    window_id = move.get('yabai_window_id')
    target_display = move.get('target_yabai_display')
    if window_id is None or target_display is None:
        log(f"RESTORE: verify_unavailable missing_window_id_or_target_display window_id={window_id} target_display={target_display}")
        return False
    verify = run_timed(
        ['yabai', '-m', 'query', '--windows', '--window', str(window_id)],
        command_timeout,
    )
    if verify.returncode == 124:
        log("RESTORE: verify_yabai_timeout")
        return False
    if verify.returncode != 0:
        log(f"RESTORE: verify_yabai_error rc={verify.returncode} stderr={verify.stderr.strip()}")
        return False
    try:
        state = json.loads(verify.stdout)
    except json.JSONDecodeError as exc:
        log(f"RESTORE: verify_json_error error={exc}")
        return False
    if not isinstance(state, dict) or state.get('id') != window_id:
        log(f"RESTORE: verify_unavailable unexpected_window_state window_id={window_id}")
        return False
    if state.get('display') != target_display:
        return False
    return True

failed_moves = 0
for m in moves:
    app = m['app']
    title = m['title']
    source = m.get('source_display', 'unknown')
    target = m['target_display']
    target_key = m.get('target_display_key', '')
    target_yabai_display = m.get('target_yabai_display')
    target_frame = m.get('target_frame') or {}
    should_fs = m['fullscreen']
    source_fs = bool(m.get('source_fullscreen', False))
    fullscreen_ok = True
    phase = m.get('phase', 'unknown')
    bounds = target_bounds(m)
    raw_chrome_id = m.get('chrome_window_id', '') if app == 'Google Chrome' else ''
    use_chrome_id = (
        bool(raw_chrome_id)
        and str(raw_chrome_id).isdigit()
        and m.get('chrome_process_identity')
        and m.get('chrome_process_identity') == m.get('saved_chrome_process_identity')
    )

    print(f"  Moving '{app}' ({title[:40]}...) from {source} to {target}")
    log(f"RESTORE: execute phase={phase} app={app} title={title} from={source} to={target} target_key={target_key} target_yabai_display={target_yabai_display} bounds={bounds} chrome_window_id={raw_chrome_id}")

    as_app = escape_as(app)
    as_title = escape_as(title)
    as_target = escape_as(target)

    if use_chrome_id:
        # Chrome windows with a known stable id are addressed by id rather than
        # title: blank/duplicate titles make `window "{title}"` ambiguous or
        # outright invalid (`window ""` is not a valid System Events lookup).
        # Raising the window by id first makes it "window 1" (frontmost) for
        # both Chrome's own dictionary and System Events for the rest of the steps.
        se_window_ref = 'window 1' if raise_chrome_window(as_app, raw_chrome_id) else None
    else:
        # Step 1: Activate app and switch to window via Window menu (title-based)
        select_result = osa(f'''
tell application "{as_app}" to activate
delay 0.3
tell application "System Events"
    tell process "{as_app}"
        try
            set menuItems to every menu item of menu "Window" of menu bar 1
            set menuItemFound to false
            repeat with mi in menuItems
                if name of mi starts with "{as_title}" or "{as_title}" starts with name of mi then
                    click mi
                    set menuItemFound to true
                    exit repeat
                end if
            end repeat
            if menuItemFound then
                return "ok"
            end if
            return "fail:no window menu item matching title"
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
        log(f"RESTORE: select_window_result app={app} title={title} stdout={(select_result.stdout or '').strip()}")
        delay(1)
        se_window_ref = f'window "{as_title}"'

    # Step 2: Exit fullscreen
    se_window_ref = refresh_window_ref(as_app, raw_chrome_id, se_window_ref)
    if se_window_ref is None:
        exit_fs_result = None
    else:
        exit_fs_result = osa(f'''
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            set fs to value of attribute "AXFullScreen" of targetWin
            if fs then
                set value of attribute "AXFullScreen" of targetWin to false
                return "exited"
            else
                return "not_fullscreen"
            end if
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
    log(f"RESTORE: exit_fullscreen_result app={app} title={title} stdout={(exit_fs_result.stdout or '').strip() if exit_fs_result else 'unavailable'}")
    delay(2)

    # Step 3: Move to target display using bounds derived from target frame.
    left, top, right, bottom = bounds
    if use_chrome_id:
        bounds_script = f'''
try
    tell application "{as_app}"
        set targetWindow to (first window whose id is {raw_chrome_id})
        set bounds of targetWindow to {{{left}, {top}, {right}, {bottom}}}
        return "ok"
    end tell
on error errMsg
    return "fail:" & errMsg
end try
'''
    else:
        bounds_script = f'''
try
    tell application "{as_app}"
        repeat with w in every window
            if title of w starts with "{as_title}" or "{as_title}" starts with title of w then
                set bounds of w to {{{left}, {top}, {right}, {bottom}}}
                return "ok"
            end if
        end repeat
        return "fail:no matching window"
    end tell
on error errMsg
    return "fail:" & errMsg
end try
'''
    result = osa(bounds_script)
    moved_via_bounds = 'ok' in (result.stdout or '')
    log(f"RESTORE: bounds_result app={app} title={title} moved_via_bounds={moved_via_bounds} stdout={result.stdout.strip()}")

    # Step 3b: Accessibility-API fallback (position/size) for apps whose own
    # AppleScript dictionary doesn't support "every window"/"bounds of window"
    # (e.g. GitHub Copilot). This talks to the window via System Events'
    # AXPosition/AXSize attributes instead of the app's own scripting suite.
    moved_via_ax = False
    if not moved_via_bounds and se_window_ref is not None:
        se_window_ref = refresh_window_ref(as_app, raw_chrome_id, se_window_ref)
    if not moved_via_bounds and se_window_ref is not None:
        width = right - left
        height = bottom - top
        ax_result = osa(f'''
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            set position of targetWin to {{{left}, {top}}}
            set size of targetWin to {{{width}, {height}}}
            return "ok"
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
        moved_via_ax = 'ok' in (ax_result.stdout or '')
        log(f"RESTORE: ax_result app={app} title={title} moved_via_ax={moved_via_ax} stdout={ax_result.stdout.strip()}")

    if not moved_via_bounds and not moved_via_ax and se_window_ref is not None:
        se_window_ref = refresh_window_ref(as_app, raw_chrome_id, se_window_ref)
    if not moved_via_bounds and not moved_via_ax and se_window_ref is not None:
        menu_result = osa(f'''
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            perform action "AXRaise" of targetWin
            delay 0.3
            set menuItemFound to false
            repeat with mi in every menu item of menu "Window" of menu bar 1
                if name of mi is "Move to {as_target}" then
                    click mi
                    set menuItemFound to true
                    exit repeat
                end if
            end repeat
            if menuItemFound then
                return "ok"
            end if
            return "fail:no menu item Move to {as_target}"
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
        log(f"RESTORE: menu_result app={app} title={title} target={target} stdout={menu_result.stdout.strip()}")
    delay(1)

    # Step 3.5: Verify the move actually happened. If not, try menu fallback.
    delay(1)
    actually_moved = verify_move(m)
    log(f"RESTORE: verify app={app} title={title} target={target} actually_moved={actually_moved}")

    if not actually_moved:
        print(f"    ! Move didn't stick, trying menu fallback")
        if not moved_via_ax and se_window_ref is not None:
            se_window_ref = refresh_window_ref(as_app, raw_chrome_id, se_window_ref)
        if not moved_via_ax and se_window_ref is not None:
            retry_ax_result = osa(f'''
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            perform action "AXRaise" of targetWin
            delay 0.3
            set position of targetWin to {{{left}, {top}}}
            set size of targetWin to {{{right - left}, {bottom - top}}}
            return "ok"
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
            log(f"RESTORE: retry_ax_result app={app} title={title} stdout={retry_ax_result.stdout.strip()}")
        fallback_result = None
        if se_window_ref is not None:
            se_window_ref = refresh_window_ref(as_app, raw_chrome_id, se_window_ref)
        if se_window_ref is not None:
            fallback_result = osa(f'''
tell application "{as_app}" to activate
delay 0.3
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            perform action "AXRaise" of targetWin
            delay 0.3
            set menuItemFound to false
            repeat with mi in every menu item of menu "Window" of menu bar 1
                if name of mi is "Move to {as_target}" then
                    click mi
                    set menuItemFound to true
                    exit repeat
                end if
            end repeat
            if menuItemFound then
                return "ok"
            end if
            return "fail:no menu item Move to {as_target}"
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
        log(f"RESTORE: fallback_menu_result app={app} title={title} target={target} stdout={(fallback_result.stdout or '').strip() if fallback_result else 'unavailable'}")
        delay(2)
        actually_moved = verify_move(m)
        log(f"RESTORE: fallback_verify app={app} title={title} target={target} actually_moved={actually_moved}")

    # Step 3.9: yabai native-fullscreen fallback. AppleScript/System Events can only
    # enumerate windows on the currently visible macOS Space, so every prior strategy
    # silently fails for a fullscreen window sitting on a different Space -- Chrome's
    # own "set bounds" can even report "ok" while the window never actually moves,
    # because native-fullscreen windows are size-locked to their own Space. yabai
    # operates below that restriction, so as a last resort for still-stuck fullscreen
    # windows: exit native fullscreen via yabai, move the (now-normal) window to a
    # non-fullscreen space on the target display, then re-enter fullscreen there.
    # yabai has been observed to hang on some of these calls (e.g. moving a window
    # onto a space that is itself fullscreen), so every call is timeout-bounded and
    # polled rather than blindly chained.
    yabai_fallback_handled_fs = False
    if not actually_moved:
        yabai_window_id = m.get('yabai_window_id')
        if yabai_window_id and target_yabai_display and (source_fs or should_fs):
            log(f"RESTORE: yabai_fallback_start app={app} title={title} yabai_window_id={yabai_window_id} target_yabai_display={target_yabai_display}")
            initial_state = yabai_window_state(yabai_window_id)
            if not isinstance(initial_state, dict):
                fs_off_ok = False
            elif initial_state.get('is-native-fullscreen') is True:
                rc, out, err = yabai_cmd(['window', str(yabai_window_id), '--toggle', 'native-fullscreen'])
                log(f"RESTORE: yabai_fs_off_cmd rc={rc} stdout={out} stderr={err}")
                def fullscreen_is_off():
                    state = yabai_window_state(yabai_window_id)
                    return isinstance(state, dict) and state.get('is-native-fullscreen') is False
                fs_off_ok = poll_until(fullscreen_is_off)
            else:
                fs_off_ok = True
            log(f"RESTORE: yabai_fs_off_result ok={fs_off_ok}")

            move_ok = False
            if fs_off_ok:
                spaces = yabai_spaces() or []
                candidate_spaces = [s['index'] for s in spaces
                                     if s.get('display') == target_yabai_display and not s.get('is-native-fullscreen')]
                if candidate_spaces:
                    target_space = candidate_spaces[0]
                    rc, out, err = yabai_cmd(['window', str(yabai_window_id), '--space', str(target_space)])
                    log(f"RESTORE: yabai_move_cmd rc={rc} stdout={out} stderr={err} target_space={target_space}")
                    move_ok = poll_until(lambda: (yabai_window_state(yabai_window_id) or {}).get('display') == target_yabai_display)
                    log(f"RESTORE: yabai_move_result ok={move_ok}")
                else:
                    log(f"RESTORE: yabai_fallback_abort reason=no_normal_space_on_target_display target_yabai_display={target_yabai_display}")

                if move_ok:
                    fs_on_ok = restore_fullscreen_state(yabai_window_id, should_fs)
                    log(f"RESTORE: yabai_fs_on_result ok={fs_on_ok}")
                    fullscreen_ok = fs_on_ok
                    yabai_fallback_handled_fs = fs_on_ok
                    if not fs_on_ok:
                        restore_fullscreen_state(yabai_window_id, source_fs)
                else:
                    fullscreen_ok = False
                    restore_fullscreen_state(yabai_window_id, source_fs)
            else:
                log("RESTORE: yabai_fallback_abort reason=fullscreen_exit_failed_or_timed_out")
                fullscreen_ok = False
                restore_fullscreen_state(yabai_window_id, source_fs)

            actually_moved = verify_move(m)
            log(f"RESTORE: yabai_fallback_verify app={app} title={title} target={target} actually_moved={actually_moved}")
        elif not yabai_window_id:
            log(f"RESTORE: yabai_fallback_skipped reason=no_yabai_window_id")
        elif not actually_moved:
            log("RESTORE: fullscreen_restore_skipped reason=no_native_fullscreen_fallback")
            fullscreen_ok = restore_fullscreen_state(yabai_window_id, source_fs)

    # Step 4: Re-enter fullscreen
    if should_fs and actually_moved and not yabai_fallback_handled_fs:
        se_window_ref = refresh_window_ref(as_app, raw_chrome_id, se_window_ref)
        if se_window_ref is None:
            reenter_fs_result = None
        else:
            reenter_fs_result = osa(f'''
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            set value of attribute "AXFullScreen" of targetWin to true
            return "ok"
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
        reenter_ok = bool(reenter_fs_result and reenter_fs_result.returncode == 0 and (reenter_fs_result.stdout or '').strip() == 'ok')
        log(f"RESTORE: reenter_fullscreen_result app={app} title={title} ok={reenter_ok} stdout={(reenter_fs_result.stdout or '').strip() if reenter_fs_result else 'unavailable'}")
        delay(1.5)
        if not reenter_ok:
            fullscreen_ok = False
            restore_fullscreen_state(m.get('yabai_window_id'), source_fs)
        else:
            fullscreen_ok = True

    if not actually_moved or not fullscreen_ok:
        failed_moves += 1
        log(f"RESTORE: move_failed app={app} target={target} moved={actually_moved} fullscreen_ok={fullscreen_ok}")

if failed_moves:
    raise RuntimeError(f'{failed_moves} window move(s) did not complete successfully')
print('Done.')
PY
    then
        log_debug "RESTORE: executor failed; layout mtime was not refreshed"
        cat "$executor_output" >&2
        rm -f "$executor_output"
        return 1
    fi
    if ! cat "$executor_output"; then
        rm -f "$executor_output"
        return 1
    fi
    rm -f "$executor_output"
    cleanup_stale
}

list_layouts() {
    [[ -d "$LAYOUT_DIR" && ! -L "$LAYOUT_DIR" ]] || { echo "No layouts saved yet."; return; }
    local current_id
    current_id=$(get_config_id)
    for f in "$LAYOUT_DIR"/*; do
        layout_file_is_regular "$f" || continue
        layout_file_id "$f" || continue
        local id
        id=$(basename "$f")
        local count
        if ! count=$(LAYOUT_FILE="$f" python3 - <<'PY'
import json
import os

with open(os.environ["LAYOUT_FILE"]) as stream:
    data = json.load(stream)
if not isinstance(data, list):
    raise SystemExit("layout root is not a JSON array")
print(len(data))
PY
        ); then
            count="invalid"
        fi
        local displays
        if ! displays=$(LAYOUT_FILE="$f" python3 - <<'PY'
import json
import os

with open(os.environ["LAYOUT_FILE"]) as stream:
    entries = json.load(stream)
if not isinstance(entries, list):
    raise SystemExit("layout root is not a JSON array")
print(", ".join(sorted(set(e.get("display", "unknown") for e in entries))))
PY
        ); then
            displays="invalid layout"
        fi
        local marker=""
        [[ "$id" == "$current_id" ]] && marker=" (current)"
        echo "  $id  ${count} windows  [$displays]${marker}"
    done
}

restore_backup() {
    local config_id
    if [[ -n "${1:-}" ]]; then
        if config_id=$(resolve_layout_id "$1"); then
            :
        elif [[ "$?" -eq 2 ]]; then
            return 1
        else
            echo "No layout found matching '$1'"
            return 1
        fi
    else
        config_id=$(get_config_id)
        local legacy_config_id="MD5 (stdin) = $config_id"
        if ! layout_file_is_regular "$LAYOUT_DIR/$config_id"; then
            if layout_file_is_regular "$LAYOUT_DIR/$legacy_config_id"; then
                config_id="$legacy_config_id"
            else
                config_id=$(find_best_config)
            fi
        fi
    fi
    if [[ -z "$config_id" ]]; then
        echo "No saved layout is available for restore-backup."
        return 1
    fi

    local layout_file="$LAYOUT_DIR/$config_id"
    local backup_file="$LAYOUT_DIR/${config_id}.bak"

    if [[ -L "$layout_file" || -L "$backup_file" ]]; then
        echo "Refusing to swap symlinked layouts for config $config_id." >&2
        return 1
    fi
    if [[ ! -f "$backup_file" ]]; then
        echo "No backup found for current display config ($config_id)"
        return 1
    fi
    if ! layout_file_is_json "$backup_file"; then
        echo "Backup for config $config_id is not a valid layout; it was left unchanged." >&2
        return 1
    fi

    local display_map
    local uuid_compatibility
    if ! display_map=$(get_display_map_json); then
        echo "Unable to resolve the current display map; backup was left unchanged." >&2
        return 1
    fi
    if ! uuid_compatibility=$(layout_uuid_compatibility "$display_map" "$backup_file"); then
        echo "Unable to validate display identities in backup for config $config_id; backup was left unchanged." >&2
        return 1
    fi
    case "$uuid_compatibility" in
        unavailable)
            echo "Backup for config $config_id requires display UUIDs, but current display UUIDs are unavailable; backup was left unchanged." >&2
            return 1
            ;;
        conflict)
            echo "Backup for config $config_id does not match the current display UUIDs; backup was left unchanged." >&2
            return 1
            ;;
        compatible)
            ;;
        *)
            echo "Unable to validate display identities in backup for config $config_id; backup was left unchanged." >&2
            return 1
            ;;
    esac

    if [[ -e "$layout_file" && ! -f "$layout_file" ]]; then
        echo "Refusing to replace a non-regular layout file: $layout_file" >&2
        return 1
    fi

    if [[ -f "$layout_file" ]]; then
        local recovery_root="$LAYOUT_DIR/.restore-backup-recovery"
        local temp_dir
        local temp_backup
        if [[ -L "$recovery_root" || ( -e "$recovery_root" && ! -d "$recovery_root" ) ]]; then
            echo "Refusing to use an invalid restore-backup recovery directory: $recovery_root" >&2
            return 1
        fi
        if ! mkdir -p "$recovery_root" || ! chmod 700 "$recovery_root"; then
            echo "Unable to create the restore-backup recovery directory: $recovery_root" >&2
            return 1
        fi
        temp_dir="$recovery_root/$config_id"
        if [[ -e "$temp_dir" || -L "$temp_dir" ]]; then
            echo "A previous restore-backup recovery workspace exists at $temp_dir; inspect it before retrying." >&2
            return 1
        fi
        if ! mkdir "$temp_dir" || ! chmod 700 "$temp_dir"; then
            echo "Unable to create a recovery workspace for config $config_id: $temp_dir" >&2
            return 1
        fi
        temp_backup="$temp_dir/backup"
        if ! mv -f "$backup_file" "$temp_backup"; then
            echo "Unable to stage backup for config $config_id; recovery workspace preserved at $temp_dir." >&2
            return 1
        fi
        if ! mv -f "$layout_file" "$backup_file"; then
            if mv -f "$temp_backup" "$backup_file" 2>/dev/null; then
                if ! rm -rf "$temp_dir"; then
                    echo "Unable to clean the restore-backup recovery workspace: $temp_dir" >&2
                fi
                echo "Unable to preserve the current layout for config $config_id; no files were changed." >&2
            else
                echo "Restore-backup rollback is incomplete; staged data was preserved at $temp_dir." >&2
            fi
            return 1
        fi
        if ! mv -f "$temp_backup" "$layout_file"; then
            local active_rolled_back=0
            local backup_rolled_back=0
            if mv -f "$backup_file" "$layout_file" 2>/dev/null; then
                active_rolled_back=1
            fi
            if [[ "$active_rolled_back" -eq 1 ]]; then
                if mv -f "$temp_backup" "$backup_file" 2>/dev/null; then
                    backup_rolled_back=1
                fi
            fi
            if [[ "$active_rolled_back" -eq 1 && "$backup_rolled_back" -eq 1 ]]; then
                if ! rm -rf "$temp_dir"; then
                    echo "Unable to clean the restore-backup recovery workspace: $temp_dir" >&2
                fi
                echo "Unable to install the backup for config $config_id; layouts were rolled back." >&2
            else
                echo "Restore-backup rollback is incomplete; staged data was preserved at $temp_dir." >&2
            fi
            return 1
        fi
        if ! rm -rf "$temp_dir"; then
            echo "Backup was restored for config $config_id, but recovery workspace cleanup failed: $temp_dir." >&2
        fi
    else
        local temp_layout
        if ! temp_layout=$(mktemp "$LAYOUT_DIR/.restore-backup.XXXXXX"); then
            echo "Unable to create a transaction workspace for config $config_id; no files were changed." >&2
            return 1
        fi
        if ! cp "$backup_file" "$temp_layout" || ! chmod 600 "$temp_layout" ||
            ! mv -f "$temp_layout" "$layout_file"; then
            rm -f "$temp_layout" || true
            echo "Unable to restore backup for config $config_id; backup was left unchanged." >&2
            return 1
        fi
    fi

    echo "Restored backup for config $config_id"
    restore_layout "$config_id"
}

release_schedule_publication_lock() {
    [[ -d "$SCHEDULE_PUBLICATION_LOCK_DIR" ]] || {
        SCHEDULE_PUBLICATION_LOCK_HELD=0
        return 0
    }
    [[ ! -L "$SCHEDULE_PUBLICATION_LOCK_DIR" ]] || {
        SCHEDULE_PUBLICATION_LOCK_HELD=0
        return 0
    }
    [[ -f "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" &&
        ! -L "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" ]] || {
        SCHEDULE_PUBLICATION_LOCK_HELD=0
        return 0
    }
    local owner_pid=""
    local owner_start=""
    local current_start=""
    read -r owner_pid owner_start < "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" 2>/dev/null || true
    current_start=$(ps -p "$$" -o lstart= 2>/dev/null | tr -s ' ' '_' || true)
    if [[ "$owner_pid" == "$$" && "$owner_start" == "$current_start" ]]; then
        if ! rm -rf "$SCHEDULE_PUBLICATION_LOCK_DIR"; then
            return 1
        fi
    fi
    SCHEDULE_PUBLICATION_LOCK_HELD=0
}

schedule_publication_lock_mtime() {
    local mtime
    mtime=$(stat -f %m "$1" 2>/dev/null || true)
    if [[ ! "$mtime" =~ ^[0-9]+$ ]]; then
        mtime=$(stat -c %Y "$1" 2>/dev/null || true)
    fi
    [[ "$mtime" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$mtime"
}

schedule_publication_lock_is_stale() {
    local mtime

    if ! mtime=$(schedule_publication_lock_mtime "$SCHEDULE_PUBLICATION_LOCK_DIR"); then
        echo "Unable to determine the age of the scheduled restore publication lock at $SCHEDULE_PUBLICATION_LOCK_DIR; refusing to reclaim it." >&2
        return 1
    fi
    timing_age_reached "$mtime" "$LOCK_INITIALIZATION_GRACE"
}

write_schedule_publication_lock_owner() {
    local lock_dir="$1"
    local owner_start
    local owner_tmp

    owner_start=$(ps -p "$$" -o lstart= 2>/dev/null | tr -s ' ' '_' || true)
    [[ -n "$owner_start" ]] || return 1
    owner_tmp=$(mktemp "$lock_dir/.pid.XXXXXX") || return 1
    if ! printf '%s %s\n' "$$" "$owner_start" > "$owner_tmp" ||
        ! chmod 600 "$owner_tmp" ||
        [[ -e "$lock_dir/pid" || -L "$lock_dir/pid" ]] ||
        ! mv -f "$owner_tmp" "$lock_dir/pid"; then
        rm -f "$owner_tmp"
        return 1
    fi
}

prepare_schedule_publication_lock_candidate() {
    local candidate
    PREPARED_LOCK_CANDIDATE=""
    if ! candidate=$(mktemp -d "$RUNTIME_DIR/.restore-publication.XXXXXX"); then
        echo "Unable to prepare scheduled restore publication lock." >&2
        return 1
    fi
    if ! track_lock_candidate "$candidate"; then
        rm -rf "$candidate"
        echo "Unable to track a scheduled restore publication lock candidate." >&2
        return 1
    fi
    if ! chmod 700 "$candidate" ||
        ! write_schedule_publication_lock_owner "$candidate"; then
        rm -rf "$candidate"
        untrack_lock_candidate "$candidate"
        echo "Unable to initialize scheduled restore publication lock." >&2
        return 1
    fi
    PREPARED_LOCK_CANDIDATE="$candidate"
}

install_schedule_publication_lock_candidate() {
    local candidate="$1"
    local owner_record="$2"
    local candidate_name
    local nested_candidate
    local installed_record=""

    candidate_name=$(basename "$candidate")
    if [[ -L "$SCHEDULE_PUBLICATION_LOCK_DIR" ||
        ( -e "$SCHEDULE_PUBLICATION_LOCK_DIR" &&
            ! -d "$SCHEDULE_PUBLICATION_LOCK_DIR" ) ]]; then
        return 1
    fi
    if [[ -d "$SCHEDULE_PUBLICATION_LOCK_DIR" ]]; then
        return 1
    fi
    if ! mv "$candidate" "$SCHEDULE_PUBLICATION_LOCK_DIR" 2>/dev/null; then
        return 1
    fi

    if [[ -f "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" &&
        ! -L "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" ]]; then
        installed_record=$(cat "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" 2>/dev/null || true)
    fi
    nested_candidate="$SCHEDULE_PUBLICATION_LOCK_DIR/$candidate_name"
    if [[ "$installed_record" == "$owner_record" &&
        ! -e "$nested_candidate" && ! -L "$nested_candidate" ]]; then
        return 0
    fi
    if [[ -e "$nested_candidate" || -L "$nested_candidate" ]]; then
        rm -rf "$nested_candidate"
    fi
    return 1
}

reclaim_schedule_publication_lock() {
    local observed_state="$1"
    local observed_pid="$2"
    local observed_start="$3"
    local candidate="$4"
    local owner_record="$5"
    local observed_stale="${6:-0}"
    local current_pid=""
    local current_start=""

    if [[ "$observed_state" == "complete" ]] &&
        kill -0 "$observed_pid" 2>/dev/null; then
        current_start=$(ps -p "$observed_pid" -o lstart= 2>/dev/null | tr -s ' ' '_' || true)
        if [[ ! "$current_start" =~ [[:alnum:]] ||
            "$current_start" == "$observed_start" ]]; then
            return 1
        fi
    elif [[ "$observed_state" == "incomplete" &&
        "$observed_stale" -ne 1 ]] &&
        ! schedule_publication_lock_is_stale; then
        return 1
    fi
    if ! claim_reclaim_marker "$SCHEDULE_PUBLICATION_LOCK_DIR"; then
        return 1
    fi
    if [[ -f "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" &&
        ! -L "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" ]]; then
        read -r current_pid current_start < "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" 2>/dev/null || true
    fi
    local current_state="incomplete"
    if [[ "$current_pid" =~ ^[0-9]+$ && -n "$current_start" ]]; then
        current_state="complete"
    fi
    if [[ "$current_state" != "$observed_state" ||
        "$current_pid" != "$observed_pid" ||
        "$current_start" != "$observed_start" ]]; then
        cleanup_owned_reclaim_marker || true
        return 1
    fi
    if [[ "$current_state" == "complete" ]] &&
        kill -0 "$current_pid" 2>/dev/null; then
        local live_start
        live_start=$(ps -p "$current_pid" -o lstart= 2>/dev/null | tr -s ' ' '_' || true)
        if [[ ! "$live_start" =~ [[:alnum:]] ||
            "$live_start" == "$current_start" ]]; then
            cleanup_owned_reclaim_marker || true
            return 1
        fi
    fi
    if ! rm -rf "$SCHEDULE_PUBLICATION_LOCK_DIR"; then
        cleanup_owned_reclaim_marker || true
        return 1
    fi
    reset_reclaim_marker_state
    if ! install_schedule_publication_lock_candidate "$candidate" "$owner_record"; then
        return 1
    fi
    return 0
}

acquire_schedule_publication_lock() {
    local deadline="${1:-}"
    local owner_pid=""
    local owner_start=""
    local owner_state="incomplete"
    local candidate=""
    local owner_record=""
    if [[ -z "$deadline" ]] &&
        ! deadline=$(timing_deadline "$PUBLICATION_LOCK_DEADLINE"); then
        echo "Unable to establish a deadline for scheduled restore publication lock acquisition." >&2
        return 1
    fi
    while ! timing_deadline_reached "$deadline"; do
        if [[ -n "$candidate" &&
            ! -e "$candidate" && ! -L "$candidate" ]]; then
            untrack_lock_candidate "$candidate"
            candidate=""
            owner_record=""
        fi
        if [[ -z "$candidate" ]]; then
            if ! prepare_schedule_publication_lock_candidate ||
                ! candidate="$PREPARED_LOCK_CANDIDATE" ||
                ! owner_record=$(cat "$candidate/pid" 2>/dev/null); then
                [[ -n "$candidate" ]] && rm -rf "$candidate"
                [[ -n "$candidate" ]] && untrack_lock_candidate "$candidate"
                return 1
            fi
        fi
        if [[ -L "$SCHEDULE_PUBLICATION_LOCK_DIR" ||
            ( -e "$SCHEDULE_PUBLICATION_LOCK_DIR" &&
                ! -d "$SCHEDULE_PUBLICATION_LOCK_DIR" ) ]]; then
            rm -rf "$candidate"
            untrack_lock_candidate "$candidate"
            echo "Refusing to use invalid scheduled restore publication lock: $SCHEDULE_PUBLICATION_LOCK_DIR" >&2
            return 1
        fi
        if install_schedule_publication_lock_candidate "$candidate" "$owner_record"; then
            untrack_lock_candidate "$candidate"
            SCHEDULE_PUBLICATION_LOCK_HELD=1
            return 0
        fi

        owner_pid=""
        owner_start=""
        if [[ -f "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" &&
            ! -L "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" ]]; then
            read -r owner_pid owner_start < "$SCHEDULE_PUBLICATION_LOCK_DIR/pid" 2>/dev/null || true
        fi
        owner_state="incomplete"
        if [[ "$owner_pid" =~ ^[0-9]+$ && -n "$owner_start" ]]; then
            owner_state="complete"
        fi
        local owner_lock_stale=0
        local owner_lock_age_known=1
        if [[ "$owner_state" == "incomplete" ]]; then
            local owner_lock_mtime=""
            if ! owner_lock_mtime=$(schedule_publication_lock_mtime "$SCHEDULE_PUBLICATION_LOCK_DIR"); then
                owner_lock_age_known=0
            elif timing_age_reached "$owner_lock_mtime" "$LOCK_INITIALIZATION_GRACE"; then
                owner_lock_stale=1
            fi
        fi
        if [[ -L "$SCHEDULE_PUBLICATION_LOCK_DIR/.reclaim" ]]; then
            rm -rf "$candidate"
            untrack_lock_candidate "$candidate"
            echo "The scheduled restore publication lock has an invalid reclamation marker; refusing to use it." >&2
            return 1
        fi
        if [[ -d "$SCHEDULE_PUBLICATION_LOCK_DIR/.reclaim" ]] &&
            ! recover_stale_reclaim_marker "$SCHEDULE_PUBLICATION_LOCK_DIR"; then
            sleep "$LOCK_RETRY_INTERVAL"
            continue
        fi
        if [[ "$owner_state" == "complete" ]]; then
            if reclaim_schedule_publication_lock \
                "complete" "$owner_pid" "$owner_start" "$candidate" "$owner_record"; then
                untrack_lock_candidate "$candidate"
                SCHEDULE_PUBLICATION_LOCK_HELD=1
                return 0
            fi
        else
            if [[ "$owner_lock_age_known" -ne 1 ]]; then
                sleep "$LOCK_RETRY_INTERVAL"
                continue
            fi
            if reclaim_schedule_publication_lock \
                "incomplete" "$owner_pid" "$owner_start" "$candidate" "$owner_record" \
                "$owner_lock_stale"; then
                untrack_lock_candidate "$candidate"
                SCHEDULE_PUBLICATION_LOCK_HELD=1
                return 0
            fi
            if [[ "$owner_lock_stale" -ne 1 ]]; then
                rm -rf "$candidate"
                untrack_lock_candidate "$candidate"
                echo "The scheduled restore publication lock at $SCHEDULE_PUBLICATION_LOCK_DIR has incomplete owner metadata; refusing to reclaim it." >&2
                return 1
            fi
        fi
        sleep "$LOCK_RETRY_INTERVAL"
    done
    if [[ -n "$candidate" ]]; then
        rm -rf "$candidate"
        untrack_lock_candidate "$candidate"
    fi
    echo "Timed out waiting for scheduled restore publication lock: $SCHEDULE_PUBLICATION_LOCK_DIR" >&2
    return 1
}

scheduled_restore_is_authoritative() {
    local schedule_key="$1"
    local scheduled=""

    [[ ! -L "$SCHEDULE_PID_FILE" ]] || return 1
    scheduled=$(cat "$SCHEDULE_PID_FILE" 2>/dev/null || true)
    [[ "$scheduled" == "$$ $schedule_key" ]]
}

claim_scheduled_restore() {
    local schedule_key="$1"
    local retry_deadline
    local claim_status=1

    if ! retry_deadline=$(timing_deadline "$RESTORE_LOCK_RETRY_DEADLINE"); then
        log_debug "RESTORE: gave up waiting for restore lock because no retry deadline could be established"
        return 1
    fi

    while ! timing_deadline_reached "$retry_deadline"; do
        if ! scheduled_restore_is_authoritative "$schedule_key"; then
            log_debug "RESTORE: gave up waiting for restore lock because scheduled token was superseded"
            return 2
        fi
        if ! acquire_schedule_publication_lock "$retry_deadline"; then
            if ! scheduled_restore_is_authoritative "$schedule_key"; then
                log_debug "RESTORE: gave up waiting for restore lock because scheduled token was superseded"
                return 2
            fi
            if timing_deadline_reached "$retry_deadline"; then
                log_debug "RESTORE: gave up waiting for restore lock before deadline; publication lock acquisition did not complete"
                return 1
            fi
            sleep "$LOCK_RETRY_INTERVAL"
            continue
        fi
        SCHEDULE_PUBLICATION_LOCK_HELD=1

        if ! scheduled_restore_is_authoritative "$schedule_key"; then
            release_schedule_publication_lock || true
            log_debug "RESTORE: gave up waiting for restore lock because scheduled token was superseded"
            return 2
        fi
        if acquire_restore_lock; then
            if scheduled_restore_is_authoritative "$schedule_key"; then
                claim_status=0
            else
                release_restore_lock || true
                claim_status=2
            fi
            if ! release_schedule_publication_lock; then
                if [[ "$claim_status" -eq 0 ]]; then
                    release_restore_lock || true
                fi
                return 1
            fi
            if [[ "$claim_status" -eq 0 ]]; then
                return 0
            fi
            log_debug "RESTORE: gave up waiting for restore lock because scheduled token was superseded"
            return 2
        fi
        release_schedule_publication_lock || true

        if ! scheduled_restore_is_authoritative "$schedule_key"; then
            log_debug "RESTORE: gave up waiting for restore lock because scheduled token was superseded"
            return 2
        fi
        if timing_deadline_reached "$retry_deadline"; then
            log_debug "RESTORE: gave up waiting for restore lock before deadline; another restore remained active"
            return 1
        fi
        sleep "$LOCK_RETRY_INTERVAL"
    done
    log_debug "RESTORE: gave up waiting for restore lock before deadline; another restore remained active"
    return "$claim_status"
}

schedule_restore() {
    secure_runtime_storage || return 1
    rotate_runtime_logs || return 1
    if ! acquire_schedule_publication_lock; then
        return 1
    fi
    trap 'cleanup_owned_reclaim_marker || true; cleanup_owned_lock_candidates || true; release_schedule_publication_lock' EXIT

    if [[ -e "$SCHEDULE_PID_FILE" && ! -f "$SCHEDULE_PID_FILE" && ! -L "$SCHEDULE_PID_FILE" ]]; then
        trap - EXIT
        release_schedule_publication_lock || true
        echo "Refusing to replace non-regular scheduled restore state: $SCHEDULE_PID_FILE" >&2
        return 1
    fi
    local token
    local pid_file_tmp
    local scheduled_pid
    schedule_key="$(date +%s)-$$-${RANDOM}"
    "$0" _delayed-restore "$schedule_key" >> "$RUNTIME_DIR/yabai.out.log" 2>> "$RUNTIME_DIR/yabai.err.log" &
    scheduled_pid="$!"
    if ! pid_file_tmp=$(mktemp "${SCHEDULE_PID_FILE}.XXXXXX"); then
        trap - EXIT
        release_schedule_publication_lock || true
        echo "Unable to create scheduled restore state." >&2
        return 1
    fi
    if ! printf '%s %s\n' "$scheduled_pid" "$schedule_key" > "$pid_file_tmp" ||
        ! chmod 600 "$pid_file_tmp" ||
        ! mv -f "$pid_file_tmp" "$SCHEDULE_PID_FILE"; then
        rm -f "$pid_file_tmp"
        trap - EXIT
        release_schedule_publication_lock || true
        echo "Unable to record scheduled restore state." >&2
        return 1
    fi
    chmod 600 "$RUNTIME_DIR/yabai.out.log" "$RUNTIME_DIR/yabai.err.log" 2>/dev/null || true
    trap - EXIT
    release_schedule_publication_lock
}

run_delayed_restore() {
    local schedule_key="${1:-}"
    if [[ ! "$schedule_key" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "Invalid scheduled restore token." >&2
        return 2
    fi

    secure_runtime_storage
    cleanup_scheduled_restore() {
        local expected_schedule_key="$1"
        local scheduled=""
        local cleanup_lock=0
        [[ ! -L "$SCHEDULE_PID_FILE" ]] || return 0
        if [[ "$SCHEDULE_PUBLICATION_LOCK_HELD" -eq 0 ]]; then
            if ! acquire_schedule_publication_lock; then
                return 0
            fi
            cleanup_lock=1
        fi
        if [[ -f "$SCHEDULE_PID_FILE" && ! -L "$SCHEDULE_PID_FILE" ]]; then
            scheduled=$(cat "$SCHEDULE_PID_FILE" 2>/dev/null || true)
            if [[ "$scheduled" == "$$ $expected_schedule_key" ]]; then
                rm -f "$SCHEDULE_PID_FILE"
            fi
        fi
        if [[ "$cleanup_lock" -eq 1 ]]; then
            release_schedule_publication_lock || true
        fi
    }
    trap "cleanup_owned_reclaim_marker || true; cleanup_owned_lock_candidates || true; cleanup_scheduled_restore '$schedule_key'" EXIT

    local delay_pid=""
    handle_delayed_restore_signal() {
        local status="$1"
        trap - INT TERM EXIT
        if [[ -n "$delay_pid" ]]; then
            kill "$delay_pid" 2>/dev/null || true
            wait "$delay_pid" 2>/dev/null || true
        fi
        cleanup_owned_reclaim_marker || true
        cleanup_owned_lock_candidates || true
        release_restore_lock || true
        release_schedule_publication_lock || true
        cleanup_scheduled_restore "$schedule_key"
        exit "$status"
    }
    trap 'handle_delayed_restore_signal 130' INT
    trap 'handle_delayed_restore_signal 143' TERM

    local scheduled=""
    local attempt
    for attempt in 1 2 3 4 5; do
        [[ ! -L "$SCHEDULE_PID_FILE" ]] || return 0
        scheduled=$(cat "$SCHEDULE_PID_FILE" 2>/dev/null || true)
        if [[ "$scheduled" == "$$ $schedule_key" ]]; then
            break
        fi
        sleep 1
    done
    if [[ "$scheduled" != "$$ $schedule_key" ]]; then
        return 0
    fi

    local sleep_status=0
    sleep "$RESTORE_DELAY" &
    delay_pid="$!"
    wait "$delay_pid" || sleep_status=$?
    delay_pid=""
    if [[ "$sleep_status" -ne 0 ]]; then
        return "$sleep_status"
    fi
    [[ ! -L "$SCHEDULE_PID_FILE" ]] || return 0
    scheduled=$(cat "$SCHEDULE_PID_FILE" 2>/dev/null || true)
    if [[ "$scheduled" != "$$ $schedule_key" ]]; then
        return 0
    fi
    if ! preflight_dependencies; then
        return 1
    fi
    local claim_status=0
    claim_scheduled_restore "$schedule_key" || claim_status=$?
    if [[ "$claim_status" -eq 2 ]]; then
        return 0
    fi
    if [[ "$claim_status" -ne 0 ]]; then
        return 1
    fi

    local restore_status=0
    restore_layout || restore_status=$?
    if ! release_restore_lock; then
        restore_status=1
    fi
    return "$restore_status"
}

usage() {
    echo "Usage: window-layout <save|restore|restore-backup|list|schedule-restore>"
    echo ""
    echo "  save              Save current window positions for this display configuration"
    echo "  restore [config]  Restore window positions (optionally from a specific config ID)"
    echo "  restore-backup [config] Revert to the previous save and restore it"
    echo "  list              List all saved layouts"
}

validate_timing_configuration || exit 1
secure_layout_storage
if [[ "${1:-}" != "schedule-restore" && "${1:-}" != "_delayed-restore" ]]; then
    preflight_dependencies
fi

case "${1:-}" in
    save)            save_layout ;;
    restore)         shift; run_with_restore_lock restore_layout "${1:-}" ;;
    restore-backup)  shift; run_with_restore_lock restore_backup "${1:-}" ;;
    list)            list_layouts ;;
    schedule-restore) schedule_restore ;;
    _delayed-restore) shift; run_delayed_restore "${1:-}" ;;
    *)               usage; exit 1 ;;
esac
