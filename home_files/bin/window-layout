import json
import os
import subprocess
import time
from datetime import datetime

moves = json.loads(os.environ['MOVES_JSON'])
log_file = os.environ['LOG_FILE']

def log(message):
    with open(log_file, 'a') as f:
        f.write(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {message}\n")

def osa(script):
    result = subprocess.run(['osascript', '-e', script], capture_output=True, text=True)
    if result.returncode != 0:
        log(f"RESTORE: osascript_error rc={result.returncode} stderr={result.stderr.strip()}")
    return result

# yabai has been observed to hang indefinitely on some commands (e.g. moving a
# window onto a space that is itself in native fullscreen). Every yabai call
# below is timeout-bounded so a stuck yabai process can never hang the whole
# restore; a timeout is logged and treated as failure rather than retried.
def yabai_cmd(args, timeout=5):
    try:
        result = subprocess.run(['yabai', '-m'] + args, capture_output=True, text=True, timeout=timeout)
        return result.returncode, (result.stdout or '').strip(), (result.stderr or '').strip()
    except subprocess.TimeoutExpired:
        return -1, '', 'timeout'

def yabai_window_state(win_id, timeout=3):
    rc, out, _ = yabai_cmd(['query', '--windows', '--window', str(win_id)], timeout=timeout)
    if rc != 0 or not out:
        return None
    try:
        return json.loads(out)
    except Exception:
        return None

def yabai_spaces(timeout=3):
    rc, out, _ = yabai_cmd(['query', '--spaces'], timeout=timeout)
    if rc != 0 or not out:
        return None
    try:
        return json.loads(out)
    except Exception:
        return None

def poll_until(check_fn, tries=6, interval=1.0):
    for _ in range(tries):
        time.sleep(interval)
        try:
            if check_fn():
                return True
        except Exception:
            pass
    return False

def escape_as(s):
    return s.replace('\\', '\\\\').replace('"', '\\"')

def int_frame(frame, key, default=0):
    try:
        return int(round(float(frame.get(key, default))))
    except Exception:
        return default

def target_bounds(move):
    frame = move.get('target_frame') or {}
    x = int_frame(frame, 'x')
    y = int_frame(frame, 'y')
    w = max(800, int_frame(frame, 'w', 2560))
    h = max(600, int_frame(frame, 'h', 1440))
    width = min(1400, max(700, w - 120))
    height = min(900, max(500, h - 160))
    left = x + max(40, (w - width) // 2)
    top = y + max(60, min(120, (h - height) // 2))
    return left, top, left + width, top + height

def window_title_matches(window_title, title):
    return window_title == title or window_title.startswith(title) or title.startswith(window_title)

def verify_move(yabai_window_id, app, title, target_yabai_display, target_frame):
    try:
        verify = subprocess.run(
            ['yabai', '-m', 'query', '--windows'],
            capture_output=True,
            text=True,
            timeout=10,
        )
    except subprocess.TimeoutExpired:
        log("RESTORE: verify_yabai_timeout")
        return False
    if verify.returncode != 0:
        log(f"RESTORE: verify_yabai_error rc={verify.returncode} stderr={verify.stderr.strip()}")
        return False
    try:
        windows = json.loads(verify.stdout)
    except json.JSONDecodeError as exc:
        log(f"RESTORE: verify_json_error error={exc}")
        return False
    for w in windows:
        if yabai_window_id is not None:
            if str(w.get('id')) != str(yabai_window_id):
                continue
        else:
            if w.get('app') != app:
                continue
            wt = w.get('title', '')
            if not window_title_matches(wt, title):
                continue
        if target_yabai_display is not None and w.get('display') == target_yabai_display:
            return True
        frame = w.get('frame', {})
        wx = int_frame(frame, 'x')
        wy = int_frame(frame, 'y')
        tx = int_frame(target_frame, 'x')
        ty = int_frame(target_frame, 'y')
        tw = int_frame(target_frame, 'w', 2560)
        th = int_frame(target_frame, 'h', 1440)
        if tx <= wx < tx + tw and ty <= wy < ty + th:
            return True
    return False

for m in moves:
    app = m['app']
    title = m['title']
    source = m.get('source_display', 'unknown')
    target = m['target_display']
    target_key = m.get('target_display_key', '')
    target_yabai_display = m.get('target_yabai_display')
    target_frame = m.get('target_frame') or {}
    yabai_window_id = m.get('yabai_window_id')
    should_fs = m['fullscreen']
    phase = m.get('phase', 'unknown')
    bounds = target_bounds(m)
    raw_chrome_id = m.get('chrome_window_id', '') if app == 'Google Chrome' else ''
    use_chrome_id = bool(raw_chrome_id) and str(raw_chrome_id).isdigit()

    print(f"  Moving '{app}' ({title[:40]}...) from {source} to {target}")
    log(f"RESTORE: execute phase={phase} app={app} title={title} from={source} to={target} target_key={target_key} target_yabai_display={target_yabai_display} bounds={bounds} chrome_window_id={raw_chrome_id}")

    as_app = escape_as(app)
    as_title = escape_as(title)
    as_target = escape_as(target)

    if use_chrome_id:
        # Chrome windows with a known stable id are addressed by id rather than
        # title: blank/duplicate titles make `window "{title}"` ambiguous or
        # outright invalid (`window ""` is not a valid System Events lookup).
        # Raising the window by id first makes it "window 1" (frontmost) for
        # both Chrome's own dictionary and System Events for the rest of the steps.
        raise_result = osa(f'''
tell application "{as_app}"
    activate
    try
        set targetWindow to (first window whose id is {raw_chrome_id})
        set index of targetWindow to 1
        return "ok"
    on error errMsg
        return "fail:" & errMsg
    end try
end tell
''')
        log(f"RESTORE: raise_by_id_result app={app} chrome_window_id={raw_chrome_id} stdout={raise_result.stdout.strip()}")
        time.sleep(0.5)
        se_window_ref = 'window 1'
    else:
        # Step 1: Activate app and switch to window via Window menu (title-based)
        osa(f'''
tell application "{as_app}" to activate
delay 0.3
tell application "System Events"
    tell process "{as_app}"
        try
            set menuItems to every menu item of menu "Window" of menu bar 1
            repeat with mi in menuItems
                if name of mi starts with "{as_title}" or "{as_title}" starts with name of mi then
                    click mi
                    exit repeat
                end if
            end repeat
        end try
    end tell
end tell
''')
        time.sleep(1)
        se_window_ref = f'window "{as_title}"'

    # Step 2: Exit fullscreen
    exit_fs_result = osa(f'''
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            set fs to value of attribute "AXFullScreen" of targetWin
            if fs then
                set value of attribute "AXFullScreen" of targetWin to false
                return "exited"
            else
                return "not_fullscreen"
            end if
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
    log(f"RESTORE: exit_fullscreen_result app={app} title={title} stdout={exit_fs_result.stdout.strip()}")
    time.sleep(2)

    # Step 3: Move to target display using bounds derived from target frame.
    left, top, right, bottom = bounds
    if use_chrome_id:
        bounds_script = f'''
try
    tell application "{as_app}"
        set targetWindow to (first window whose id is {raw_chrome_id})
        set bounds of targetWindow to {{{left}, {top}, {right}, {bottom}}}
        return "ok"
    end tell
on error errMsg
    return "fail:" & errMsg
end try
'''
    else:
        bounds_script = f'''
try
    tell application "{as_app}"
        repeat with w in every window
            if title of w starts with "{as_title}" or "{as_title}" starts with title of w then
                set bounds of w to {{{left}, {top}, {right}, {bottom}}}
                return "ok"
            end if
        end repeat
        return "fail:no matching window"
    end tell
on error errMsg
    return "fail:" & errMsg
end try
'''
    result = osa(bounds_script)
    moved_via_bounds = 'ok' in (result.stdout or '')
    log(f"RESTORE: bounds_result app={app} title={title} moved_via_bounds={moved_via_bounds} stdout={result.stdout.strip()}")

    # Step 3b: Accessibility-API fallback (position/size) for apps whose own
    # AppleScript dictionary doesn't support "every window"/"bounds of window"
    # (e.g. GitHub Copilot). This talks to the window via System Events'
    # AXPosition/AXSize attributes instead of the app's own scripting suite.
    moved_via_ax = False
    if not moved_via_bounds:
        width = right - left
        height = bottom - top
        ax_result = osa(f'''
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            set position of targetWin to {{{left}, {top}}}
            set size of targetWin to {{{width}, {height}}}
            return "ok"
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
        moved_via_ax = 'ok' in (ax_result.stdout or '')
        log(f"RESTORE: ax_result app={app} title={title} moved_via_ax={moved_via_ax} stdout={ax_result.stdout.strip()}")

    if not moved_via_bounds and not moved_via_ax:
        menu_result = osa(f'''
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            perform action "AXRaise" of targetWin
            delay 0.3
            click menu item "Move to {as_target}" of menu "Window" of menu bar 1
            return "ok"
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
        log(f"RESTORE: menu_result app={app} title={title} target={target} stdout={menu_result.stdout.strip()}")
    time.sleep(1)

    # Step 3.5: Verify the move actually happened. If not, try menu fallback.
    time.sleep(1)
    actually_moved = verify_move(yabai_window_id, app, title, target_yabai_display, target_frame)
    log(f"RESTORE: verify app={app} title={title} target={target} actually_moved={actually_moved}")

    if not actually_moved:
        print(f"    ! Move didn't stick, trying menu fallback")
        if not moved_via_ax:
            retry_ax_result = osa(f'''
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            perform action "AXRaise" of targetWin
            delay 0.3
            set position of targetWin to {{{left}, {top}}}
            set size of targetWin to {{{right - left}, {bottom - top}}}
            return "ok"
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
            log(f"RESTORE: retry_ax_result app={app} title={title} stdout={retry_ax_result.stdout.strip()}")
        fallback_result = osa(f'''
tell application "{as_app}" to activate
delay 0.3
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            perform action "AXRaise" of targetWin
            delay 0.3
            click menu item "Move to {as_target}" of menu "Window" of menu bar 1
            return "ok"
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
        log(f"RESTORE: fallback_menu_result app={app} title={title} target={target} stdout={fallback_result.stdout.strip()}")
        time.sleep(2)
        actually_moved = verify_move(yabai_window_id, app, title, target_yabai_display, target_frame)
        log(f"RESTORE: fallback_verify app={app} title={title} target={target} actually_moved={actually_moved}")

    # Step 3.9: yabai native-fullscreen fallback. AppleScript/System Events can only
    # enumerate windows on the currently visible macOS Space, so every prior strategy
    # silently fails for a fullscreen window sitting on a different Space -- Chrome's
    # own "set bounds" can even report "ok" while the window never actually moves,
    # because native-fullscreen windows are size-locked to their own Space. yabai
    # operates below that restriction, so as a last resort for still-stuck fullscreen
    # windows: exit native fullscreen via yabai, move the (now-normal) window to a
    # non-fullscreen space on the target display, then re-enter fullscreen there.
    # yabai has been observed to hang on some of these calls (e.g. moving a window
    # onto a space that is itself fullscreen), so every call is timeout-bounded and
    # polled rather than blindly chained.
    yabai_fallback_handled_fs = False
    if not actually_moved:
        if yabai_window_id and target_yabai_display and should_fs:
            log(f"RESTORE: yabai_fallback_start app={app} title={title} yabai_window_id={yabai_window_id} target_yabai_display={target_yabai_display}")
            rc, out, err = yabai_cmd(['window', str(yabai_window_id), '--toggle', 'native-fullscreen'])
            log(f"RESTORE: yabai_fs_off_cmd rc={rc} stdout={out} stderr={err}")
            fs_off_ok = poll_until(lambda: (yabai_window_state(yabai_window_id) or {}).get('is-native-fullscreen') is False)
            log(f"RESTORE: yabai_fs_off_result ok={fs_off_ok}")

            move_ok = False
            if fs_off_ok:
                spaces = yabai_spaces() or []
                candidate_spaces = [s['index'] for s in spaces
                                     if s.get('display') == target_yabai_display and not s.get('is-native-fullscreen')]
                if candidate_spaces:
                    target_space = candidate_spaces[0]
                    rc, out, err = yabai_cmd(['window', str(yabai_window_id), '--space', str(target_space)])
                    log(f"RESTORE: yabai_move_cmd rc={rc} stdout={out} stderr={err} target_space={target_space}")
                    move_ok = poll_until(lambda: (yabai_window_state(yabai_window_id) or {}).get('display') == target_yabai_display)
                    log(f"RESTORE: yabai_move_result ok={move_ok}")
                else:
                    log(f"RESTORE: yabai_fallback_abort reason=no_normal_space_on_target_display target_yabai_display={target_yabai_display}")

                if move_ok:
                    rc, out, err = yabai_cmd(['window', str(yabai_window_id), '--toggle', 'native-fullscreen'])
                    log(f"RESTORE: yabai_fs_on_cmd rc={rc} stdout={out} stderr={err}")
                    fs_on_ok = poll_until(lambda: (yabai_window_state(yabai_window_id) or {}).get('is-native-fullscreen') is True)
                    log(f"RESTORE: yabai_fs_on_result ok={fs_on_ok}")
                    yabai_fallback_handled_fs = fs_on_ok
                else:
                    # Leave the window in its pre-fallback fullscreen state rather than
                    # stranding it as a normal window on the wrong display.
                    yabai_cmd(['window', str(yabai_window_id), '--toggle', 'native-fullscreen'])
            else:
                log(f"RESTORE: yabai_fallback_abort reason=fullscreen_exit_failed_or_timed_out")

            actually_moved = verify_move(yabai_window_id, app, title, target_yabai_display, target_frame)
            log(f"RESTORE: yabai_fallback_verify app={app} title={title} target={target} actually_moved={actually_moved}")
        elif not yabai_window_id:
            log(f"RESTORE: yabai_fallback_skipped reason=no_yabai_window_id")

    # Step 4: Re-enter fullscreen
    if should_fs and not yabai_fallback_handled_fs:
        reenter_fs_result = osa(f'''
tell application "System Events"
    tell process "{as_app}"
        try
            set targetWin to {se_window_ref}
            set value of attribute "AXFullScreen" of targetWin to true
            return "ok"
        on error errMsg
            return "fail:" & errMsg
        end try
    end tell
end tell
''')
        log(f"RESTORE: reenter_fullscreen_result app={app} title={title} stdout={reenter_fs_result.stdout.strip()}")
        time.sleep(1.5)

print('Done.')
PY

    touch "$layout_file"
    cleanup_stale
}

list_layouts() {
    [[ -d "$LAYOUT_DIR" ]] || { echo "No layouts saved yet."; return; }
    local current_id
    current_id=$(get_config_id)
    for f in "$LAYOUT_DIR"/*; do
        [[ -f "$f" ]] || continue
        [[ "$f" == *.bak ]] && continue
        [[ "$f" == */debug.log ]] && continue
        local id
        id=$(basename "$f")
        local count
        count=$(python3 -c "import json; print(len(json.load(open('$f'))))" 2>/dev/null || echo "invalid")
        local displays
        displays=$(python3 -c "
import json
entries = json.load(open('$f'))
displays = sorted(set(e['display'] for e in entries))
print(', '.join(displays))
" 2>/dev/null || echo "invalid layout")
        local marker=""
        [[ "$id" == "$current_id" ]] && marker=" (current)"
        echo "  $id  ${count} windows  [$displays]${marker}"
    done
}

restore_backup() {
    local config_id
    config_id=$(get_config_id)
    local backup_file="$LAYOUT_DIR/${config_id}.bak"

    if [[ ! -f "$backup_file" ]]; then
        echo "No backup found for current display config ($config_id)"
        return 1
    fi

    cp "$backup_file" "$LAYOUT_DIR/$config_id"
    echo "Restored backup for config $config_id"
    restore_layout
}

schedule_restore() {
    secure_runtime_storage

    if [[ -f "$SCHEDULE_PID_FILE" && ! -L "$SCHEDULE_PID_FILE" ]]; then
        local pending_pid=""
        local pending_token=""
        read -r pending_pid pending_token < "$SCHEDULE_PID_FILE" || true

        if [[ "$pending_pid" =~ ^[0-9]+$ && "$pending_token" =~ ^[A-Za-z0-9._-]+$ ]]; then
            local pending_user
            local pending_command
            pending_user=$(ps -p "$pending_pid" -o user= 2>/dev/null | xargs || true)
            pending_command=$(ps -p "$pending_pid" -o command= 2>/dev/null || true)
            if [[ "$pending_user" == "$(id -un)" && "$pending_command" == *"window-layout _delayed-restore $pending_token"* ]]; then
                kill "$pending_pid" 2>/dev/null || true
            fi
        fi
    fi

    rm -f "$SCHEDULE_PID_FILE"
    local token
    local pid_file_tmp
    token="$(date +%s)-$$-${RANDOM}"
    "$0" _delayed-restore "$token" >> "$RUNTIME_DIR/yabai.out.log" 2>> "$RUNTIME_DIR/yabai.err.log" &
    pid_file_tmp="${SCHEDULE_PID_FILE}.$$"
    printf '%s %s\n' "$!" "$token" > "$pid_file_tmp"
    chmod 600 "$pid_file_tmp" "$RUNTIME_DIR/yabai.out.log" "$RUNTIME_DIR/yabai.err.log" 2>/dev/null || true
    mv "$pid_file_tmp" "$SCHEDULE_PID_FILE"
}

run_delayed_restore() {
    local token="${1:-}"
    if [[ ! "$token" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "Invalid scheduled restore token." >&2
        return 2
    fi

    secure_runtime_storage
    cleanup_scheduled_restore() {
        local expected_token="$1"
        local scheduled=""
        scheduled=$(cat "$SCHEDULE_PID_FILE" 2>/dev/null || true)
        if [[ "$scheduled" == "$$ $expected_token" ]]; then
            rm -f "$SCHEDULE_PID_FILE"
        fi
    }
    trap "cleanup_scheduled_restore '$token'" EXIT

    sleep "$RESTORE_DELAY"
    local scheduled=""
    scheduled=$(cat "$SCHEDULE_PID_FILE" 2>/dev/null || true)
    if [[ "$scheduled" != "$$ $token" ]]; then
        return 0
    fi
    restore_layout
}

usage() {
    echo "Usage: window-layout <save|restore|restore-backup|list>"
    echo ""
    echo "  save              Save current window positions for this display configuration"
    echo "  restore [config]  Restore window positions (optionally from a specific config ID)"
    echo "  restore-backup    Revert to the previous save and restore it"
    echo "  list              List all saved layouts"
}

case "${1:-}" in
    save)            save_layout ;;
    restore)         shift; restore_layout "${1:-}" ;;
    restore-backup)  restore_backup ;;
    list)            list_layouts ;;
    schedule-restore) schedule_restore ;;
    _delayed-restore) shift; run_delayed_restore "${1:-}" ;;
    *)               usage; exit 1 ;;
esac
