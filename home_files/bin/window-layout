#!/usr/bin/env bash
# window-layout - Save and restore window positions per display configuration
# Uses yabai and AppleScript to move windows between displays.
# Requires: yabai, swift, python3, osascript, md5, and Xcode Command Line Tools.
# Accessibility permissions are required for yabai, Terminal, and osascript.

set -euo pipefail
umask 077

LAYOUT_DIR="$HOME/.window-layouts"
LOG_FILE="$HOME/.window-layouts/debug.log"
LOG_BACKUP_FILE="$HOME/.window-layouts/debug.log.1"
LOG_MAX_BYTES=$((1024 * 1024))
LOCK_DIR="$HOME/.window-layouts/.restore.lock"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/window-layout"
SCHEDULE_PID_FILE="$RUNTIME_DIR/restore.pid"
SCHEDULE_PUBLICATION_LOCK_DIR="$RUNTIME_DIR/.restore-publication.lock"
SCHEDULE_PUBLICATION_LOCK_HELD=0
LOCK_CANDIDATES=()
PREPARED_LOCK_CANDIDATE=""
RECLAIM_MARKER_DIR=""
RECLAIM_MARKER_OWNER_RECORD=""
RECLAIM_MARKER_OWNER_FILE=""
RECLAIM_MARKER_OWNER_TMP=""
RECLAIM_MARKER_CREATED=0
RESTORE_DELAY="${WINDOW_LAYOUT_RESTORE_DELAY:-30}"
COMMAND_TIMEOUT="${WINDOW_LAYOUT_COMMAND_TIMEOUT:-10}"
LOCK_INITIALIZATION_GRACE="${WINDOW_LAYOUT_LOCK_INITIALIZATION_GRACE:-30}"
PUBLICATION_LOCK_DEADLINE="${WINDOW_LAYOUT_PUBLICATION_LOCK_DEADLINE:-60}"
RESTORE_LOCK_RETRY_DEADLINE="${WINDOW_LAYOUT_RESTORE_LOCK_RETRY_DEADLINE:-30}"
LOCK_RETRY_INTERVAL="${WINDOW_LAYOUT_LOCK_RETRY_INTERVAL:-0.05}"
STALE_DAYS=30
DEFAULT_CHROME_TITLE_SUFFIXES=' - google chrome'
CHROME_TITLE_SUFFIXES="${WINDOW_LAYOUT_CHROME_TITLE_SUFFIXES:-$DEFAULT_CHROME_TITLE_SUFFIXES}"

validate_positive_finite_timing() {
    local name="$1"
    local value="$2"
    if ! TIMING_NAME="$name" TIMING_VALUE="$value" python3 - <<'PY'
import math
import os

name = os.environ["TIMING_NAME"]
try:
    value = float(os.environ["TIMING_VALUE"])
except ValueError:
    raise SystemExit(f"{name} must be a positive finite number")
if not math.isfinite(value) or value <= 0:
    raise SystemExit(f"{name} must be a positive finite number")
PY
    then
        echo "$name must be a positive finite number." >&2
        return 1
    fi
}

validate_timing_configuration() {
    validate_positive_finite_timing WINDOW_LAYOUT_RESTORE_DELAY "$RESTORE_DELAY"
    validate_positive_finite_timing WINDOW_LAYOUT_COMMAND_TIMEOUT "$COMMAND_TIMEOUT"
    validate_positive_finite_timing WINDOW_LAYOUT_LOCK_INITIALIZATION_GRACE "$LOCK_INITIALIZATION_GRACE"
    validate_positive_finite_timing WINDOW_LAYOUT_PUBLICATION_LOCK_DEADLINE "$PUBLICATION_LOCK_DEADLINE"
    validate_positive_finite_timing WINDOW_LAYOUT_RESTORE_LOCK_RETRY_DEADLINE "$RESTORE_LOCK_RETRY_DEADLINE"
    validate_positive_finite_timing WINDOW_LAYOUT_LOCK_RETRY_INTERVAL "$LOCK_RETRY_INTERVAL"
    if [[ -n "${WINDOW_LAYOUT_DELAY_SCALE:-}" ]] &&
        ! TIMING_NAME=WINDOW_LAYOUT_DELAY_SCALE TIMING_VALUE="$WINDOW_LAYOUT_DELAY_SCALE" python3 - <<'PY'
import math
import os

try:
    value = float(os.environ["TIMING_VALUE"])
except ValueError:
    raise SystemExit(1)
if not math.isfinite(value) or value < 0:
    raise SystemExit(1)
PY
    then
        echo "WINDOW_LAYOUT_DELAY_SCALE must be a finite non-negative number." >&2
        return 1
    fi
}

timing_deadline() {
    TIMING_DURATION="$1" python3 - <<'PY'
import math
import os
import time

duration = float(os.environ["TIMING_DURATION"])
if not math.isfinite(duration) or duration <= 0:
    raise SystemExit(1)
print("%.6f" % (time.monotonic() + duration))
PY
}

timing_deadline_reached() {
    TIMING_DEADLINE="$1" python3 - <<'PY'
import time
import os

raise SystemExit(0 if time.monotonic() >= float(os.environ["TIMING_DEADLINE"]) else 1)
PY
}

timing_age_reached() {
    TIMING_MTIME="$1" TIMING_AGE="$2" python3 - <<'PY'
import math
import os
import time

mtime = float(os.environ["TIMING_MTIME"])
age = float(os.environ["TIMING_AGE"])
if not math.isfinite(mtime) or not math.isfinite(age) or age <= 0:
    raise SystemExit(1)
raise SystemExit(0 if time.time() - mtime >= age else 1)
PY
}

track_lock_candidate() {
    local candidate="$1"
    case "$candidate" in
        "$LAYOUT_DIR"/.restore-lock.*|"$RUNTIME_DIR"/.restore-publication.*)
            ;;
        *)
            return 1
            ;;
    esac
    [[ -d "$candidate" && ! -L "$candidate" ]] || return 1
    LOCK_CANDIDATES[${#LOCK_CANDIDATES[@]}]="$candidate"
}

untrack_lock_candidate() {
    local candidate="$1"
    local index
    for index in "${!LOCK_CANDIDATES[@]}"; do
        if [[ "${LOCK_CANDIDATES[$index]}" == "$candidate" ]]; then
            unset 'LOCK_CANDIDATES[index]'
        fi
    done
}

cleanup_owned_lock_candidates() {
    local candidate
    local cleanup_status=0
    for candidate in "${LOCK_CANDIDATES[@]+"${LOCK_CANDIDATES[@]}"}"; do
        [[ -n "$candidate" ]] || continue
        case "$candidate" in
            "$LAYOUT_DIR"/.restore-lock.*|"$RUNTIME_DIR"/.restore-publication.*)
                ;;
            *)
                cleanup_status=1
                continue
                ;;
        esac
        if [[ -d "$candidate" && ! -L "$candidate" ]] &&
            ! rm -rf "$candidate"; then
            cleanup_status=1
        fi
    done
    LOCK_CANDIDATES=()
    return "$cleanup_status"
}

reset_reclaim_marker_state() {
    RECLAIM_MARKER_DIR=""
    RECLAIM_MARKER_OWNER_RECORD=""
    RECLAIM_MARKER_OWNER_FILE=""
    RECLAIM_MARKER_OWNER_TMP=""
    RECLAIM_MARKER_CREATED=0
}

reclaim_owner_record() {
    local owner_start
    owner_start=$(ps -p "$$" -o lstart= 2>/dev/null | tr -s ' ' '_' || true)
    [[ "$owner_start" =~ [[:alnum:]] ]] || return 1
    printf '%s %s\n' "$$" "$owner_start"
}

reclaim_marker_mtime() {
    local marker="$1"
    local mtime
    mtime=$(stat -f %m "$marker" 2>/dev/null || true)
    if [[ ! "$mtime" =~ ^[0-9]+$ ]]; then
        mtime=$(stat -c %Y "$marker" 2>/dev/null || true)
    fi
    [[ "$mtime" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$mtime"
}

reclaim_marker_is_stale() {
    local marker="$1"
    local mtime

    if ! mtime=$(reclaim_marker_mtime "$marker"); then
        return 1
    fi
    timing_age_reached "$mtime" "$LOCK_INITIALIZATION_GRACE"
}

reclaim_marker_owner_is_live() {
    local marker="$1"
    local owner_pid=""
    local owner_start=""
    local current_start=""

    [[ -f "$marker/.owner" && ! -L "$marker/.owner" ]] || return 1
    read -r owner_pid owner_start < "$marker/.owner" 2>/dev/null || true
    [[ "$owner_pid" =~ ^[0-9]+$ && -n "$owner_start" ]] || return 1
    kill -0 "$owner_pid" 2>/dev/null || return 1
    current_start=$(ps -p "$owner_pid" -o lstart= 2>/dev/null | tr -s ' ' '_' || true)
    [[ "$current_start" =~ [[:alnum:]] ]] || return 2
    [[ "$current_start" == "$owner_start" ]]
}

remove_reclaim_marker_contents() {
    local marker="$1"
    local entry

    for entry in "$marker/.owner" "$marker"/.owner.*; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        [[ ! -L "$entry" && -f "$entry" ]] || return 1
        rm -f "$entry" || return 1
    done
    rmdir "$marker" 2>/dev/null
}

recover_stale_reclaim_marker() {
    local lock_dir="$1"
    local marker="$lock_dir/.reclaim"
    local owner_status=1

    [[ -e "$marker" || -L "$marker" ]] || return 0
    if [[ -L "$marker" || ! -d "$marker" ]]; then
        echo "Refusing to use an invalid reclamation marker: $marker" >&2
        return 1
    fi
    if ! reclaim_marker_is_stale "$marker"; then
        return 1
    fi
    if reclaim_marker_owner_is_live "$marker"; then
        return 1
    else
        owner_status=$?
    fi
    [[ "$owner_status" -ne 2 ]] || return 1
    if ! remove_reclaim_marker_contents "$marker"; then
        return 1
    fi
    return 0
}

claim_reclaim_marker() {
    local lock_dir="$1"
    local marker="$lock_dir/.reclaim"
    local owner_record
    local owner_tmp

    if ! recover_stale_reclaim_marker "$lock_dir"; then
        return 1
    fi
    if ! owner_record=$(reclaim_owner_record); then
        echo "Unable to identify the reclamation owner; refusing to reclaim $lock_dir." >&2
        return 1
    fi

    RECLAIM_MARKER_DIR="$marker"
    RECLAIM_MARKER_OWNER_RECORD="$owner_record"
    RECLAIM_MARKER_OWNER_FILE="$marker/.owner"
    RECLAIM_MARKER_OWNER_TMP="$marker/.owner.$$"
    RECLAIM_MARKER_CREATED=0
    if ! mkdir "$marker" 2>/dev/null; then
        reset_reclaim_marker_state
        return 1
    fi
    RECLAIM_MARKER_CREATED=1

    owner_tmp="$RECLAIM_MARKER_OWNER_TMP"
    if ! printf '%s\n' "$owner_record" > "$owner_tmp" ||
        ! chmod 600 "$owner_tmp" ||
        [[ -e "$RECLAIM_MARKER_OWNER_FILE" || -L "$RECLAIM_MARKER_OWNER_FILE" ]] ||
        ! mv "$owner_tmp" "$RECLAIM_MARKER_OWNER_FILE"; then
        cleanup_owned_reclaim_marker || true
        return 1
    fi
    RECLAIM_MARKER_OWNER_TMP=""
    return 0
}

cleanup_owned_reclaim_marker() {
    local marker="$RECLAIM_MARKER_DIR"
    local owner_record=""

    [[ "$RECLAIM_MARKER_CREATED" -eq 1 && -n "$marker" ]] || return 0
    if [[ -L "$marker" || ! -d "$marker" ]]; then
        reset_reclaim_marker_state
        return 0
    fi
    if [[ -n "$RECLAIM_MARKER_OWNER_TMP" ]]; then
        rm -f "$RECLAIM_MARKER_OWNER_TMP" 2>/dev/null || true
    fi
    if [[ -f "$RECLAIM_MARKER_OWNER_FILE" && ! -L "$RECLAIM_MARKER_OWNER_FILE" ]]; then
        owner_record=$(cat "$RECLAIM_MARKER_OWNER_FILE" 2>/dev/null || true)
        [[ "$owner_record" == "$RECLAIM_MARKER_OWNER_RECORD" ]] || return 1
        rm -f "$RECLAIM_MARKER_OWNER_FILE" || return 1
    else
        return 1
    fi
    if ! rmdir "$marker" 2>/dev/null; then
        return 1
    fi
    reset_reclaim_marker_state
}

handle_window_layout_signal() {
    local status="$1"
    trap - INT TERM EXIT
    cleanup_owned_reclaim_marker || true
    cleanup_owned_lock_candidates || true
    release_restore_lock || true
    release_schedule_publication_lock || true
    exit "$status"
}

trap 'handle_window_layout_signal 130' INT
trap 'handle_window_layout_signal 143' TERM
trap 'cleanup_owned_reclaim_marker || true; cleanup_owned_lock_candidates || true' EXIT

file_link_count() {
    local file="$1"
    local count
    count=$(stat -f %l "$file" 2>/dev/null || true)
    if [[ "$count" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$count"
        return 0
    fi
    count=$(stat -c %h "$file" 2>/dev/null || true)
    [[ "$count" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$count"
}

secure_layout_storage() {
    local layout_file
    local link_count
    if [[ -L "$LAYOUT_DIR" ]]; then
        echo "Refusing to use symlinked window-layout storage directory: $LAYOUT_DIR" >&2
        return 1
    fi
    mkdir -p "$LAYOUT_DIR"
    if [[ ! -d "$LAYOUT_DIR" || -L "$LAYOUT_DIR" ]]; then
        echo "Unable to create a private window-layout storage directory: $LAYOUT_DIR" >&2
        return 1
    fi
    for layout_file in \
        "$LAYOUT_DIR"/* \
        "$LAYOUT_DIR"/.[!.]* \
        "$LAYOUT_DIR"/..?*; do
        [[ -f "$layout_file" && ! -L "$layout_file" ]] || continue
        if ! link_count=$(file_link_count "$layout_file"); then
            echo "Unable to inspect link count for window-layout state file: $layout_file" >&2
            return 1
        fi
        if [[ "$link_count" -gt 1 ]]; then
            echo "Refusing to chmod hard-linked window-layout state file: $layout_file" >&2
            return 1
        fi
    done
    chmod 700 "$LAYOUT_DIR"
    for layout_file in \
        "$LAYOUT_DIR"/* \
        "$LAYOUT_DIR"/.[!.]* \
        "$LAYOUT_DIR"/..?*; do
        [[ -f "$layout_file" && ! -L "$layout_file" ]] || continue
        chmod 600 "$layout_file"
    done
}

secure_runtime_storage() {
    local runtime_file
    local link_count
    if [[ -L "$RUNTIME_DIR" ]]; then
        echo "Refusing to use symlinked window-layout runtime storage: $RUNTIME_DIR" >&2
        return 1
    fi
    if [[ -e "$RUNTIME_DIR" && ! -d "$RUNTIME_DIR" ]]; then
        echo "Refusing to use non-directory window-layout runtime storage: $RUNTIME_DIR" >&2
        return 1
    fi
    mkdir -p "$RUNTIME_DIR"
    if [[ ! -d "$RUNTIME_DIR" || -L "$RUNTIME_DIR" ]]; then
        echo "Unable to create window-layout runtime storage: $RUNTIME_DIR" >&2
        return 1
    fi
    for runtime_file in \
        "$RUNTIME_DIR/yabai.out.log" \
        "$RUNTIME_DIR/yabai.err.log" \
        "$RUNTIME_DIR/yabai.out.log.1" \
        "$RUNTIME_DIR/yabai.err.log.1"; do
        if [[ -L "$runtime_file" ]]; then
            echo "Refusing to use symlinked window-layout runtime log: $runtime_file" >&2
            return 1
        fi
        if [[ -e "$runtime_file" && ! -f "$runtime_file" ]]; then
            echo "Refusing to use non-regular window-layout runtime state: $runtime_file" >&2
            return 1
        fi
        if [[ -f "$runtime_file" ]]; then
            if ! link_count=$(file_link_count "$runtime_file"); then
                echo "Unable to inspect link count for window-layout runtime state: $runtime_file" >&2
                return 1
            fi
            if [[ "$link_count" -gt 1 ]]; then
                echo "Refusing to chmod hard-linked window-layout runtime state: $runtime_file" >&2
                return 1
            fi
        fi
    done
    if [[ -e "$SCHEDULE_PID_FILE" && ! -f "$SCHEDULE_PID_FILE" && ! -L "$SCHEDULE_PID_FILE" ]]; then
        echo "Refusing to use non-regular scheduled restore state: $SCHEDULE_PID_FILE" >&2
        return 1
    fi
    if [[ -f "$SCHEDULE_PID_FILE" && ! -L "$SCHEDULE_PID_FILE" ]]; then
        if ! link_count=$(file_link_count "$SCHEDULE_PID_FILE"); then
            echo "Unable to inspect link count for scheduled restore state: $SCHEDULE_PID_FILE" >&2
            return 1
        fi
        if [[ "$link_count" -gt 1 ]]; then
            echo "Refusing to chmod hard-linked scheduled restore state: $SCHEDULE_PID_FILE" >&2
            return 1
        fi
    fi
    chmod 700 "$RUNTIME_DIR"
    for runtime_file in \
        "$RUNTIME_DIR/yabai.out.log" \
        "$RUNTIME_DIR/yabai.err.log" \
        "$RUNTIME_DIR/yabai.out.log.1" \
        "$RUNTIME_DIR/yabai.err.log.1" \
        "$SCHEDULE_PID_FILE"; do
        [[ -f "$runtime_file" && ! -L "$runtime_file" ]] || continue
        chmod 600 "$runtime_file"
    done
}

rotate_runtime_log() {
    local log_file="$1"
    local backup_file="${log_file}.1"
    local log_size

    if [[ -L "$log_file" || -L "$backup_file" ]]; then
        echo "Refusing to rotate window-layout runtime log through symlink: $log_file" >&2
        return 1
    fi
    if [[ -e "$log_file" && ! -f "$log_file" ]]; then
        echo "Refusing to rotate non-regular window-layout runtime log: $log_file" >&2
        return 1
    fi
    if [[ -e "$backup_file" && ! -f "$backup_file" ]]; then
        echo "Refusing to replace non-regular window-layout runtime log backup: $backup_file" >&2
        return 1
    fi
    if [[ -f "$log_file" ]]; then
        if ! log_size=$(wc -c < "$log_file" | tr -d ' '); then
            echo "Unable to inspect window-layout runtime log size: $log_file" >&2
            return 1
        fi
        if [[ "$log_size" -ge "$LOG_MAX_BYTES" ]] &&
            ! mv -f "$log_file" "$backup_file"; then
            echo "Unable to rotate window-layout runtime log: $log_file" >&2
            return 1
        fi
    fi
}

rotate_runtime_logs() {
    rotate_runtime_log "$RUNTIME_DIR/yabai.out.log"
    rotate_runtime_log "$RUNTIME_DIR/yabai.err.log"
}

swift_eval() {
    local source="$1"
    WINDOW_LAYOUT_SWIFT_SOURCE="$source" WINDOW_LAYOUT_COMMAND_TIMEOUT="$COMMAND_TIMEOUT" python3 <<'PY'
import os
import math
import signal
import subprocess
import sys

source = os.environ["WINDOW_LAYOUT_SWIFT_SOURCE"]
try:
    timeout = float(os.environ["WINDOW_LAYOUT_COMMAND_TIMEOUT"])
except ValueError:
    print("WINDOW_LAYOUT_COMMAND_TIMEOUT must be a number", file=sys.stderr)
    raise SystemExit(2)
if not math.isfinite(timeout) or timeout <= 0:
    print("WINDOW_LAYOUT_COMMAND_TIMEOUT must be greater than zero", file=sys.stderr)
    raise SystemExit(2)

process = subprocess.Popen(
    ["swift", "-e", source],
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
    start_new_session=True,
)
try:
    stdout, stderr = process.communicate(timeout=timeout)
except subprocess.TimeoutExpired:
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    stdout, stderr = process.communicate()
    print(f"swift invocation timed out after {timeout:g} seconds", file=sys.stderr)
    raise SystemExit(124)

sys.stdout.write(stdout or "")
sys.stderr.write(stderr or "")
raise SystemExit(process.returncode)
PY
}

log_debug() {
    secure_layout_storage
    if [[ -L "$LOG_FILE" ]]; then
        echo "Refusing to write through symlinked window-layout log: $LOG_FILE" >&2
        return 1
    fi
    if [[ -e "$LOG_FILE" && ! -f "$LOG_FILE" ]]; then
        echo "Refusing to write to non-regular window-layout log: $LOG_FILE" >&2
        return 1
    fi
    if [[ -L "$LOG_BACKUP_FILE" ]]; then
        echo "Refusing to rotate window-layout log through symlinked backup: $LOG_BACKUP_FILE" >&2
        return 1
    fi
    if [[ -e "$LOG_BACKUP_FILE" && ! -f "$LOG_BACKUP_FILE" ]]; then
        echo "Refusing to replace non-regular window-layout log backup: $LOG_BACKUP_FILE" >&2
        return 1
    fi
    if [[ -f "$LOG_FILE" ]]; then
        local log_size
        log_size=$(wc -c < "$LOG_FILE" | tr -d ' ')
        if [[ "$log_size" -ge "$LOG_MAX_BYTES" ]]; then
            mv -f "$LOG_FILE" "$LOG_BACKUP_FILE"
        fi
    fi
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
    chmod 600 "$LOG_FILE"
}

yabai_query_json() {
    local domain="$1"
    WINDOW_LAYOUT_COMMAND_TIMEOUT="$COMMAND_TIMEOUT" python3 - "$domain" <<'PY'
import math
import os
import signal
import subprocess
import sys

domain = sys.argv[1]
try:
    timeout = float(os.environ["WINDOW_LAYOUT_COMMAND_TIMEOUT"])
except ValueError:
    print("WINDOW_LAYOUT_COMMAND_TIMEOUT must be a number", file=sys.stderr)
    sys.exit(2)
if not math.isfinite(timeout) or timeout <= 0:
    print("WINDOW_LAYOUT_COMMAND_TIMEOUT must be greater than zero", file=sys.stderr)
    sys.exit(2)

process = subprocess.Popen(
    ['yabai', '-m', 'query', '--' + domain],
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
    start_new_session=True,
)
try:
    stdout, stderr = process.communicate(timeout=timeout)
except subprocess.TimeoutExpired:
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    stdout, stderr = process.communicate()
    print(f"yabai query --{domain} timed out after {timeout:g} seconds", file=sys.stderr)
    sys.exit(124)

if process.returncode != 0:
    sys.stderr.write(stderr or "")
    sys.exit(process.returncode)

sys.stdout.write(stdout or "")
PY
}

json_array_count() {
    python3 -c '
import json
import sys

data = json.load(sys.stdin)
if not isinstance(data, list):
    raise SystemExit("expected JSON array")
print(len(data))
'
}

query_windows_nonempty() {
    local context="${1:-QUERY}"
    local attempts=5
    local delay=2
    local windows_json=""
    local count=""
    local rc=0
    local err_file
    mkdir -p "$LAYOUT_DIR"
    if ! err_file=$(mktemp "$LAYOUT_DIR/.yabai-windows-error.XXXXXX"); then
        echo "Unable to create a temporary yabai error file." >&2
        return 1
    fi

    for i in $(seq 1 "$attempts"); do
        if windows_json=$(yabai_query_json windows 2>"$err_file"); then
            if count=$(printf '%s' "$windows_json" | json_array_count 2>/dev/null); then
                if [[ "$count" -gt 0 ]]; then
                    rm -f "$err_file"
                    printf '%s' "$windows_json"
                    return 0
                fi
                log_debug "$context: yabai query --windows returned 0 window(s), retry $i/$attempts"
            else
                log_debug "$context: yabai query --windows returned invalid JSON, retry $i/$attempts"
            fi
        else
            rc=$?
            log_debug "$context: yabai query --windows failed rc=$rc, retry $i/$attempts: $(tr '\n' ' ' < "$err_file")"
        fi
        sleep "$delay"
    done

    echo "yabai query --windows did not return any windows after $attempts attempts. $(tr '\n' ' ' < "$err_file")" >&2
    rm -f "$err_file"
    return 1
}

layout_file_id() {
    local file="$1"
    local id
    id=$(basename "$file")
    [[ "$id" =~ ^[[:xdigit:]]{32}$ || "$id" =~ ^MD5[[:space:]]\(stdin\)[[:space:]]=[[:space:]][[:xdigit:]]{32}$ ]]
}

layout_file_is_regular() {
    local file="$1"
    [[ -f "$file" && ! -L "$file" ]]
}

layout_file_is_json() {
    local file="$1"
    layout_file_is_regular "$file" || return 1
    LAYOUT_FILE="$file" python3 - <<'PY'
import json
import os

with open(os.environ["LAYOUT_FILE"]) as stream:
    data = json.load(stream)
if not isinstance(data, list):
    raise SystemExit("layout must contain a JSON array")
PY
}

layout_uuid_compatibility() {
    local current_displays="$1"
    local layout_file="$2"
    CURRENT_DISPLAYS="$current_displays" LAYOUT_FILE="$layout_file" python3 <<'PY'
import json
import os

current_displays = json.loads(os.environ["CURRENT_DISPLAYS"])
with open(os.environ["LAYOUT_FILE"]) as stream:
    saved = json.load(stream)
if not isinstance(current_displays, list) or not current_displays:
    raise SystemExit("current display map is not a non-empty JSON array")
if not isinstance(saved, list) or not saved:
    raise SystemExit("layout root is not a non-empty JSON array")
if not all(isinstance(display, dict) for display in current_displays):
    raise SystemExit("current display map contains an invalid entry")
if not all(isinstance(entry, dict) for entry in saved):
    raise SystemExit("layout contains an invalid entry")

def normalized_uuid(value):
    return (value or "").strip().lower()

current_uuids = {
    normalized_uuid(display.get("uuid"))
    for display in current_displays
    if normalized_uuid(display.get("uuid"))
}
saved_uuids = set()
for entry in saved:
    saved_uuid = normalized_uuid(entry.get("display_uuid"))
    if not saved_uuid:
        display_key = str(entry.get("display_key", ""))
        if display_key.startswith("uuid:"):
            saved_uuid = normalized_uuid(display_key[5:])
    if saved_uuid:
        saved_uuids.add(saved_uuid)

if saved_uuids and not current_uuids:
    print("unavailable")
elif current_uuids and saved_uuids and current_uuids.isdisjoint(saved_uuids):
    print("conflict")
else:
    print("compatible")
PY
}

resolve_layout_id() {
    local prefix="${1:-}"
    local -a matches=()
    local file
    local id

    [[ -d "$LAYOUT_DIR" && ! -L "$LAYOUT_DIR" ]] || return 1
    for file in "$LAYOUT_DIR"/*; do
        layout_file_is_regular "$file" || continue
        layout_file_id "$file" || continue
        id=$(basename "$file")
        if [[ -z "$prefix" || "$id" == "$prefix" || "$id" == "$prefix"* ]]; then
            matches+=("$id")
        fi
    done

    if [[ "${#matches[@]}" -eq 1 ]]; then
        printf '%s\n' "${matches[0]}"
        return 0
    fi
    if [[ "${#matches[@]}" -eq 0 ]]; then
        return 1
    fi

    echo "Ambiguous layout prefix '$prefix'; matches:" >&2
    printf '  %s\n' "${matches[@]+"${matches[@]}"}" >&2
    return 2
}

write_restore_lock_owner() {
    local lock_dir="$1"
    local owner_start
    local owner_tmp

    owner_start=$(ps -p "$$" -o lstart= 2>/dev/null | tr -s ' ' '_' || true)
    if [[ -z "$owner_start" ]]; then
        return 1
    fi
    owner_tmp=$(mktemp "$lock_dir/.pid.XXXXXX") || return 1
    if ! printf '%s %s\n' "$$" "$owner_start" > "$owner_tmp" ||
        ! chmod 600 "$owner_tmp" ||
        [[ -e "$lock_dir/pid" || -L "$lock_dir/pid" ]] ||
        ! mv -f "$owner_tmp" "$lock_dir/pid"; then
        rm -f "$owner_tmp"
        return 1
    fi
}

prepare_restore_lock_candidate() {
    local candidate
    PREPARED_LOCK_CANDIDATE=""
    if ! candidate=$(mktemp -d "$LAYOUT_DIR/.restore-lock.XXXXXX"); then
        echo "Unable to prepare a window-layout restore lock." >&2
        return 1
    fi
    if ! track_lock_candidate "$candidate"; then
        rm -rf "$candidate"
        echo "Unable to track a window-layout restore lock candidate." >&2
        return 1
    fi
    if ! chmod 700 "$candidate" || ! write_restore_lock_owner "$candidate"; then
        rm -rf "$candidate"
        untrack_lock_candidate "$candidate"
        echo "Unable to initialize a window-layout restore lock." >&2
        return 1
    fi
    PREPARED_LOCK_CANDIDATE="$candidate"
}

install_restore_lock_candidate() {
    local candidate="$1"
    local owner_record="$2"
    local candidate_name
    local nested_candidate
    local installed_record=""

    candidate_name=$(basename "$candidate")
    if [[ -L "$LOCK_DIR" || ( -e "$LOCK_DIR" && ! -d "$LOCK_DIR" ) ]]; then
        return 1
    fi
    if [[ -d "$LOCK_DIR" ]]; then
        return 1
    fi
    if ! mv "$candidate" "$LOCK_DIR" 2>/dev/null; then
        return 1
    fi

    if [[ -f "$LOCK_DIR/pid" && ! -L "$LOCK_DIR/pid" ]]; then
        installed_record=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
    fi
    nested_candidate="$LOCK_DIR/$candidate_name"
    if [[ "$installed_record" == "$owner_record" &&
        ! -e "$nested_candidate" && ! -L "$nested_candidate" ]]; then
        return 0
    fi
    if [[ -e "$nested_candidate" || -L "$nested_candidate" ]]; then
        rm -rf "$nested_candidate"
    fi
    return 1
}

restore_lock_mtime() {
    local mtime
    mtime=$(stat -f %m "$1" 2>/dev/null || true)
    if [[ ! "$mtime" =~ ^[0-9]+$ ]]; then
        mtime=$(stat -c %Y "$1" 2>/dev/null || true)
    fi
    [[ "$mtime" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$mtime"
}

restore_lock_is_stale() {
    local mtime

    if ! mtime=$(restore_lock_mtime "$LOCK_DIR"); then
        echo "Unable to determine the age of the window-layout restore lock at $LOCK_DIR; refusing to reclaim it." >&2
        return 1
    fi
    timing_age_reached "$mtime" "$LOCK_INITIALIZATION_GRACE"
}

reclaim_restore_lock() {
    local candidate="$1"
    local owner_record="$2"
    local pid="$3"
    local started="$4"
    local claimed_pid=""
    local claimed_started=""
    local current_start=""

    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        current_start=$(ps -p "$pid" -o lstart= 2>/dev/null | tr -s ' ' '_' || true)
        if [[ ! "$current_start" =~ [[:alnum:]] || "$started" == "$current_start" ]]; then
            return 1
        fi
    fi
    if ! claim_reclaim_marker "$LOCK_DIR"; then
        return 1
    fi

    if [[ -f "$LOCK_DIR/pid" && ! -L "$LOCK_DIR/pid" ]]; then
        read -r claimed_pid claimed_started < "$LOCK_DIR/pid" || true
    fi
    if [[ "$claimed_pid" != "$pid" || "$claimed_started" != "$started" ]]; then
        cleanup_owned_reclaim_marker || true
        echo "The window-layout restore lock owner changed during stale-lock reclamation." >&2
        return 1
    fi

    if [[ "$claimed_pid" =~ ^[0-9]+$ ]] && kill -0 "$claimed_pid" 2>/dev/null; then
        current_start=$(ps -p "$claimed_pid" -o lstart= 2>/dev/null | tr -s ' ' '_' || true)
        if [[ ! "$current_start" =~ [[:alnum:]] || "$claimed_started" == "$current_start" ]]; then
            cleanup_owned_reclaim_marker || true
            return 1
        fi
    fi
    if ! rm -rf "$LOCK_DIR"; then
        cleanup_owned_reclaim_marker || true
        echo "Unable to remove stale window-layout restore lock at $LOCK_DIR." >&2
        return 1
    fi
    reset_reclaim_marker_state
    if ! install_restore_lock_candidate "$candidate" "$owner_record"; then
        echo "Unable to acquire window-layout restore lock at $LOCK_DIR." >&2
        return 1
    fi
    return 0
}

acquire_restore_lock() {
    mkdir -p "$LAYOUT_DIR"
    local candidate
    local owner_record
    if ! prepare_restore_lock_candidate; then
        return 1
    fi
    candidate="$PREPARED_LOCK_CANDIDATE"
    if ! owner_record=$(cat "$candidate/pid" 2>/dev/null); then
        rm -rf "$candidate"
        untrack_lock_candidate "$candidate"
        echo "Unable to read initialized window-layout restore lock metadata." >&2
        return 1
    fi
    if install_restore_lock_candidate "$candidate" "$owner_record"; then
        untrack_lock_candidate "$candidate"
        return 0
    fi
    if [[ ! -e "$candidate" && ! -L "$candidate" ]]; then
        untrack_lock_candidate "$candidate"
        candidate=""
        owner_record=""
        if ! prepare_restore_lock_candidate ||
            ! candidate="$PREPARED_LOCK_CANDIDATE" ||
            ! owner_record=$(cat "$candidate/pid" 2>/dev/null); then
            [[ -n "$candidate" ]] && rm -rf "$candidate"
            [[ -n "$candidate" ]] && untrack_lock_candidate "$candidate"
            echo "Unable to prepare a window-layout restore lock after a concurrent acquisition." >&2
            return 1
        fi
    fi

    if [[ -L "$LOCK_DIR" ]]; then
        rm -rf "$candidate"
        untrack_lock_candidate "$candidate"
        echo "The window-layout restore lock at $LOCK_DIR is a symlink; refusing to use it." >&2
        return 1
    fi
    if [[ -d "$LOCK_DIR" ]]; then
        chmod 700 "$LOCK_DIR"
    fi
    local metadata_state="incomplete"
    local pid=""
    local started=""
    local lock_is_stale=0
    if [[ -f "$LOCK_DIR/pid" && ! -L "$LOCK_DIR/pid" ]]; then
        read -r pid started < "$LOCK_DIR/pid" || true
        if [[ "$pid" =~ ^[0-9]+$ && -n "$started" ]]; then
            metadata_state="complete"
        fi
    fi
    if [[ "$metadata_state" != "complete" ]]; then
        if restore_lock_is_stale; then
            lock_is_stale=1
        fi
    fi
    if [[ -L "$LOCK_DIR/.reclaim" ]]; then
        rm -rf "$candidate"
        echo "The window-layout restore lock has an invalid reclamation marker; refusing to use it." >&2
        return 1
    fi
    if [[ -d "$LOCK_DIR/.reclaim" ]] &&
        ! recover_stale_reclaim_marker "$LOCK_DIR"; then
        rm -rf "$candidate"
        untrack_lock_candidate "$candidate"
        echo "The window-layout restore lock is already being reclaimed." >&2
        return 1
    fi
    if [[ "$metadata_state" != "complete" && "$lock_is_stale" -ne 1 ]]; then
        if [[ -f "$LOCK_DIR/pid" && ! -L "$LOCK_DIR/pid" ]]; then
            echo "The window-layout restore lock at $LOCK_DIR has incomplete owner metadata; another restore may be initializing." >&2
        else
            echo "The window-layout restore lock at $LOCK_DIR has no owner metadata; another restore may be initializing." >&2
        fi
        rm -rf "$candidate"
        untrack_lock_candidate "$candidate"
        return 1
    fi
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        local current_start
        if ! current_start=$(ps -p "$pid" -o lstart= 2>/dev/null | tr -s ' ' '_'); then
            current_start=""
        fi
        if [[ ! "$current_start" =~ [[:alnum:]] ]]; then
            rm -rf "$candidate"
            untrack_lock_candidate "$candidate"
            echo "Unable to inspect the live owner of the window-layout restore lock; refusing to reclaim it." >&2
            return 1
        fi
        if [[ "$started" == "$current_start" ]]; then
            local command_line
            if ! command_line=$(ps -p "$pid" -o command= 2>/dev/null); then
                command_line=""
            fi
            rm -rf "$candidate"
            untrack_lock_candidate "$candidate"
            if [[ -z "$command_line" ]]; then
                echo "Unable to inspect the live owner command of the window-layout restore lock; refusing to reclaim it." >&2
            elif [[ "$command_line" == *"window-layout"*"restore"* ]]; then
                echo "A window-layout restore is already running (pid $pid)." >&2
            else
                echo "A live process owns the window-layout restore lock (pid $pid); refusing to reclaim it." >&2
            fi
            return 1
        fi
    fi

    if ! reclaim_restore_lock "$candidate" "$owner_record" "$pid" "$started"; then
        if [[ -e "$candidate" || -L "$candidate" ]]; then
            rm -rf "$candidate"
        fi
        untrack_lock_candidate "$candidate"
        return 1
    fi
    untrack_lock_candidate "$candidate"
    return 0
}

release_restore_lock() {
    [[ -d "$LOCK_DIR" ]] || {
        return 0
    }
    [[ ! -L "$LOCK_DIR" ]] || {
        return 0
    }
    [[ -f "$LOCK_DIR/pid" && ! -L "$LOCK_DIR/pid" ]] || {
        return 0
    }
    local pid=""
    local started=""
    local current_start=""
    read -r pid started < "$LOCK_DIR/pid" 2>/dev/null || true
    current_start=$(ps -p "$$" -o lstart= 2>/dev/null | tr -s ' ' '_' || true)
    if [[ "$pid" == "$$" && "$started" == "$current_start" ]]; then
        if ! rm -rf "$LOCK_DIR"; then
            return 1
        fi
    fi
    return 0
}

handle_restore_signal() {
    local status="$1"
    trap - INT TERM EXIT
    cleanup_owned_reclaim_marker || true
    cleanup_owned_lock_candidates || true
    release_restore_lock || true
    exit "$status"
}

run_with_restore_lock() {
    acquire_restore_lock || return 1
    local rc=0
    trap 'handle_restore_signal 130' INT
    trap 'handle_restore_signal 143' TERM
    "$@" || rc=$?
    trap - INT TERM
    if ! release_restore_lock; then
        rc=1
    fi
    return "$rc"
}

preflight_dependencies() {
    local -a missing=()
    local command
    for command in yabai swift python3 osascript md5; do
        command -v "$command" >/dev/null 2>&1 || missing+=("$command")
    done
    if ! command -v xcode-select >/dev/null 2>&1 || ! xcode-select -p >/dev/null 2>&1; then
        missing+=("Xcode Command Line Tools")
    fi
    if [[ "${#missing[@]}" -gt 0 ]]; then
        printf 'window-layout dependencies missing: %s\n' "${missing[*]}" >&2
        printf 'Install/enable yabai and Xcode Command Line Tools, then retry.\n' >&2
        return 1
    fi
}

get_config_string() {
    swift_eval '
import Cocoa
import CoreGraphics
var parts: [String] = []
for screen in NSScreen.screens {
    let displayID = (screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? NSNumber)?.uint32Value ?? 0
    let bounds = CGDisplayBounds(CGDirectDisplayID(displayID))
    let name = screen.localizedName.isEmpty ? "display-\(Int(bounds.size.width))x\(Int(bounds.size.height))" : screen.localizedName
    parts.append("\(name):\(Int(bounds.size.width))x\(Int(bounds.size.height))")
}
parts.sort()
print(parts.joined(separator: "|"))
'
}

get_config_id() {
    local config_string
    if ! config_string=$(get_config_string); then
        return 1
    fi
    if ! log_debug "Config string: $config_string"; then
        return 1
    fi
    local config_id
    if ! config_id=$(printf '%s' "$config_string" | md5 -q); then
        return 1
    fi
    if [[ ! "$config_id" =~ ^[[:xdigit:]]{32}$ ]]; then
        echo "md5 returned an invalid window-layout config ID." >&2
        return 1
    fi
    printf '%s\n' "$config_id"
}

# Find the best matching saved config for the current displays.
# Stable UUIDs take precedence over names; display count only breaks ties for
# older layouts that lack UUID metadata and already share a display name.
find_best_config() {
    local current_names
    local current_displays
    if ! current_names=$(swift_eval '
import Cocoa
var names: [String] = []
for screen in NSScreen.screens {
    let n = screen.localizedName
    if !n.isEmpty { names.append(n) }
}
names.sort()
print(names.joined(separator: "|"))
'); then
        return 1
    fi
    if ! current_displays=$(get_display_map_json); then
        current_displays='[]'
    fi
    log_debug "MATCH: current display names: $current_names"

    local best_file=""
    local best_score=0

    for f in "$LAYOUT_DIR"/*; do
        layout_file_is_regular "$f" || continue
        layout_file_id "$f" || continue

        local score
        local score_diagnostics_file
        local score_diagnostics
        if ! score_diagnostics_file=$(mktemp "$LAYOUT_DIR/.find-best-config.XXXXXX"); then
            log_debug "MATCH: failed to create diagnostics file for $f"
            continue
        fi
        if ! score=$(CURRENT_NAMES="$current_names" CURRENT_DISPLAYS="$current_displays" LAYOUT_FILE="$f" python3 - <<'PY' 2>"$score_diagnostics_file"
import json
import os

current_names = set(os.environ["CURRENT_NAMES"].split("|")) - {""}
current_displays = json.loads(os.environ["CURRENT_DISPLAYS"])
with open(os.environ["LAYOUT_FILE"]) as stream:
    saved = json.load(stream)
if not isinstance(saved, list) or not saved:
    raise ValueError("layout root is not a JSON array")

def normalized_uuid(value):
    return (value or "").strip().lower()

current_uuids = {
    normalized_uuid(display.get("uuid"))
    for display in current_displays
    if normalized_uuid(display.get("uuid"))
}
saved_uuids = set()
for entry in saved:
    saved_uuid = normalized_uuid(entry.get("display_uuid"))
    display_key = str(entry.get("display_key", ""))
    if not saved_uuid and display_key.startswith("uuid:"):
        saved_uuid = normalized_uuid(display_key[5:])
    if saved_uuid:
        saved_uuids.add(saved_uuid)
saved_names = {entry.get("display", "") for entry in saved} - {"", "unknown"}
uuid_overlap = len(current_uuids & saved_uuids)
name_overlap = len(current_names & saved_names)

if saved_uuids and not current_uuids:
    score = 0
elif current_uuids and saved_uuids:
    score = uuid_overlap * 1000
    if uuid_overlap:
        score += name_overlap * 100
else:
    score = name_overlap * 100
    saved_display_count = len({
        entry.get("display_key")
        or entry.get("display_uuid")
        or entry.get("display")
        or f"slot:{entry.get('display_slot')}"
        for entry in saved
    })
    if name_overlap and saved_display_count == len(current_displays):
        score += 1
print(score)
PY
        ); then
            score_diagnostics=$(cat "$score_diagnostics_file" 2>/dev/null || true)
            rm -f "$score_diagnostics_file"
            log_debug "MATCH: failed to inspect $f: $(printf '%s' "$score_diagnostics" | tr '\n' ' ')"
            continue
        fi
        score_diagnostics=$(cat "$score_diagnostics_file" 2>/dev/null || true)
        rm -f "$score_diagnostics_file"
        if [[ -n "$score_diagnostics" ]]; then
            log_debug "MATCH: diagnostics for $f: $(printf '%s' "$score_diagnostics" | tr '\n' ' ')"
        fi
        if [[ ! "$score" =~ ^[0-9]+$ ]]; then
            log_debug "MATCH: failed to inspect $f: non-numeric score '$score'"
            continue
        fi

        log_debug "MATCH: $f score=$score"
        if [[ "$score" -gt "$best_score" ]]; then
            best_score="$score"
            best_file="$f"
        fi
    done

    if [[ -n "$best_file" && "$best_score" -gt 0 ]]; then
        log_debug "MATCH: best=$best_file score=$best_score"
        basename "$best_file"
    else
        log_debug "MATCH: no matching config found"
        echo ""
    fi
}

cleanup_stale() {
    [[ -d "$LAYOUT_DIR" && ! -L "$LAYOUT_DIR" ]] || return 0
    local cutoff
    cutoff=$(date -v-"${STALE_DAYS}"d +%s 2>/dev/null || date -d "$STALE_DAYS days ago" +%s)
    local count=0
    local file
    local mtime
    for file in "$LAYOUT_DIR"/*; do
        layout_file_is_regular "$file" || continue
        layout_file_id "$file" || continue
        layout_file_is_json "$file" >/dev/null 2>&1 || continue
        mtime=$(stat -f %m "$file" 2>/dev/null || true)
        if [[ ! "$mtime" =~ ^[0-9]+$ ]]; then
            mtime=$(stat -c %Y "$file" 2>/dev/null || true)
        fi
        [[ "$mtime" =~ ^[0-9]+$ ]] || continue
        if [[ "$mtime" -lt "$cutoff" ]]; then
            rm -f "$file"
            count=$((count + 1))
        fi
    done
    if [[ "$count" -gt 0 ]]; then
        echo "Cleaned up $count stale layout(s)"
    fi
}

# Get display metadata via Swift. UUID is preferred for identity; slot is a
# stable fallback for a single display arrangement when UUIDs are unavailable.
get_display_map_json() {
    swift_eval '
import Cocoa
import Foundation
import CoreGraphics

func displayUUID(_ screen: NSScreen) -> String {
    guard let number = screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? NSNumber else {
        return ""
    }
    let displayID = CGDirectDisplayID(number.uint32Value)
    guard let uuid = CGDisplayCreateUUIDFromDisplayID(displayID)?.takeRetainedValue(),
          let uuidString = CFUUIDCreateString(kCFAllocatorDefault, uuid) else {
        return ""
    }
    return uuidString as String
}

var result: [[String: Any]] = []
for screen in NSScreen.screens {
    let displayID = (screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? NSNumber)?.uint32Value ?? 0
    let bounds = CGDisplayBounds(CGDirectDisplayID(displayID))
    result.append([
        "name": screen.localizedName,
        "uuid": displayUUID(screen),
        "display_id": Int(displayID),
        "x": Int(bounds.origin.x),
        "y": Int(bounds.origin.y),
        "w": Int(bounds.size.width),
        "h": Int(bounds.size.height),
    ])
}
result.sort {
    let lx = $0["x"] as? Int ?? 0
    let rx = $1["x"] as? Int ?? 0
    if lx != rx { return lx < rx }
    let ly = $0["y"] as? Int ?? 0
    let ry = $1["y"] as? Int ?? 0
    if ly != ry { return ly < ry }
    return ($0["name"] as? String ?? "") < ($1["name"] as? String ?? "")
}
for i in result.indices {
    result[i]["slot"] = i
}
if let data = try? JSONSerialization.data(withJSONObject: result),
   let str = String(data: data, encoding: .utf8) {
    print(str)
}
'
}

save_layout() {
    local config_id
    config_id=$(get_config_id)
    mkdir -p "$LAYOUT_DIR"

    local layout_file="$LAYOUT_DIR/$config_id"
    local tmp_layout_file
    if ! tmp_layout_file=$(mktemp "$LAYOUT_DIR/.${config_id}.tmp.XXXXXX"); then
        echo "Unable to create a temporary layout file." >&2
        return 1
    fi

    local display_map
    if ! display_map=$(get_display_map_json); then
        rm -f "$tmp_layout_file"
        echo "Unable to resolve the current display map for saving." >&2
        return 1
    fi

    local windows_json
    local displays_json
    if ! windows_json=$(query_windows_nonempty "SAVE"); then
        rm -f "$tmp_layout_file"
        echo "Unable to query windows for saving; existing layout was left unchanged." >&2
        return 1
    fi
    if ! displays_json=$(yabai_query_json displays); then
        rm -f "$tmp_layout_file"
        echo "Unable to query displays for saving; existing layout was left unchanged." >&2
        return 1
    fi

    if ! DISPLAY_MAP="$display_map" WINDOWS_JSON="$windows_json" DISPLAYS_JSON="$displays_json" CHROME_TITLE_SUFFIXES="$CHROME_TITLE_SUFFIXES" COMMAND_TIMEOUT="$COMMAND_TIMEOUT" python3 <<'PY' > "$tmp_layout_file"; then
import json
import math
import os
import signal
import subprocess
import sys

display_map = json.loads(os.environ['DISPLAY_MAP'])
displays = json.loads(os.environ['DISPLAYS_JSON'])
windows = json.loads(os.environ['WINDOWS_JSON'])
command_timeout = float(os.environ['COMMAND_TIMEOUT'])
if not math.isfinite(command_timeout) or command_timeout <= 0:
    raise ValueError('COMMAND_TIMEOUT must be a finite positive number')

def run_timed(args, timeout, input_text=None):
    process = subprocess.Popen(
        args,
        stdin=subprocess.PIPE if input_text is not None else None,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    try:
        stdout, stderr = process.communicate(input=input_text, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        stdout, stderr = process.communicate()
        return subprocess.CompletedProcess(
            args,
            124,
            stdout=stdout or '',
            stderr=stderr or 'timed out',
        )
    return subprocess.CompletedProcess(
        args,
        process.returncode,
        stdout=stdout or '',
        stderr=stderr or '',
    )

def frame_value(frame, key):
    return int(round(float(frame.get(key, 0))))

def display_key(d):
    uuid = (d.get('uuid') or '').strip().lower()
    if uuid:
        return f"uuid:{uuid}"
    if d.get('slot') is not None:
        return f"slot:{d['slot']}"
    return f"name:{d.get('name', 'unknown')}"

def same_frame(screen, frame):
    return (
        int(screen.get('x', 0)) == frame_value(frame, 'x')
        and int(screen.get('y', 0)) == frame_value(frame, 'y')
        and int(screen.get('w', 0)) == frame_value(frame, 'w')
        and int(screen.get('h', 0)) == frame_value(frame, 'h')
    )

def match_display(yabai_display):
    if not yabai_display:
        return None
    yabai_uuid = (yabai_display.get('uuid') or '').strip().lower()
    if yabai_uuid:
        uuid_matches = [
            d for d in display_map
            if (d.get('uuid') or '').strip().lower() == yabai_uuid
        ]
        if len(uuid_matches) == 1:
            return uuid_matches[0]

    frame = yabai_display.get('frame', {})
    exact = [d for d in display_map if same_frame(d, frame)]
    if len(exact) == 1:
        return exact[0]

    sorted_yabai = sorted(
        displays,
        key=lambda yd: (
            frame_value(yd.get('frame', {}), 'x'),
            frame_value(yd.get('frame', {}), 'y'),
            frame_value(yd.get('frame', {}), 'w'),
            frame_value(yd.get('frame', {}), 'h'),
        ),
    )
    for slot, yd in enumerate(sorted_yabai):
        if yd.get('index') == yabai_display.get('index') and slot < len(display_map):
            return display_map[slot]
    return None

display_by_yabai_index = {d.get('index'): match_display(d) for d in displays}

def titles_match(left, right):
    if not left or not right:
        return False
    left_norm = normalize_title(left)
    right_norm = normalize_title(right)
    if not left_norm or not right_norm:
        return False
    if left_norm == right_norm or left_norm.startswith(right_norm) or right_norm.startswith(left_norm):
        return True
    left_tokens = set(left_norm.split())
    right_tokens = set(right_norm.split())
    if not left_tokens or not right_tokens:
        return False
    overlap = len(left_tokens & right_tokens) / max(len(left_tokens), len(right_tokens))
    return overlap >= 0.45

def normalize_title(title):
    value = (title or '').lower().replace('…', ' ')
    suffixes = [
        suffix.strip().lower()
        for suffix in os.environ.get('CHROME_TITLE_SUFFIXES', ' - google chrome').split('|')
        if suffix.strip()
    ]
    for suffix in suffixes:
        if value.endswith(suffix):
            value = value[:-len(suffix)]
    return ' '.join(value.replace('|', ' ').replace('·', ' ').replace('—', ' ').split())

def frame_from_bounds(bounds):
    try:
        left, top, right, bottom = [int(float(part)) for part in bounds.split(',')]
    except Exception:
        return {}
    return {'x': left, 'y': top, 'w': right - left, 'h': bottom - top}

def frames_match(left, right):
    if not left or not right:
        return False
    return all(abs(frame_value(left, key) - frame_value(right, key)) <= 3 for key in ('x', 'y', 'w', 'h'))

def chrome_window_metadata():
    script = r'''
set rowSep to ASCII character 30
set colSep to ASCII character 31
set rows to {}
tell application "Google Chrome"
  repeat with w in windows
    set wid to ""
    set t to ""
    set u to ""
    set b to ""
    try
      set wid to id of w as text
    end try
    try
      set t to title of w as text
    end try
    try
      set u to URL of active tab of w as text
    end try
    try
      set bb to bounds of w
      set b to (item 1 of bb as text) & "," & (item 2 of bb as text) & "," & (item 3 of bb as text) & "," & (item 4 of bb as text)
    end try
    set end of rows to wid & colSep & b & colSep & t & colSep & u
  end repeat
end tell
set AppleScript's text item delimiters to rowSep
return rows as text
'''
    process_identity = chrome_process_identity()
    result = run_timed(['osascript'], command_timeout, script)
    if result.returncode == 124:
        return []
    if result.returncode != 0:
        return []
    metadata = []
    for row in result.stdout.split(chr(30)):
        if not row:
            continue
        parts = row.split(chr(31), 3)
        metadata.append({
            'window_id': parts[0] if len(parts) > 0 else '',
            'bounds_frame': frame_from_bounds(parts[1]) if len(parts) > 1 else {},
            'title': parts[2] if len(parts) > 2 else '',
            'url': parts[3].strip() if len(parts) > 3 else '',
            'process_identity': process_identity,
        })
    return metadata

def chrome_process_identity():
    script = r'''
tell application "System Events"
    try
        return unix id of first process whose name is "Google Chrome"
    on error
        return ""
    end try
end tell
'''
    result = run_timed(['osascript'], command_timeout, script)
    if result.returncode == 124:
        return ''
    if result.returncode != 0:
        return ''
    pid = result.stdout.strip()
    if not pid.isdigit():
        return ''
    start = run_timed(
        ['ps', '-p', pid, '-o', 'lstart='],
        command_timeout,
    )
    if start.returncode == 124:
        return ''
    if start.returncode != 0:
        return ''
    start_value = ' '.join(start.stdout.split())
    return f'{pid}:{start_value}' if start_value else ''

def attach_chrome_urls(entries):
    metadata = chrome_window_metadata()
    used = set()
    chrome_entries = [entry for entry in entries if entry.get('app') == 'Google Chrome']

    def attach(entry, meta, idx):
        entry['chrome_window_id'] = meta.get('window_id', '')
        entry['chrome_url'] = meta.get('url', '')
        entry['chrome_process_identity'] = meta.get('process_identity', '')
        used.add(idx)

    for entry in chrome_entries:
        title = entry.get('title', '')
        for idx, meta in enumerate(metadata):
            if idx in used:
                continue
            if titles_match(title, meta.get('title', '')):
                matches = [
                    (candidate_idx, candidate)
                    for candidate_idx, candidate in enumerate(metadata)
                    if candidate_idx not in used and titles_match(title, candidate.get('title', ''))
                ]
                if len(matches) == 1:
                    attach(entry, meta, idx)
                break

    for entry in chrome_entries:
        if entry.get('chrome_window_id'):
            continue
        frame = entry.get('window_frame', {})
        matches = [
            (idx, meta) for idx, meta in enumerate(metadata)
            if idx not in used and frames_match(frame, meta.get('bounds_frame', {}))
        ]
        if len(matches) == 1:
            idx, meta = matches[0]
            attach(entry, meta, idx)

    for entry in chrome_entries:
        entry.setdefault('chrome_window_id', '')
        entry.setdefault('chrome_url', '')
        entry.setdefault('chrome_process_identity', '')

entries = []
for w in windows:
    app = w.get('app', '')
    if not app:
        continue
    title = w.get('title', '')
    fs = w.get('is-native-fullscreen', False)
    display = display_by_yabai_index.get(w.get('display'))
    display_name = display.get('name', 'unknown') if display else 'unknown'
    entries.append({
        'app': app,
        'title': title,
        'yabai_window_id': w.get('id'),
        'window_frame': w.get('frame', {}),
        'display': display_name,
        'display_uuid': display.get('uuid', '') if display else '',
        'display_slot': display.get('slot') if display else None,
        'display_key': display_key(display) if display else 'unknown',
        'fullscreen': fs,
    })

attach_chrome_urls(entries)
json.dump(entries, sys.stdout, ensure_ascii=False, indent=2)
PY
        rm -f "$tmp_layout_file"
        return 1
    fi

    local window_count
    if ! window_count=$(LAYOUT_FILE="$tmp_layout_file" python3 - <<'PY'
import json
import os

with open(os.environ["LAYOUT_FILE"]) as stream:
    data = json.load(stream)
if not isinstance(data, list):
    raise SystemExit("layout root is not a JSON array")
