#!/usr/bin/env bash
# window-layout - Save and restore window positions per display configuration
# Uses yabai (query only) + AppleScript to move fullscreen windows between displays.
# Requires: yabai running, Accessibility permissions for Terminal/shell

set -euo pipefail
umask 077

LAYOUT_DIR="$HOME/.window-layouts"
LOG_FILE="$HOME/.window-layouts/debug.log"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/window-layout"
SCHEDULE_PID_FILE="$RUNTIME_DIR/restore.pid"
RESTORE_DELAY="${WINDOW_LAYOUT_RESTORE_DELAY:-30}"
STALE_DAYS=30

secure_layout_storage() {
    mkdir -p "$LAYOUT_DIR"
    chmod 700 "$LAYOUT_DIR"
    while IFS= read -r -d '' layout_file; do
        chmod 600 "$layout_file"
    done < <(find -H "$LAYOUT_DIR" -maxdepth 1 -type f -print0)
}

secure_runtime_storage() {
    mkdir -p "$RUNTIME_DIR"
    chmod 700 "$RUNTIME_DIR"
}

log_debug() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
    chmod 600 "$LOG_FILE"
}

secure_layout_storage

yabai_query_json() {
    local domain="$1"
    python3 - "$domain" <<'PY'
import subprocess
import sys

domain = sys.argv[1]
try:
    result = subprocess.run(
        ['yabai', '-m', 'query', '--' + domain],
        capture_output=True,
        text=True,
        timeout=10,
    )
except subprocess.TimeoutExpired:
    print(f"yabai query --{domain} timed out", file=sys.stderr)
    sys.exit(124)

if result.returncode != 0:
    sys.stderr.write(result.stderr)
    sys.exit(result.returncode)

print(result.stdout, end='')
PY
}

json_array_count() {
    python3 -c '
import json
import sys

data = json.load(sys.stdin)
if not isinstance(data, list):
    raise SystemExit("expected JSON array")
print(len(data))
'
}

query_windows_for_save() {
    local attempts=5
    local delay=2
    local windows_json=""
    local count=""
    local rc=0
    local err_file
    err_file=$(mktemp "${TMPDIR:-/tmp}/window-layout-yabai-windows.XXXXXX")

    for i in $(seq 1 "$attempts"); do
        if windows_json=$(yabai_query_json windows 2>"$err_file"); then
            if count=$(printf '%s' "$windows_json" | json_array_count 2>/dev/null); then
                if [[ "$count" -gt 0 ]]; then
                    rm -f "$err_file"
                    printf '%s' "$windows_json"
                    return 0
                fi
                log_debug "SAVE: yabai query --windows returned 0 window(s), retry $i/$attempts"
            else
                log_debug "SAVE: yabai query --windows returned invalid JSON, retry $i/$attempts"
            fi
        else
            rc=$?
            log_debug "SAVE: yabai query --windows failed rc=$rc, retry $i/$attempts: $(tr '\n' ' ' < "$err_file")"
        fi
        sleep "$delay"
    done

    echo "yabai query --windows did not return any windows after $attempts attempts. $(tr '\n' ' ' < "$err_file")" >&2
    rm -f "$err_file"
    return 1
}

get_config_string() {
    swift -e '
import Cocoa
var parts: [String] = []
for screen in NSScreen.screens {
    let f = screen.frame
    let name = screen.localizedName.isEmpty ? "display-\(Int(f.size.width))x\(Int(f.size.height))" : screen.localizedName
    parts.append("\(name):\(Int(f.size.width))x\(Int(f.size.height))")
}
parts.sort()
print(parts.joined(separator: "|"))
'
}

get_config_id() {
    local config_string
    config_string=$(get_config_string)
    log_debug "Config string: $config_string"
    echo "$config_string" | md5
}

# Find the best matching saved config for the current displays.
# Matches by display names present in both, falling back to display count.
find_best_config() {
    local current_names
    current_names=$(swift -e '
import Cocoa
var names: [String] = []
for screen in NSScreen.screens {
    let n = screen.localizedName
    if !n.isEmpty { names.append(n) }
}
names.sort()
print(names.joined(separator: "|"))
')
    log_debug "MATCH: current display names: $current_names"

    local best_file=""
    local best_score=0

    for f in "$LAYOUT_DIR"/*; do
        [[ -f "$f" ]] || continue
        [[ "$f" == *.bak ]] && continue
        [[ "$f" == */debug.log ]] && continue

        local score
        score=$(CURRENT_NAMES="$current_names" LAYOUT_FILE="$f" python3 - <<'PY' 2>/dev/null
import json
import os

current_names = set(os.environ['CURRENT_NAMES'].split('|')) - {''}
with open(os.environ['LAYOUT_FILE'], encoding='utf-8') as layout:
    saved = json.load(layout)
saved_names = set(e['display'] for e in saved) - {'unknown'}
overlap = len(current_names & saved_names)
print(overlap)
PY
) || score=0

        log_debug "MATCH: $f score=$score"
        if [[ "$score" -gt "$best_score" ]]; then
            best_score="$score"
            best_file="$f"
        fi
    done

    if [[ -n "$best_file" && "$best_score" -gt 0 ]]; then
        log_debug "MATCH: best=$best_file score=$best_score"
        basename "$best_file"
    else
        log_debug "MATCH: no matching config found"
        echo ""
    fi
}

cleanup_stale() {
    [[ -d "$LAYOUT_DIR" ]] || return 0
    local count
    count=$(find "$LAYOUT_DIR" -type f -mtime +"$STALE_DAYS" | wc -l | tr -d ' ')
    if [[ "$count" -gt 0 ]]; then
        find "$LAYOUT_DIR" -type f -mtime +"$STALE_DAYS" -delete
        echo "Cleaned up $count stale layout(s)"
    fi
}

# Get display metadata via Swift. UUID is preferred for identity; slot is a
# stable fallback for a single display arrangement when UUIDs are unavailable.
get_display_map_json() {
    swift -e '
import Cocoa
import Foundation
import CoreGraphics

func displayUUID(_ screen: NSScreen) -> String {
    guard let number = screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? NSNumber else {
        return ""
    }
    let displayID = CGDirectDisplayID(number.uint32Value)
    guard let uuid = CGDisplayCreateUUIDFromDisplayID(displayID)?.takeRetainedValue(),
          let uuidString = CFUUIDCreateString(kCFAllocatorDefault, uuid) else {
        return ""
    }
    return uuidString as String
}

var result: [[String: Any]] = []
for screen in NSScreen.screens {
    let f = screen.frame
    let displayID = (screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? NSNumber)?.uint32Value ?? 0
    result.append([
        "name": screen.localizedName,
        "uuid": displayUUID(screen),
        "display_id": Int(displayID),
        "x": Int(f.origin.x),
        "y": Int(f.origin.y),
        "w": Int(f.size.width),
        "h": Int(f.size.height),
    ])
}
result.sort {
    let lx = $0["x"] as? Int ?? 0
    let rx = $1["x"] as? Int ?? 0
    if lx != rx { return lx < rx }
    let ly = $0["y"] as? Int ?? 0
    let ry = $1["y"] as? Int ?? 0
    if ly != ry { return ly < ry }
    return ($0["name"] as? String ?? "") < ($1["name"] as? String ?? "")
}
for i in result.indices {
    result[i]["slot"] = i
}
if let data = try? JSONSerialization.data(withJSONObject: result),
   let str = String(data: data, encoding: .utf8) {
    print(str)
}
'
}

save_layout() {
    local config_id
    config_id=$(get_config_id)
    local layout_file="$LAYOUT_DIR/$config_id"
    local tmp_layout_file="$LAYOUT_DIR/.${config_id}.tmp.$$"

    local display_map
    display_map=$(get_display_map_json)

    local windows_json
    local displays_json
    windows_json=$(query_windows_for_save)
    displays_json=$(yabai_query_json displays)

    if ! DISPLAY_MAP="$display_map" WINDOWS_JSON="$windows_json" DISPLAYS_JSON="$displays_json" python3 <<'PY' > "$tmp_layout_file"; then
import json
import os
import subprocess
import sys

display_map = json.loads(os.environ['DISPLAY_MAP'])
displays = json.loads(os.environ['DISPLAYS_JSON'])
windows = json.loads(os.environ['WINDOWS_JSON'])

def frame_value(frame, key):
    return int(round(float(frame.get(key, 0))))

def display_key(d):
    if d.get('uuid'):
        return f"uuid:{d['uuid']}"
    if d.get('slot') is not None:
        return f"slot:{d['slot']}"
    return f"name:{d.get('name', 'unknown')}"

def same_frame(screen, frame):
    return (
        int(screen.get('x', 0)) == frame_value(frame, 'x')
        and int(screen.get('y', 0)) == frame_value(frame, 'y')
        and int(screen.get('w', 0)) == frame_value(frame, 'w')
        and int(screen.get('h', 0)) == frame_value(frame, 'h')
    )

def match_display(yabai_display):
    if not yabai_display:
        return None
    frame = yabai_display.get('frame', {})
    exact = [d for d in display_map if same_frame(d, frame)]
    if len(exact) == 1:
        return exact[0]

    x = frame_value(frame, 'x')
    y = frame_value(frame, 'y')
    w = frame_value(frame, 'w')
    h = frame_value(frame, 'h')
    partial = [
        d for d in display_map
        if int(d.get('x', 0)) == x and int(d.get('y', 0)) == y
        and int(d.get('w', 0)) == w and int(d.get('h', 0)) == h
    ]
    if len(partial) == 1:
        return partial[0]

    by_x = [d for d in display_map if int(d.get('x', 0)) == x]
    if len(by_x) == 1:
        return by_x[0]

    sorted_yabai = sorted(
        displays,
        key=lambda yd: (
            frame_value(yd.get('frame', {}), 'x'),
            frame_value(yd.get('frame', {}), 'y'),
            frame_value(yd.get('frame', {}), 'w'),
            frame_value(yd.get('frame', {}), 'h'),
        ),
    )
    for slot, yd in enumerate(sorted_yabai):
        if yd.get('index') == yabai_display.get('index') and slot < len(display_map):
            return display_map[slot]
    return None

display_by_yabai_index = {d.get('index'): match_display(d) for d in displays}

def titles_match(left, right):
    if not left or not right:
        return False
    left_norm = normalize_title(left)
    right_norm = normalize_title(right)
    if not left_norm or not right_norm:
        return False
    if left_norm == right_norm or left_norm.startswith(right_norm) or right_norm.startswith(left_norm):
        return True
    left_tokens = set(left_norm.split())
    right_tokens = set(right_norm.split())
    if not left_tokens or not right_tokens:
        return False
    overlap = len(left_tokens & right_tokens) / max(len(left_tokens), len(right_tokens))
    return overlap >= 0.45

def normalize_title(title):
    value = (title or '').lower().replace('…', ' ')
    chrome_suffix = value.rfind(' - google chrome')
    if chrome_suffix != -1:
        value = value[:chrome_suffix]
    return ' '.join(value.replace('|', ' ').replace('·', ' ').replace('—', ' ').split())

def frame_from_bounds(bounds):
    try:
        left, top, right, bottom = [int(float(part)) for part in bounds.split(',')]
    except Exception:
        return {}
    return {'x': left, 'y': top, 'w': right - left, 'h': bottom - top}

def frames_match(left, right):
    if not left or not right:
        return False
    return all(abs(frame_value(left, key) - frame_value(right, key)) <= 3 for key in ('x', 'y', 'w', 'h'))

def chrome_window_metadata():
    script = r'''
set rowSep to ASCII character 30
set colSep to ASCII character 31
set rows to {}
tell application "Google Chrome"
  repeat with w in windows
    set wid to ""
    set t to ""
    set u to ""
    set b to ""
    try
      set wid to id of w as text
    end try
    try
      set t to title of w as text
    end try
    try
      set u to URL of active tab of w as text
    end try
    try
      set bb to bounds of w
      set b to (item 1 of bb as text) & "," & (item 2 of bb as text) & "," & (item 3 of bb as text) & "," & (item 4 of bb as text)
    end try
    set end of rows to wid & colSep & b & colSep & t & colSep & u
  end repeat
end tell
set AppleScript's text item delimiters to rowSep
return rows as text
'''
    try:
        result = subprocess.run(['osascript'], input=script, capture_output=True, text=True, timeout=10)
    except subprocess.TimeoutExpired:
        return []
    if result.returncode != 0:
        return []
    metadata = []
    for row in result.stdout.split(chr(30)):
        if not row:
            continue
        parts = row.split(chr(31), 3)
        metadata.append({
            'window_id': parts[0] if len(parts) > 0 else '',
            'bounds_frame': frame_from_bounds(parts[1]) if len(parts) > 1 else {},
            'title': parts[2] if len(parts) > 2 else '',
            'url': parts[3].strip() if len(parts) > 3 else '',
        })
    return metadata

def attach_chrome_urls(entries):
    metadata = chrome_window_metadata()
    used = set()
    chrome_entries = [entry for entry in entries if entry.get('app') == 'Google Chrome']

    def attach(entry, meta, idx):
        entry['chrome_window_id'] = meta.get('window_id', '')
        entry['chrome_url'] = meta.get('url', '')
        used.add(idx)

    for entry in chrome_entries:
        title = entry.get('title', '')
        matches = [
            (idx, meta) for idx, meta in enumerate(metadata)
            if idx not in used and titles_match(title, meta.get('title', ''))
        ]
        if len(matches) == 1:
            idx, meta = matches[0]
            attach(entry, meta, idx)

    for entry in chrome_entries:
        if entry.get('chrome_window_id'):
            continue
        frame = entry.get('window_frame', {})
        matches = [
            (idx, meta) for idx, meta in enumerate(metadata)
            if idx not in used and frames_match(frame, meta.get('bounds_frame', {}))
        ]
        if len(matches) == 1:
            idx, meta = matches[0]
            attach(entry, meta, idx)

    for entry in chrome_entries:
        entry.setdefault('chrome_window_id', '')
        entry.setdefault('chrome_url', '')

entries = []
for w in windows:
    app = w.get('app', '')
    if not app:
        continue
    title = w.get('title', '')
    fs = w.get('is-native-fullscreen', False)
    display = display_by_yabai_index.get(w.get('display'))
    display_name = display.get('name', 'unknown') if display else 'unknown'
    entries.append({
        'app': app,
        'title': title,
        'yabai_window_id': w.get('id'),
        'window_frame': w.get('frame', {}),
        'display': display_name,
        'display_uuid': display.get('uuid', '') if display else '',
        'display_slot': display.get('slot') if display else None,
        'display_key': display_key(display) if display else 'unknown',
        'fullscreen': fs,
    })

attach_chrome_urls(entries)
json.dump(entries, sys.stdout, ensure_ascii=False, indent=2)
PY
        rm -f "$tmp_layout_file"
        return 1
    fi

    local window_count
    if ! window_count=$(python3 -c "import json; print(len(json.load(open('$tmp_layout_file'))))"); then
        rm -f "$tmp_layout_file"
        return 1
    fi

    if [[ "$window_count" -eq 0 ]]; then
        rm -f "$tmp_layout_file"
        log_debug "SAVE: refusing to replace $layout_file with 0 captured windows"
        echo "Refusing to save 0 windows. Existing layout was left unchanged."
        return 1
    fi

    # Keep one backup of the previous good save, then atomically replace it.
    if [[ -f "$layout_file" ]]; then
        cp "$layout_file" "${layout_file}.bak"
        chmod 600 "${layout_file}.bak"
    fi
    mv "$tmp_layout_file" "$layout_file"
    chmod 600 "$layout_file"

    log_debug "SAVE: $window_count window(s) for config $config_id"
    echo "Saved $window_count window(s) for display config $config_id"

    cleanup_stale
}

wait_for_yabai() {
    local retries=10
    for i in $(seq 1 $retries); do
        if yabai_query_json displays &>/dev/null; then
            return 0
        fi
        log_debug "YABAI: not ready, retry $i/$retries"
        sleep 3
    done
    log_debug "YABAI: gave up after $retries retries"
    return 1
}

restore_layout() {
    log_debug "RESTORE: triggered"

    if ! wait_for_yabai; then
        log_debug "RESTORE: yabai not ready, aborting"
        echo "yabai not ready. Aborting restore."
        return 1
    fi

    local num_displays
    num_displays=$(swift -e 'import Cocoa; print(NSScreen.screens.count)')
    log_debug "RESTORE: detected $num_displays display(s)"
    if [[ "$num_displays" -ne 3 ]]; then
        log_debug "RESTORE: skipping — expected 3 displays, found $num_displays"
        echo "Expected 3 displays (laptop + 2 external), found $num_displays. Skipping restore."
        return 0
    fi

    local config_id
    if [[ -n "${1:-}" ]]; then
        # Use provided config ID (or prefix match)
        local match
        if [[ -f "$LAYOUT_DIR/$1" ]]; then
            match="$LAYOUT_DIR/$1"
        else
            match=$(find "$LAYOUT_DIR" -maxdepth 1 -type f -name "${1}*" \
                ! -name '*.bak' ! -name 'debug.log' -print 2>/dev/null | sort | head -1)
        fi
        if [[ -z "$match" ]]; then
            echo "No layout found matching '$1'"
            echo "Available configs:"
            list_layouts
            return 1
        fi
        config_id=$(basename "$match")
    else
        config_id=$(get_config_id)
        # If exact config not found, find best match by display names
        if [[ ! -f "$LAYOUT_DIR/$config_id" ]]; then
            log_debug "RESTORE: exact config $config_id not found, searching for best match"
            config_id=$(find_best_config)
        fi
    fi
    log_debug "RESTORE: config_id=$config_id"
    local layout_file="$LAYOUT_DIR/$config_id"

    if [[ -z "$config_id" || ! -f "$layout_file" ]]; then
        log_debug "RESTORE: no layout file found at $layout_file"
        echo "No saved layout for current display config ($config_id)"
        echo "Run 'window-layout save' first."
        return 1
    fi

    local display_map
    display_map=$(get_display_map_json)
    log_debug "RESTORE: display_map=$display_map"

    # Compute moves in Python, output as JSON array with source/target display metadata.
    local moves
    local moves_file="$LAYOUT_DIR/.moves.$$"
    local windows_json
    windows_json=$(yabai_query_json windows)
    if ! DISPLAY_MAP="$display_map" WINDOWS_JSON="$windows_json" LAYOUT_FILE="$layout_file" LOG_FILE="$LOG_FILE" python3 <<'PY' > "$moves_file"; then
import json
import os
import subprocess
import sys
import time
from collections import Counter
from datetime import datetime

def yabai_query(domain, retries=10):
    for _ in range(retries):
        try:
            result = subprocess.run(
                ['yabai', '-m', 'query', '--' + domain],
                capture_output=True,
                text=True,
                timeout=10,
            )
        except subprocess.TimeoutExpired:
            time.sleep(2)
            continue
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError:
            time.sleep(2)
    raise RuntimeError(f'yabai query --{domain} failed after {retries} retries')

log_file = os.environ['LOG_FILE']

def log(message):
    with open(log_file, 'a') as f:
        f.write(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {message}\n")

display_map = json.loads(os.environ['DISPLAY_MAP'])

displays = yabai_query('displays')
log(f"RESTORE: yabai_displays={json.dumps(displays, ensure_ascii=False)}")

def frame_value(frame, key):
    return int(round(float(frame.get(key, 0))))

def display_key(d):
    if d.get('uuid'):
        return f"uuid:{d['uuid']}"
    if d.get('slot') is not None:
        return f"slot:{d['slot']}"
    return f"name:{d.get('name', 'unknown')}"

def display_keys(d):
    keys = []
    if not d:
        return keys
    if d.get('uuid'):
        keys.append(f"uuid:{d['uuid']}")
    if d.get('display_key'):
        keys.append(d['display_key'])
    if d.get('slot') is not None:
        keys.append(f"slot:{d['slot']}")
    if d.get('name'):
        keys.append(f"name:{d['name']}")
    return list(dict.fromkeys(keys))

def saved_display_keys(entry):
    keys = []
    if entry.get('display_uuid'):
        keys.append(f"uuid:{entry['display_uuid']}")
    if entry.get('display_key'):
        keys.append(entry['display_key'])
    if entry.get('display_slot') is not None:
        keys.append(f"slot:{entry['display_slot']}")
    if entry.get('display'):
        keys.append(f"name:{entry['display']}")
    return list(dict.fromkeys(keys))

def titles_match(left, right):
    if not left or not right:
        return False
    left_norm = normalize_title(left)
    right_norm = normalize_title(right)
    if not left_norm or not right_norm:
        return False
    if left_norm == right_norm or left_norm.startswith(right_norm) or right_norm.startswith(left_norm):
        return True
    left_tokens = set(left_norm.split())
    right_tokens = set(right_norm.split())
    if not left_tokens or not right_tokens:
        return False
    overlap = len(left_tokens & right_tokens) / max(len(left_tokens), len(right_tokens))
    return overlap >= 0.45

def normalize_title(title):
    value = (title or '').lower().replace('…', ' ')
    chrome_suffix = value.rfind(' - google chrome')
    if chrome_suffix != -1:
        value = value[:chrome_suffix]
    return ' '.join(value.replace('|', ' ').replace('·', ' ').replace('—', ' ').split())

def is_unstable_title(app, title):
    value = (title or '').strip()
    if app == 'Google Chrome':
        return value in ('', '(untitled)', 'New Tab', 'New Tab - Google Chrome')
    return value == ''

def frame_from_bounds(bounds):
    try:
        left, top, right, bottom = [int(float(part)) for part in bounds.split(',')]
    except Exception:
        return {}
    return {'x': left, 'y': top, 'w': right - left, 'h': bottom - top}

def frames_match(left, right):
    if not left or not right:
        return False
    return all(abs(frame_value(left, key) - frame_value(right, key)) <= 3 for key in ('x', 'y', 'w', 'h'))

def chrome_window_metadata():
    script = r'''
set rowSep to ASCII character 30
set colSep to ASCII character 31
set rows to {}
tell application "Google Chrome"
  repeat with w in windows
    set wid to ""
    set t to ""
    set u to ""
    set b to ""
    try
      set wid to id of w as text
    end try
    try
      set t to title of w as text
    end try
    try
      set u to URL of active tab of w as text
    end try
    try
      set bb to bounds of w
      set b to (item 1 of bb as text) & "," & (item 2 of bb as text) & "," & (item 3 of bb as text) & "," & (item 4 of bb as text)
    end try
    set end of rows to wid & colSep & b & colSep & t & colSep & u
  end repeat
end tell
set AppleScript's text item delimiters to rowSep
return rows as text
'''
    try:
        result = subprocess.run(['osascript'], input=script, capture_output=True, text=True, timeout=10)
    except subprocess.TimeoutExpired:
        log("RESTORE: chrome_metadata_timeout")
        return []
    if result.returncode != 0:
        log(f"RESTORE: chrome_metadata_error rc={result.returncode} stderr={result.stderr.strip()}")
        return []
    metadata = []
    for row in result.stdout.split(chr(30)):
        if not row:
            continue
        parts = row.split(chr(31), 3)
        metadata.append({
            'window_id': parts[0] if len(parts) > 0 else '',
            'bounds_frame': frame_from_bounds(parts[1]) if len(parts) > 1 else {},
            'title': parts[2] if len(parts) > 2 else '',
            'url': parts[3].strip() if len(parts) > 3 else '',
        })
    return metadata

def attach_chrome_urls(entries):
    metadata = chrome_window_metadata()
    used = set()
    chrome_entries = [entry for entry in entries if entry.get('app') == 'Google Chrome']

    def attach(entry, meta, idx):
        entry['chrome_window_id'] = meta.get('window_id', '')
        entry['chrome_url'] = meta.get('url', '')
        used.add(idx)

    for entry in chrome_entries:
        title = entry.get('title', '')
        matches = [
            (idx, meta) for idx, meta in enumerate(metadata)
            if idx not in used and titles_match(title, meta.get('title', ''))
        ]
        if len(matches) == 1:
            idx, meta = matches[0]
            attach(entry, meta, idx)

    for entry in chrome_entries:
        if entry.get('chrome_window_id'):
            continue
        frame = entry.get('window_frame', {})
        matches = [
            (idx, meta) for idx, meta in enumerate(metadata)
            if idx not in used and frames_match(frame, meta.get('bounds_frame', {}))
        ]
        if len(matches) == 1:
            idx, meta = matches[0]
            attach(entry, meta, idx)

    for entry in chrome_entries:
        entry.setdefault('chrome_window_id', '')
        entry.setdefault('chrome_url', '')

def same_frame(screen, frame):
    return (
        int(screen.get('x', 0)) == frame_value(frame, 'x')
        and int(screen.get('y', 0)) == frame_value(frame, 'y')
        and int(screen.get('w', 0)) == frame_value(frame, 'w')
        and int(screen.get('h', 0)) == frame_value(frame, 'h')
    )

def match_display(yabai_display):
    if not yabai_display:
        return None
    frame = yabai_display.get('frame', {})
    exact = [d for d in display_map if same_frame(d, frame)]
    if len(exact) == 1:
        return exact[0]

    x = frame_value(frame, 'x')
    y = frame_value(frame, 'y')
    w = frame_value(frame, 'w')
    h = frame_value(frame, 'h')
    partial = [
        d for d in display_map
        if int(d.get('x', 0)) == x and int(d.get('y', 0)) == y
        and int(d.get('w', 0)) == w and int(d.get('h', 0)) == h
    ]
    if len(partial) == 1:
        return partial[0]

    by_x = [d for d in display_map if int(d.get('x', 0)) == x]
    if len(by_x) == 1:
        return by_x[0]

    sorted_yabai = sorted(
        displays,
        key=lambda yd: (
            frame_value(yd.get('frame', {}), 'x'),
            frame_value(yd.get('frame', {}), 'y'),
            frame_value(yd.get('frame', {}), 'w'),
            frame_value(yd.get('frame', {}), 'h'),
        ),
    )
    for slot, yd in enumerate(sorted_yabai):
        if yd.get('index') == yabai_display.get('index') and slot < len(display_map):
            return display_map[slot]
    return None

display_by_key = {}
display_by_yabai_index = {}
for yabai_display in displays:
    matched = match_display(yabai_display)
    if not matched:
        continue
    enriched = dict(matched)
    enriched['display_key'] = display_key(enriched)
    enriched['yabai_index'] = yabai_display.get('index')
    enriched['yabai_frame'] = yabai_display.get('frame', {})
    display_by_yabai_index[yabai_display.get('index')] = enriched
    for key in display_keys(enriched):
        display_by_key.setdefault(key, enriched)

# Current windows
current = []
for w in json.loads(os.environ['WINDOWS_JSON']):
    app = w.get('app', '')
    if not app:
        continue
    display = display_by_yabai_index.get(w.get('display'))
    current.append({
        'app': app,
        'title': w.get('title', ''),
        'yabai_window_id': w.get('id'),
        'window_frame': w.get('frame', {}),
        'display': display.get('name', 'unknown') if display else 'unknown',
        'display_key': display_key(display) if display else 'unknown',
        'display_keys': display_keys(display),
        'display_frame': display.get('yabai_frame', {}) if display else {},
        'yabai_display': display.get('yabai_index') if display else None,
        'fullscreen': w.get('is-native-fullscreen', False),
    })
attach_chrome_urls(current)

# Saved layout
saved = json.load(open(os.environ['LAYOUT_FILE']))

def resolve_target(saved_entry):
    for key in saved_display_keys(saved_entry):
        if key in display_by_key:
            return display_by_key[key], key
    return None, ''

def target_matches_current(target_key, current_entry):
    return target_key in current_entry.get('display_keys', [])

def move_record(phase, saved_entry, current_entry, target_display, target_key, matched_by):
    return {
        'phase': phase,
        'matched_by': matched_by,
        'app': current_entry['app'],
        'title': current_entry['title'],
        'source_display': current_entry['display'],
        'source_display_key': current_entry['display_key'],
        'source_yabai_display': current_entry.get('yabai_display'),
        'yabai_window_id': current_entry.get('yabai_window_id'),
        'chrome_window_id': current_entry.get('chrome_window_id', ''),
        'chrome_url': current_entry.get('chrome_url', ''),
        'target_display': target_display.get('name', saved_entry.get('display', 'unknown')),
        'target_display_key': target_key,
        'target_yabai_display': target_display.get('yabai_index'),
        'target_frame': target_display.get('yabai_frame') or {
            'x': target_display.get('x', 0),
            'y': target_display.get('y', 0),
            'w': target_display.get('w', 2560),
            'h': target_display.get('h', 1440),
        },
        'fullscreen': saved_entry.get('fullscreen', current_entry.get('fullscreen', False)),
    }

def windows_for_log(entries):
    redacted = []
    for entry in entries:
        safe_entry = dict(entry)
        if safe_entry.get('chrome_url'):
            safe_entry['chrome_url'] = '<redacted>'
        redacted.append(safe_entry)
    return redacted

log(f"RESTORE: current_windows={json.dumps(windows_for_log(current), ensure_ascii=False)}")
log(f"RESTORE: saved_windows={json.dumps(windows_for_log(saved), ensure_ascii=False)}")

# Phase 1: Match by exact app + title
used_saved = set()
used_current = set()
moves = []

# Phase 0: Match Chrome by same-session AppleScript window id when available.
# This is stable while the Chrome process keeps the same window objects, even if
# the active tab changes.
for si, s in enumerate(saved):
    if s.get('app') != 'Google Chrome' or not s.get('chrome_window_id'):
        continue
    target_display, target_key = resolve_target(s)
    if not target_display:
        log(f"RESTORE: phase0_id_unresolved_target saved_index={si} app={s.get('app')} display={s.get('display')}")
        continue
    candidates = [
        (ci, c) for ci, c in enumerate(current)
        if ci not in used_current
        and c.get('app') == 'Google Chrome'
        and c.get('chrome_window_id')
        and c.get('chrome_window_id') == s.get('chrome_window_id')
    ]
    if not candidates:
        log(f"RESTORE: phase0_id_no_match saved_index={si} chrome_window_id={s.get('chrome_window_id')}")
        continue
    candidates.sort(key=lambda item: 0 if target_matches_current(target_key, item[1]) else 1)
    ci, c = candidates[0]
    if not target_matches_current(target_key, c):
        moves.append(move_record('phase0_id', s, c, target_display, target_key, 'chrome_window_id'))
        log(f"RESTORE: move phase0_id app={c['app']} title={c['title']} chrome_window_id={c.get('chrome_window_id')} from={c['display']} to={target_display.get('name')} key={target_key}")
    else:
        log(f"RESTORE: keep phase0_id app={c['app']} title={c['title']} chrome_window_id={c.get('chrome_window_id')} display={c['display']} key={target_key}")
    used_saved.add(si)
    used_current.add(ci)

# Phase 0b: Match Chrome by active-tab URL when the layout has it. Chrome titles
# are often blank, truncated, or tab-dependent; URL is a cross-session fallback.
for si, s in enumerate(saved):
    if si in used_saved:
        continue
    if s.get('app') != 'Google Chrome' or not s.get('chrome_url'):
        continue
    target_display, target_key = resolve_target(s)
    if not target_display:
        log(f"RESTORE: phase0_url_unresolved_target saved_index={si} app={s.get('app')} display={s.get('display')}")
        continue
    candidates = [
        (ci, c) for ci, c in enumerate(current)
        if ci not in used_current
        and c.get('app') == 'Google Chrome'
        and c.get('chrome_url')
        and c.get('chrome_url') == s.get('chrome_url')
    ]
    if not candidates:
        continue
    candidates.sort(key=lambda item: 0 if target_matches_current(target_key, item[1]) else 1)
    ci, c = candidates[0]
    if not target_matches_current(target_key, c):
        moves.append(move_record('phase0_url', s, c, target_display, target_key, 'chrome_active_tab_url'))
        log(f"RESTORE: move phase0_url app={c['app']} title={c['title']} url=<redacted> from={c['display']} to={target_display.get('name')} key={target_key}")
    else:
        log(f"RESTORE: keep phase0_url app={c['app']} title={c['title']} url=<redacted> display={c['display']} key={target_key}")
    used_saved.add(si)
    used_current.add(ci)

for si, s in enumerate(saved):
    if si in used_saved:
        continue
    if is_unstable_title(s.get('app'), s.get('title')):
        log(f"RESTORE: skip phase1 unstable_title saved_index={si} app={s.get('app')} title={s.get('title')}")
        continue
    target_display, target_key = resolve_target(s)
    if not target_display:
        log(f"RESTORE: phase1_unresolved_target saved_index={si} app={s.get('app')} display={s.get('display')}")
        continue
    candidates = [
        (ci, c) for ci, c in enumerate(current)
        if ci not in used_current and c['app'] == s.get('app') and c['title'] == s.get('title')
    ]
    if not candidates:
        continue
    candidates.sort(key=lambda item: 0 if target_matches_current(target_key, item[1]) else 1)
    ci, c = candidates[0]
    if not target_matches_current(target_key, c):
        moves.append(move_record('phase1', s, c, target_display, target_key, 'exact_app_title'))
        log(f"RESTORE: move phase1 app={c['app']} title={c['title']} from={c['display']} to={target_display.get('name')} key={target_key}")
    else:
        log(f"RESTORE: keep phase1 app={c['app']} title={c['title']} display={c['display']} key={target_key}")
    used_saved.add(si)
    used_current.add(ci)

# Phase 2: For unmatched saved entries, compute how many windows per
# (app, fullscreen, display) we expect, then move unmatched current
# windows to fill the gaps.
# Count how many windows of each (app, fs) should be on each display
target_counts = Counter()
target_displays = {}
target_saved_entries = {}
for si, s in enumerate(saved):
    if si in used_saved:
        continue
    if s.get('app') == 'Google Chrome' and is_unstable_title(s.get('app'), s.get('title')) and not s.get('chrome_url'):
        log(f"RESTORE: skip phase2 ambiguous_chrome_saved saved_index={si} title={s.get('title')}")
        continue
    target_display, target_key = resolve_target(s)
    if not target_display:
        log(f"RESTORE: phase2_unresolved_target saved_index={si} app={s.get('app')} display={s.get('display')}")
        continue
    key = (s['app'], s['fullscreen'])
    target_counts[(key, target_key)] += 1
    target_displays[target_key] = target_display
    target_saved_entries.setdefault((key, target_key), s)

# Count how many unmatched current windows of each (app, fs) are on each display
unmatched_current = []
for ci, c in enumerate(current):
    if ci in used_current:
        continue
    key = (c['app'], c['fullscreen'])
    unmatched_current.append((ci, c, key))

# First let already-correct unmatched windows claim needed slots. Without this,
# title-changed Chrome windows that are already on the right display can leave a
# false deficit that causes another Chrome window to be moved there.
claimed_current = set()
for ci, c, key in unmatched_current:
    for target_key in c.get('display_keys', []):
        count_key = (key, target_key)
        if target_counts.get(count_key, 0) > 0:
            target_counts[count_key] -= 1
            claimed_current.add(ci)
            log(f"RESTORE: keep phase2 app={c['app']} title={c['title']} display={c['display']} key={target_key}")
            break

# Move only the still-unclaimed unmatched current windows to remaining deficits.
for (ci, c, key) in unmatched_current:
    if ci in claimed_current:
        continue
    if c.get('app') == 'Google Chrome' and is_unstable_title(c.get('app'), c.get('title')) and not c.get('chrome_url'):
        log(f"RESTORE: skip phase2 ambiguous_chrome_current app={c['app']} title={c['title']} display={c['display']}")
        continue
    for (tkey, target_key), needed in list(target_counts.items()):
        if tkey != key or needed <= 0:
            continue
        if target_key in c.get('display_keys', []):
            target_counts[(tkey, target_key)] -= 1
            claimed_current.add(ci)
            log(f"RESTORE: keep phase2_late app={c['app']} title={c['title']} display={c['display']} key={target_key}")
            break
        target_display = target_displays[target_key]
        saved_entry = target_saved_entries[(tkey, target_key)]
        moves.append(move_record('phase2', saved_entry, c, target_display, target_key, 'app_fullscreen_count'))
        log(f"RESTORE: move phase2 app={c['app']} title={c['title']} from={c['display']} to={target_display.get('name')} key={target_key}")
        target_counts[(tkey, target_key)] -= 1
        claimed_current.add(ci)
        break

json.dump(moves, sys.stdout, ensure_ascii=False, indent=2)
PY
        rm -f "$moves_file"
        return 1
    fi
    moves=$(cat "$moves_file")
    rm -f "$moves_file"

    local move_count
    move_count=$(echo "$moves" | python3 -c "import json,sys; print(len(json.load(sys.stdin)))")

