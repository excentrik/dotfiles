#!/usr/bin/env bash

set -e

CONFIG_SUFFIX=".yaml"

META_DIR="meta"
CONFIG_DIR="roles"

DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${BASE_DIR}"
source helpers/role_dependencies.sh

usage() {
  cat <<'USAGE'
Usage: ./install-role <roles...> [dotbot-options...]
       ./install-role [dotbot-options...] <roles...>

Examples:
  ./install-role bash
  ./install-role bash --dry-run
  ./install-role --dry-run bash
USAGE
}

parse_dotbot_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bootstrap)
        export DOTFILES_BOOTSTRAP=1
        shift
        ;;
      --only|--except)
        local option="$1"
        shift
        if [ "${option}" = "--only" ]; then
          DOTBOT_ARGS+=("${option}")
        fi
        while [ "$#" -gt 0 ] && [[ "$1" != -* ]]; do
          if [ "${option}" = "--except" ]; then
            DOTBOT_EXCEPT+=("$1")
          else
            DOTBOT_ARGS+=("$1")
          fi
          shift
        done
        ;;
      --plugin|-p)
        local option="$1"
        DOTBOT_ARGS+=("$option")
        shift
        if [ "$#" -eq 0 ]; then
          echo "Missing value for ${option}" >&2
          return 1
        fi
        DOTBOT_ARGS+=("$1")
        shift
        ;;
      --dry-run|-n|--verbose|-v|-vv|--quiet|-q|--force-color|--no-color|--version|--help|-h|--exit-on-failure|-x|--disable-built-in-plugins)
        DOTBOT_ARGS+=("$1")
        shift
        ;;
      -*)
        DOTBOT_ARGS+=("$1")
        shift
        ;;
      *)
        ROLES+=("$1")
        shift
        ;;
    esac
  done
}

detect_host() {
  case "$OSTYPE" in
    darwin*)
      echo "osx"
      ;;
    linux*)
      if grep docker /proc/1/cgroup -qa; then
        echo "docker"
      elif grep -qE "(Microsoft|WSL)" /proc/version &> /dev/null; then
        echo "wsl"
      else
        echo "unix"
      fi
      ;;
    *)
      echo "unknown"
      ;;
  esac
}

has_dry_run() {
  local arg
  for arg in "$@"; do
    case "${arg}" in
      --dry-run|-n)
        return 0
        ;;
    esac
  done
  return 1
}

add_unique_skip() {
  local directive="$1"
  local existing
  for existing in "${DOTBOT_EXCEPT[@]}"; do
    if [ "${existing}" = "${directive}" ]; then
      return 0
    fi
  done
  DOTBOT_EXCEPT+=("${directive}")
}

add_host_directive_exclusions() {
  case "${_ENV}" in
    osx)
      add_unique_skip apt
      ;;
    unix|wsl|docker)
      add_unique_skip tap
      add_unique_skip brew
      add_unique_skip cask
      add_unique_skip brewfile
      add_unique_skip services
      ;;
  esac
}

build_dotbot_args() {
  EFFECTIVE_DOTBOT_ARGS=("${DOTBOT_ARGS[@]}")
  if [ "${#DOTBOT_EXCEPT[@]}" -gt 0 ]; then
    EFFECTIVE_DOTBOT_ARGS+=(--except "${DOTBOT_EXCEPT[@]}")
  fi
}

# Refuse to run when both the `zsh` (plain) and `ohmyzsh` roles are scheduled:
# they both manage ~/.zshrc and combining them yields unpredictable ordering.
# AGENTS.md and STRUCTURE.md document the exclusion; this guard enforces it
# even for partial role-only invocations like `./install-role zsh ohmyzsh`.
validate_role_exclusion() {
  local zsh_present=0
  local ohmyzsh_present=0
  local role
  for role in "$@"; do
    case "${role}" in
      zsh) zsh_present=1 ;;
      ohmyzsh) ohmyzsh_present=1 ;;
    esac
  done
  if [ "${zsh_present}" -eq 1 ] && [ "${ohmyzsh_present}" -eq 1 ]; then
    echo "error: the 'zsh' and 'ohmyzsh' roles are mutually exclusive." >&2
    echo "       Both manage ~/.zshrc; pick one before re-running." >&2
    return 1
  fi
}

ROLES=()
EXPANDED_ROLES=()
ROLE_EXPANSION_STACK=()
DOTBOT_ARGS=()
DOTBOT_EXCEPT=()
EFFECTIVE_DOTBOT_ARGS=()
_ENV="$(detect_host)"

parse_dotbot_args "$@"
add_host_directive_exclusions
build_dotbot_args

if [ "${#ROLES[@]}" -eq 0 ]; then
  usage >&2
  exit 1
fi

if ! role_deps_expand_roles "${ROLES[@]}"; then
  echo "error: role dependency resolution failed." >&2
  exit 1
fi
validate_role_exclusion "${EXPANDED_ROLES[@]}"

_dotbot=("${BASE_DIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASE_DIR}" --plugin dotbot-brew --plugin dotbot-apt --plugin dotbot-role-deps)

for config in "${EXPANDED_ROLES[@]}"; do
  "${_dotbot[@]}" -c "${META_DIR}/${CONFIG_DIR}/${config}${CONFIG_SUFFIX}" --verbose "${EFFECTIVE_DOTBOT_ARGS[@]}"
done
