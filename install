#!/usr/bin/env bash
# Install dotfiles for current or given host. See STRUCTURE.md for layout and roles.

set -e

BASE_CONFIG="base"
CONFIG_SUFFIX=".yaml"

META_DIR="meta"
CONFIG_DIR="roles"
PROFILES_DIR="hosts"

DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${BASE_DIR}"
source helpers/role_dependencies.sh

detect_host() {
  case "$OSTYPE" in
    darwin*)
      echo "osx"
      ;;
    linux*)
      if grep docker /proc/1/cgroup -qa; then
        echo "docker"
      elif grep -qE "(Microsoft|WSL)" /proc/version &> /dev/null; then
        echo "wsl"
      else
        echo "unix"
      fi
      ;;
    *)
      echo "unknown platform: $OSTYPE. Aborting" >&2
      return 1
      ;;
  esac
}

parse_dotbot_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bootstrap)
        export DOTFILES_BOOTSTRAP=1
        shift
        ;;
      --only|--except)
        local option="$1"
        shift
        if [ "${option}" = "--only" ]; then
          DOTBOT_ARGS+=("${option}")
        fi
        while [ "$#" -gt 0 ] && [[ "$1" != -* ]]; do
          if [ "${option}" = "--except" ]; then
            DOTBOT_EXCEPT+=("$1")
          else
            DOTBOT_ARGS+=("$1")
          fi
          shift
        done
        ;;
      --plugin|-p)
        local option="$1"
        DOTBOT_ARGS+=("$option")
        shift
        if [ "$#" -eq 0 ]; then
          echo "Missing value for ${option}" >&2
          return 1
        fi
        DOTBOT_ARGS+=("$1")
        shift
        ;;
      --dry-run|-n|--verbose|-v|-vv|--quiet|-q|--force-color|--no-color|--version|--help|-h|--exit-on-failure|-x|--disable-built-in-plugins)
        DOTBOT_ARGS+=("$1")
        shift
        ;;
      -*)
        DOTBOT_ARGS+=("$1")
        shift
        ;;
      *)
        EXTRA_ROLES+=("$1")
        shift
        ;;
    esac
  done
}

has_dry_run() {
  local arg
  for arg in "$@"; do
    case "${arg}" in
      --dry-run|-n)
        return 0
        ;;
    esac
  done
  return 1
}

is_checked_out_submodule() {
  local path="$1"
  local superproject

  [ -d "${path}" ] || return 1

  superproject="$(git -C "${path}" rev-parse --show-superproject-working-tree 2> /dev/null || true)"
  [ -n "${superproject}" ] || return 1

  [ "$(cd "${superproject}" && pwd)" = "${BASE_DIR}" ]
}

build_submodule_backup_path() {
  local source_path="$1"
  local timestamp="$2"
  local candidate="${source_path}.pre-submodule-backup.${timestamp}"
  local counter=1

  while [ -e "${candidate}" ]; do
    candidate="${source_path}.pre-submodule-backup.${timestamp}.${counter}"
    counter=$((counter + 1))
  done

  printf '%s' "${candidate}"
}

prepare_submodule_paths() {
  local submodule_paths
  local timestamp
  local entry
  local path
  local backup_path

  if ! submodule_paths="$(git config --file .gitmodules --get-regexp '^submodule\..*\.path$' 2> /dev/null)"; then
    return 0
  fi

  timestamp="$(date +%Y%m%d%H%M%S)"
  while IFS= read -r entry; do
    path="${entry#* }"
    [ -n "${path}" ] || continue
    [ -e "${path}" ] || continue

    if is_checked_out_submodule "${path}"; then
      continue
    fi

    backup_path="$(build_submodule_backup_path "${path}" "${timestamp}")"
    echo "Found pre-existing content at ${path}; moving it to ${backup_path} (backup only)"
    echo "To restore it later: mv '${backup_path}' '${path}'"
    mv "${path}" "${backup_path}"
  done <<< "${submodule_paths}"
}

add_unique_skip() {
  local directive="$1"
  local existing
  for existing in "${DOTBOT_EXCEPT[@]}"; do
    if [ "${existing}" = "${directive}" ]; then
      return 0
    fi
  done
  DOTBOT_EXCEPT+=("${directive}")
}

add_host_directive_exclusions() {
  case "${_ENV}" in
    osx)
      add_unique_skip apt
      ;;
    unix|wsl|docker)
      add_unique_skip tap
      add_unique_skip brew
      add_unique_skip cask
      add_unique_skip brewfile
      add_unique_skip services
      ;;
  esac
}

build_dotbot_args() {
  EFFECTIVE_DOTBOT_ARGS=("${DOTBOT_ARGS[@]}")
  if [ "${#DOTBOT_EXCEPT[@]}" -gt 0 ]; then
    EFFECTIVE_DOTBOT_ARGS+=(--except "${DOTBOT_EXCEPT[@]}")
  fi
}

# Refuse to run when both the `zsh` (plain) and `ohmyzsh` roles are scheduled:
# they both manage ~/.zshrc (the `zsh` role forces it, the `ohmyzsh` role
# links ~/.ohmyzshrc and copies into ~/.oh-my-zsh) and combining them yields
# unpredictable ordering depending on which dotbot run wins. AGENTS.md and
# STRUCTURE.md document the exclusion; this guard enforces it.
validate_role_exclusion() {
  local zsh_present=0
  local ohmyzsh_present=0
  local role
  for role in "$@"; do
    case "${role}" in
      zsh) zsh_present=1 ;;
      ohmyzsh) ohmyzsh_present=1 ;;
    esac
  done
  if [ "${zsh_present}" -eq 1 ] && [ "${ohmyzsh_present}" -eq 1 ]; then
    echo "error: the 'zsh' and 'ohmyzsh' roles are mutually exclusive." >&2
    echo "       Both manage ~/.zshrc; pick one before re-running." >&2
    return 1
  fi
}
if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
  _ENV="$1"
  shift
else
  _ENV="$(detect_host)"
fi

if [ ! -f "${META_DIR}/${PROFILES_DIR}/${_ENV}${CONFIG_SUFFIX}" ]; then
  echo "Host type ${_ENV} is not supported."
  exit 1
fi

CONFIGS=()
EXPANDED_ROLES=()
ROLE_EXPANSION_STACK=()
EXTRA_ROLES=()
DOTBOT_ARGS=()
DOTBOT_EXCEPT=()
EFFECTIVE_DOTBOT_ARGS=()

parse_dotbot_args "$@"
add_host_directive_exclusions
build_dotbot_args

echo "Installing dotfiles for host type ${_ENV}"
if has_dry_run "${EFFECTIVE_DOTBOT_ARGS[@]}"; then
  echo "Dry-run requested; skipping submodule update"
else
  submodule_args=(--init --recursive --force)
  if [ "${DOTFILES_UPDATE_SUBMODULES:-}" = "1" ]; then
    submodule_args+=(--remote)
    echo "Updating submodules from upstream remotes"
  else
    echo "Updating submodules to recorded commits"
  fi

  prepare_submodule_paths
  if ! git submodule update "${submodule_args[@]}"; then
    exit 1
  fi
fi

while IFS= read -r config; do
  config=${config#- }
  config=${config%%:*}
  [ -n "${config}" ] && CONFIGS+=("${config}")
done < "${META_DIR}/${PROFILES_DIR}/${_ENV}${CONFIG_SUFFIX}"

if ! role_deps_expand_roles "${CONFIGS[@]}" "${EXTRA_ROLES[@]}"; then
  echo "error: role dependency resolution failed." >&2
  exit 1
fi
validate_role_exclusion "${EXPANDED_ROLES[@]}"

_dotbot=("${BASE_DIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASE_DIR}" --plugin dotbot-brew --plugin dotbot-apt --plugin dotbot-role-deps)

"${_dotbot[@]}" -c "${META_DIR}/${BASE_CONFIG}${CONFIG_SUFFIX}" "${EFFECTIVE_DOTBOT_ARGS[@]}"

for config in "${EXPANDED_ROLES[@]}"; do
  "${_dotbot[@]}" -c "${META_DIR}/${CONFIG_DIR}/${config}${CONFIG_SUFFIX}" "${EFFECTIVE_DOTBOT_ARGS[@]}"
  echo -e "Configured $config"
done
