#!/usr/bin/env bash
# Install dotfiles for current or given host. See STRUCTURE.md for layout and roles.

set -e

BASE_CONFIG="base"
CONFIG_SUFFIX=".yaml"

META_DIR="meta"
CONFIG_DIR="roles"
PROFILES_DIR="hosts"

DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${BASE_DIR}"
source "${BASE_DIR}/helpers/submodules.sh"

parse_dotbot_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bootstrap)
        export DOTFILES_BOOTSTRAP=1
        shift
        ;;
      --only|--except)
        local option="$1"
        shift
        if [ "${option}" = "--only" ]; then
          DOTBOT_ARGS+=("${option}")
        fi
        while [ "$#" -gt 0 ] && [[ "$1" != -* ]]; do
          if [ "${option}" = "--except" ]; then
            DOTBOT_EXCEPT+=("$1")
          else
            DOTBOT_ARGS+=("$1")
          fi
          shift
        done
        ;;
      --plugin|-p)
        local option="$1"
        DOTBOT_ARGS+=("$option")
        shift
        if [ "$#" -eq 0 ]; then
          echo "Missing value for ${option}" >&2
          return 1
        fi
        DOTBOT_ARGS+=("$1")
        shift
        ;;
      --dry-run|-n|--verbose|-v|-vv|--quiet|-q|--force-color|--no-color|--version|--help|-h|--exit-on-failure|-x|--disable-built-in-plugins)
        DOTBOT_ARGS+=("$1")
        shift
        ;;
      -*)
        DOTBOT_ARGS+=("$1")
        shift
        ;;
      *)
        EXTRA_ROLES+=("$1")
        shift
        ;;
    esac
  done
}

add_unique_skip() {
  local directive="$1"
  local existing
  for existing in "${DOTBOT_EXCEPT[@]+"${DOTBOT_EXCEPT[@]}"}"; do
    if [ "${existing}" = "${directive}" ]; then
      return 0
    fi
  done
  DOTBOT_EXCEPT+=("${directive}")
}

build_dotbot_args() {
  EFFECTIVE_DOTBOT_ARGS=("${DOTBOT_ARGS[@]+"${DOTBOT_ARGS[@]}"}")
  if [ "${#DOTBOT_EXCEPT[@]}" -gt 0 ]; then
    EFFECTIVE_DOTBOT_ARGS+=(--except "${DOTBOT_EXCEPT[@]+"${DOTBOT_EXCEPT[@]}"}")
  fi
}

# Refuse to run when both the `zsh` (plain) and `ohmyzsh` roles are scheduled:
# they both manage ~/.zshrc (the `zsh` role forces it, the `ohmyzsh` role
# links ~/.ohmyzshrc and copies into ~/.oh-my-zsh) and combining them yields
# unpredictable ordering depending on which dotbot run wins. AGENTS.md and
# STRUCTURE.md document the exclusion; this guard enforces it.
validate_role_exclusion() {
  local zsh_present=0
  local ohmyzsh_present=0
  local role
  for role in "$@"; do
    case "${role}" in
      zsh) zsh_present=1 ;;
      ohmyzsh) ohmyzsh_present=1 ;;
    esac
  done
  if [ "${zsh_present}" -eq 1 ] && [ "${ohmyzsh_present}" -eq 1 ]; then
    echo "error: the 'zsh' and 'ohmyzsh' roles are mutually exclusive." >&2
    echo "       Both manage ~/.zshrc; pick one before re-running." >&2
    return 1
  fi
}
EXPLICIT_HOST=0
if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
  _ENV="$1"
  EXPLICIT_HOST=1
  shift
fi

CONFIGS=()
EXPANDED_ROLES=()
ROLE_EXPANSION_STACK=()
EXTRA_ROLES=()
DOTBOT_ARGS=()
DOTBOT_EXCEPT=()
EFFECTIVE_DOTBOT_ARGS=()
HOST_ROLE_OUTPUT=""
ADDON_OUTPUT=""
DIRECTIVE_OUTPUT=""
ADDON_CONFIGS=()
RUN_CONFIGS=()
ROLE_CONFIGS=()
ROLE_CONFIG_ROOTS=()
ROLE_ADDON_OUTPUTS=()
ROLE_ADDON_ROOT_OUTPUTS=()

parse_dotbot_args "$@"
if ! dotfiles_initialize_submodules "${DOTBOT_ARGS[@]+"${DOTBOT_ARGS[@]}"}"; then
  exit 1
fi

# Load both co-required extension and host modules before initialization.
source "${BASE_DIR}/helpers/extensions.sh"
source "${BASE_DIR}/helpers/hosts.sh"
source "${BASE_DIR}/helpers/role_dependencies.sh"

if ! extensions_initialize; then
  exit 1
fi

if [ "${EXPLICIT_HOST}" -eq 1 ]; then
  extensions_resolve_host "${_ENV}" || exit 1
else
  if [ "${EXTENSIONS_ENABLED}" -eq 0 ]; then
    echo "error: extensions are disabled; zero-argument ./install requires an explicit core host." >&2
    exit 1
  fi
  if extensions_detect_host; then
    detector_status=0
  else
    detector_status=$?
  fi
  case "${detector_status}" in
    0)
      _ENV="${EXTENSION_DETECTED_HOST}"
      ;;
    1)
      _ENV="$(extensions_detect_core_host)"
      ;;
    *)
      exit 1
      ;;
  esac
  extensions_resolve_host "${_ENV}" || exit 1
fi
_HOST_FAMILY="${EXTENSION_SELECTED_FAMILY}"
extensions_apply_host_env "${_ENV}" || exit 1

if ! DIRECTIVE_OUTPUT="$(extensions_host_directive_exclusions "${_HOST_FAMILY}")"; then
  echo "error: host directive exclusion collection failed." >&2
  exit 1
fi
while IFS= read -r directive; do
  [ -n "${directive}" ] && add_unique_skip "${directive}"
done <<EOF
${DIRECTIVE_OUTPUT}
EOF
build_dotbot_args

extensions_configure_role_dependencies
if ! HOST_ROLE_OUTPUT="$(extensions_collect_host_roles "${_ENV}")"; then
  echo "error: host role collection failed." >&2
  exit 1
fi
if [ -n "${HOST_ROLE_OUTPUT}" ]; then
  while IFS= read -r config; do
    [ -n "${config}" ] && CONFIGS+=("${config}")
  done <<EOF
${HOST_ROLE_OUTPUT}
EOF
fi
if ! role_deps_expand_roles "${CONFIGS[@]+"${CONFIGS[@]}"}" "${EXTRA_ROLES[@]+"${EXTRA_ROLES[@]}"}"; then
  echo "error: role dependency resolution failed." >&2
  exit 1
fi
validate_role_exclusion "${EXPANDED_ROLES[@]+"${EXPANDED_ROLES[@]}"}"
extensions_run_copilot_prerequisite_hooks || exit 1

for config in "${EXPANDED_ROLES[@]+"${EXPANDED_ROLES[@]}"}"; do
  if [ "${config}" = "copilot" ] && [ "${EXTENSIONS_COPILOT_SKIP:-0}" -eq 1 ]; then
    echo "Skipping copilot role per extension prerequisite policy"
    continue
  fi
  if ! role_config="$(extensions_resolve_role_config "${config}")"; then
    echo "error: role config resolution failed for '${config}'." >&2
    exit 1
  fi
  if ! role_root="$(extensions_role_config_root "${role_config}")"; then
    echo "error: role config root resolution failed for '${config}'." >&2
    exit 1
  fi
  if ! ADDON_OUTPUT="$(extensions_resolve_role_addons "${config}")"; then
    echo "error: role addon resolution failed for '${config}'." >&2
    exit 1
  fi
  addon_root_output=""
  if [ -n "${ADDON_OUTPUT}" ]; then
    while IFS= read -r addon_config; do
      [ -n "${addon_config}" ] || continue
      if ! addon_root="$(extensions_role_addon_root "${addon_config}")"; then
        echo "error: role addon root resolution failed for '${config}'." >&2
        exit 1
      fi
      addon_root_output="${addon_root_output}${addon_root}"$'\n'
    done <<EOF
${ADDON_OUTPUT}
EOF
  fi
  RUN_CONFIGS+=("${config}")
  ROLE_CONFIGS+=("${role_config}")
  ROLE_CONFIG_ROOTS+=("${role_root}")
  ROLE_ADDON_OUTPUTS+=("${ADDON_OUTPUT}")
  ROLE_ADDON_ROOT_OUTPUTS+=("${addon_root_output}")
done

echo "Installing dotfiles for host type ${_ENV}"

_dotbot=("${BASE_DIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASE_DIR}" --plugin dotbot-brew --plugin dotbot-apt --plugin dotbot-role-deps)

"${_dotbot[@]+"${_dotbot[@]}"}" -c "${META_DIR}/${BASE_CONFIG}${CONFIG_SUFFIX}" "${EFFECTIVE_DOTBOT_ARGS[@]+"${EFFECTIVE_DOTBOT_ARGS[@]}"}"

config_index=0
for config in "${RUN_CONFIGS[@]+"${RUN_CONFIGS[@]}"}"; do
  role_config="${ROLE_CONFIGS[config_index]}"
  role_root="${ROLE_CONFIG_ROOTS[config_index]}"
  ADDON_CONFIGS=()
  ADDON_ROOTS=()
  ADDON_OUTPUT="${ROLE_ADDON_OUTPUTS[config_index]}"
  addon_root_output="${ROLE_ADDON_ROOT_OUTPUTS[config_index]}"
  if [ -n "${ADDON_OUTPUT}" ]; then
    while IFS= read -r addon_config; do
      [ -n "${addon_config}" ] && ADDON_CONFIGS+=("${addon_config}")
    done <<EOF
${ADDON_OUTPUT}
EOF
  fi
  if [ -n "${addon_root_output}" ]; then
    while IFS= read -r addon_root; do
      [ -n "${addon_root}" ] && ADDON_ROOTS+=("${addon_root}")
    done <<EOF
${addon_root_output}
EOF
  fi
  role_dotbot=("${BASE_DIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${role_root}" --plugin dotbot-brew --plugin dotbot-apt --plugin dotbot-role-deps)
  "${role_dotbot[@]+"${role_dotbot[@]}"}" -c "${role_config}" "${EFFECTIVE_DOTBOT_ARGS[@]+"${EFFECTIVE_DOTBOT_ARGS[@]}"}"
  addon_index=0
  for addon_config in "${ADDON_CONFIGS[@]+"${ADDON_CONFIGS[@]}"}"; do
    addon_root="${ADDON_ROOTS[addon_index]}"
    addon_dotbot=("${BASE_DIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${addon_root}" --plugin dotbot-brew --plugin dotbot-apt --plugin dotbot-role-deps)
    "${addon_dotbot[@]+"${addon_dotbot[@]}"}" -c "${addon_config}" "${EFFECTIVE_DOTBOT_ARGS[@]+"${EFFECTIVE_DOTBOT_ARGS[@]}"}"
    addon_index=$((addon_index + 1))
  done
  echo -e "Configured $config"
  config_index=$((config_index + 1))
done
